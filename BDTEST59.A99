;
;-----------------------------------------------------------------------
; BDTEST59 - BDOS 5.9 sequential and random file integrity tester
;
; Written for Alexander Cameron's TMS9900/TMS99000 CP/M-style system.
; Calling conventions and low-memory pointers follow XMODEM57.A99.
;
; DESTRUCTIVE ONLY TO THE FILE:  BDTEST.DAT
;
; Menu tests:
;   S = 5 records       - basic allocation-chain extension
;   B = 505 records     - crosses physical block 127 -> 128
;   P = 1017 records    - crosses BAT page 0 -> 1 (block 256)
;   2 = 2041 records    - crosses BAT page 1 -> 2 (block 512)
;   F = fill remaining free space, verify it, and check clean disk full
;   R = random read/write, cursor, size, EOF and allocation-boundary tests
;   X = PSEL disk-I/O stress: randomized reads/writes with PSEL enabled,
;       DMA-buffer guards, mapper preservation, periodic close/reopen, and
;       a PSEL-off control reread when corruption is detected.
;   A = S, B, P, 2 and R in sequence; each file is deleted before next test
;   Q = quit
;
; Every 512-byte record contains:
;   word 0: >B059
;   word 1: zero-based logical record number
;   word 2: one's complement of the record number
;   words 3..255: record number + word index
;
; The tester checks WRSEQ/FSZ/CRN, closes and reopens the file, verifies
; every word through RDSEQ, verifies EOF, then erases the file.  The F test
; also verifies that the first rejected append does not change FSZ or CRN.
;
; Sequential scope: allocation, BAT page changes, close/open, EOF, deletion
; and block reclamation.  Random scope: functions 33-36 using RELB=0 and
; RELR as the 16-bit absolute record number.  Sparse random writes are
; expected to fail; overwrite and append exactly at EOF are expected to work.
;-----------------------------------------------------------------------
;
; Monitor XOPs used by existing applications.
;
        DXOP    PSEL_DIS,0
        DXOP    PSEL_EN,1
        DXOP    CALL,6
        DXOP    RET,7
        DXOP    PUSH,8
        DXOP    POP,9
        DXOP    WHEX,10
;
; Register equates.
;
R0      EQU     0
R1      EQU     1
R2      EQU     2
R3      EQU     3
R4      EQU     4
R5      EQU     5
R6      EQU     6
R7      EQU     7
R8      EQU     8
R9      EQU     9
SP      EQU     10
R11     EQU     11
R12     EQU     12
;
; Operating-system pointers and entry values, matching XMODEM57.A99.
;
TPA     EQU     00500H
SHELL   EQU     080H            ; low-memory pointer to shell entry
BDOS    EQU     084H            ; low-memory pointer to BDOS entry
;
; BDOS functions.
;
CIN     EQU     1
COUT    EQU     2
OPEN    EQU     15
FCLOSE  EQU     16
ERAFIL  EQU     19
RDSEQ   EQU     20
WRSEQ   EQU     21
MAKFIL  EQU     22
SETDMA  EQU     26
RDRND   EQU     33
WRRND   EQU     34
GETSIZ  EQU     35
SETREL  EQU     36
;
; FCB offsets used by BDOS59.
;
NAM     EQU     0
FTY     EQU     11
FSB     EQU     12
FSZ     EQU     14
FLA     EQU     16
LRBL    EQU     20
CBN     EQU     24
CRN     EQU     26
RELB    EQU     28
RELR    EQU     30
FCBSIZ  EQU     36
;
; Test constants.
;
BYTSEC  EQU     512
NWORDS  EQU     BYTSEC/2
PATWORDS EQU    NWORDS-3
MAGIC   EQU     0B059H
FIRSTBLK EQU    2
MAXBLK  EQU     719
FULLRECS EQU     2872
RANDRECS EQU     12              ; three complete allocation blocks
RANDCUR  EQU     6               ; sequential cursor sentinel
ALTPAT   EQU     0A504H          ; replacement pattern for logical record 4
;
; PSEL disk stress constants.  Symbols are <=15 chars for the legacy assembler.
; The stress file is preallocated to 64 records
; and then subjected to 1024 pseudo-random operations.  Every random write is
; immediately checked for DMA-buffer mutation and read back.  Every 32
; iterations the file is closed and reopened while PSEL remains enabled.
;
MAP_BASE_PORT EQU 080C0H
MAPWIDTH EQU     2
STRESS_RECS EQU  64
STRESS_ITERS EQU 1024
; X-mode DMA lives in otherwise-unused SEG11.  Only this segment is mapped
; away from PAGE0, so BDTEST code/data remain in the flat bank while disk I/O
; is forced to use a genuinely paged DMA address.
ST_DMA_SEG EQU   11
ST_DMA_PAGE EQU  2
ST_DMA_CRU EQU   MAP_BASE_PORT+(ST_DMA_SEG*2)
ST_DMA EQU       0B100H
ST_GLO EQU       0B0E0H
ST_GHI EQU       0B300H
ST_REOPEN_MSK EQU 001FH
STRESS_MAGIC EQU  0D15CH
STRESS_RNG_INIT EQU 0ACE1H
STRESS_SEED_XOR EQU 05A5AH
; PSEL-only RAM copy diagnostic.  MC_SRC is the common 512-byte area
; immediately below the TPA; SEG11/PAGE2 is the mapped destination.
MC_SRC  EQU       00300H
MC_ITERS EQU      1024
GUARD_WORDS EQU  8
GUARD_LO_PAT EQU  01357H
GUARD_HI_PAT EQU  0ECA8H
;
; Failure identifiers printed in hexadecimal.
;
E_MAKE  EQU     1
E_FSB   EQU     2
E_WRITE EQU     3
E_WFCB  EQU     4
E_CLOSE EQU     5
E_OPEN  EQU     6
E_SIZE  EQU     7
E_READ  EQU     8
E_DATA  EQU     9
E_EOF   EQU     10
E_ERASE EQU     11
E_FULL  EQU     12
E_FSTATE EQU    13
E_RSETREL EQU   14
E_RGETSIZ EQU   15
E_RREAD  EQU     16
E_RDATA  EQU     17
E_RCURSOR EQU    18
E_RSIZE  EQU     19
E_RWRITE EQU     20
E_REOF   EQU     21
E_RRELB  EQU     22
E_RSPARSE EQU    23
; PSEL stress failure identifiers.
E_PCREATE EQU     24
E_PSEED EQU       25
E_PWRITE EQU      26
E_PREAD EQU       27
E_PDATA EQU       28
E_PSTATE EQU      29
E_PGUARD EQU      30
E_PMAP EQU        31
E_PCLOSE EQU      32
E_POPEN EQU       33
E_PSIZE EQU       34
E_PDELETE EQU     35
E_PSHADOW EQU     36
E_PWBUF EQU       37
;
        AORG    TPA
        JMP     START
;
;-----------------------------------------------------------------------
; Main menu.
;-----------------------------------------------------------------------
START:
        PSEL_DIS                 ; normal tests start from a known safe state
        LI      R0,BANNER
        CALL    @PRINTMSG

MENU:
        LI      R0,MENU_MSG
        CALL    @PRINTMSG
        LI      R2,CIN
        CLR     R3
        CALL    @BDOS            ; character returned in low byte of R1
        MOV     R1,R8             ; preserve choice outside shared R0-R7
        ANDI    R8,00FFH           ; retain only the console character

        LI      R3,00DH
        CALL    @PUTC
        LI      R3,00AH
        CALL    @PUTC

; Test the numeric option before clearing ASCII lower-case bit 5.
; Applying 00DFH to '2' (0032H) would incorrectly turn it into 0012H.
        CI      R8,'2'
        JEQ     MENU_2

        ANDI    R8,00DFH           ; force alphabetic choices to uppercase
        CI      R8,'Q'
        JNE     MENU_NOT_Q
        B       @EXIT
MENU_NOT_Q:
        CI      R8,'S'
        JEQ     MENU_S
        CI      R8,'B'
        JEQ     MENU_B
        CI      R8,'P'
        JEQ     MENU_P
        CI      R8,'F'
        JEQ     MENU_F
        CI      R8,'R'
        JEQ     MENU_R
        CI      R8,'M'
        JEQ     MENU_M
        CI      R8,'X'
        JEQ     MENU_X
        CI      R8,'A'
        JEQ     MENU_A

        LI      R0,BAD_KEY
        CALL    @PRINTMSG
        B       @MENU

MENU_S:
        LI      R0,5
        CLR     R1
        CALL    @RUNTEST
        MOV     R1,R1
        JLT     FAIL_EXIT
        B       @MENU

MENU_B:
        LI      R0,505
        CLR     R1
        CALL    @RUNTEST
        MOV     R1,R1
        JLT     FAIL_EXIT
        B       @MENU

MENU_P:
        LI      R0,1017
        CLR     R1
        CALL    @RUNTEST
        MOV     R1,R1
        JLT     FAIL_EXIT
        B       @MENU

MENU_2:
        LI      R0,2041
        CLR     R1
        CALL    @RUNTEST
        MOV     R1,R1
        JLT     FAIL_EXIT
        B       @MENU

MENU_F:
        LI      R0,FULLRECS
        LI      R1,1              ; request the expected disk-full check
        CALL    @RUNTEST
        MOV     R1,R1
        JLT     FAIL_EXIT
        B       @MENU

MENU_R:
        CALL    @RUN_RANDOM
        MOV     R1,R1
        JLT     FAIL_EXIT
        B       @MENU

MENU_M:
        CALL    @RUN_PSEL_MEM
        MOV     R1,R1
        JLT     FAIL_EXIT
        B       @MENU

MENU_X:
        CALL    @RUN_PSEL_STRESS
        MOV     R1,R1
        JLT     FAIL_EXIT
        B       @MENU

MENU_A:
        LI      R0,ALL_MSG
        CALL    @PRINTMSG
        LI      R0,5
        CLR     R1
        CALL    @RUNTEST
        MOV     R1,R1
        JLT     FAIL_EXIT
        LI      R0,505
        CLR     R1
        CALL    @RUNTEST
        MOV     R1,R1
        JLT     FAIL_EXIT
        LI      R0,1017
        CLR     R1
        CALL    @RUNTEST
        MOV     R1,R1
        JLT     FAIL_EXIT
        LI      R0,2041
        CLR     R1
        CALL    @RUNTEST
        MOV     R1,R1
        JLT     FAIL_EXIT
        CALL    @RUN_RANDOM
        MOV     R1,R1
        JLT     FAIL_EXIT
        B       @MENU

FAIL_EXIT:
        LI      R0,STOP_MSG
        CALL    @PRINTMSG
        SETO    R1               ; shell return code indicates failure
        B       @SHELL

EXIT:
        PSEL_DIS
        LI      R0,BYE_MSG
        CALL    @PRINTMSG
        CLR     R1               ; shell return code
        B       @SHELL
;
;-----------------------------------------------------------------------
; RUNTEST
;   R0 = number of 512-byte records
;   R1 = nonzero to test one additional write as expected disk-full
; Returns R1 = 0 pass, -1 fail.
;-----------------------------------------------------------------------
RUNTEST:
        MOV     R0,@TARGET_RECS
        MOV     R1,@FULFLG
        CLR     @FAIL_ID
        CLR     @LAST_STATUS
        CLR     @BAD_OFFSET
        CLR     @EXPECTED
        CLR     @ACTUAL

        LI      R0,BEGIN_MSG
        CALL    @PRINTMSG
        WHEX    @TARGET_RECS
        LI      R0,RECORDS_MSG
        CALL    @PRINTMSG

        CALL    @CREATE_FILE
        MOV     R1,R1
        JLT     RT_FAIL

        CALL    @WRITE_FILE
        MOV     R1,R1
        JLT     RT_FAIL

        CALL    @CLOSE_FILE
        MOV     R1,R1
        JLT     RT_FAIL

        CALL    @OPEN_FILE
        MOV     R1,R1
        JLT     RT_FAIL

        CALL    @READ_FILE
        MOV     R1,R1
        JLT     RT_FAIL

        CALL    @CLOSE_FILE
        MOV     R1,R1
        JLT     RT_FAIL

        CALL    @DELETE_FILE
        MOV     R1,R1
        JLT     RT_FAIL

        LI      R0,PASS_MSG
        CALL    @PRINTMSG
        CLR     R1
        RET

RT_FAIL:
        CALL    @PRINT_FAILURE
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; RUN_RANDOM - focused random-access regression test.
;
; Creates 12 sequential records, then verifies:
;   - SETREL and GETSIZ use RELB=0 / RELR=absolute record
;   - random reads at records 0,3,4,7,8,11
;   - random EOF and nonzero-RELB rejection
;   - overwrite of record 4 without growing FSZ
;   - append record 12 at EOF, crossing into a new allocation block
;   - sparse write to record 14 is rejected without changing FSZ/CRN
;   - close/reopen preserves the overwrite and append
;-----------------------------------------------------------------------
RUN_RANDOM:
        LI      R0,RANDRECS
        MOV     R0,@TARGET_RECS
        CLR     @FULFLG
        CLR     @FAIL_ID
        CLR     @LAST_STATUS
        CLR     @BAD_OFFSET
        CLR     @EXPECTED
        CLR     @ACTUAL

        LI      R0,RND_BEGIN_MSG
        CALL    @PRINTMSG

        CALL    @CREATE_FILE
        MOV     R1,R1
        JEQ     RR_CONT1
        B       @RR_FAIL
RR_CONT1:
        CALL    @WRITE_FILE
        MOV     R1,R1
        JEQ     RR_CONT2
        B       @RR_FAIL
RR_CONT2:
        CALL    @CLOSE_FILE
        MOV     R1,R1
        JEQ     RR_CONT3
        B       @RR_FAIL
RR_CONT3:
        CALL    @OPEN_FILE
        MOV     R1,R1
        JEQ     RR_CONT4
        B       @RR_FAIL
RR_CONT4:

        LI      R0,RANDRECS
        MOV     R0,@RAND_SIZE
        LI      R0,RANDCUR
        MOV     R0,@RAND_CURSOR
        MOV     R0,@TESTFCB+CRN
        CLR     @TESTFCB+CBN

        CALL    @RND_ACT_TEST
        MOV     R1,R1
        JEQ     RR_CONT5
        B       @RR_FAIL
RR_CONT5:

        CALL    @CLOSE_FILE
        MOV     R1,R1
        JEQ     RR_CONT6
        B       @RR_FAIL
RR_CONT6:

; The append made the persistent size 13 records.
        LI      R0,RANDRECS+1
        MOV     R0,@TARGET_RECS
        CALL    @OPEN_FILE
        MOV     R1,R1
        JEQ     RR_CONT7
        B       @RR_FAIL
RR_CONT7:

        LI      R0,RANDRECS+1
        MOV     R0,@RAND_SIZE
        LI      R0,RANDCUR
        MOV     R0,@RAND_CURSOR
        MOV     R0,@TESTFCB+CRN
        CLR     @TESTFCB+CBN

        CALL    @RND_REOP_TEST
        MOV     R1,R1
        JEQ     RR_CONT8
        B       @RR_FAIL
RR_CONT8:

        CALL    @CLOSE_FILE
        MOV     R1,R1
        JEQ     RR_CONT9
        B       @RR_FAIL
RR_CONT9:
        CALL    @DELETE_FILE
        MOV     R1,R1
        JEQ     RR_CONT10
        B       @RR_FAIL
RR_CONT10:

        LI      R0,RANDOM_OK_MSG
        CALL    @PRINTMSG
        LI      R0,PASS_MSG
        CALL    @PRINTMSG
        CLR     R1
        RET

RR_FAIL:
        CALL    @PRINT_FAILURE
        SETO    R1
        RET
;
;
;-----------------------------------------------------------------------
; RUN_PSEL_MEM - PSEL-only memory copy control; NO disk/BDOS I/O in loops.
;
; This separates mapped-memory byte/word transfers from the IDE path.
; Source:      PAGE0/common >0300->04FF (512 bytes)
; Destination: SEG11/PAGE2 >B100->B2FF
;
; Phase 1: MC_ITERS copies using MOVB *R2+,*R4+, verify all 256 words.
; Phase 2: MC_ITERS copies using MOV  *R2+,*R4+, verify all 256 words.
;
; No CALL/XOP/console/disk operation occurs while PSEL is enabled in either
; phase.  A failure reports phase, iteration, byte offset, expected and actual.
;-----------------------------------------------------------------------
RUN_PSEL_MEM:
        CLR     @MC_ITER
        CLR     @MC_PHASE
        CLR     @BAD_OFFSET
        CLR     @EXPECTED
        CLR     @ACTUAL

        LI      R0,MC_BEGIN_MSG
        CALL    @PRINTMSG

        PSEL_DIS
        CALL    @SAVE_MAPS
        CALL    @SET_TEST_MAPS
        CALL    @CHK_TEST_MAPS
        MOV     R1,R1
        JEQ     MCM_MAP_OK
        LI      R0,3
        MOV     R0,@MC_PHASE
        B       @MCM_FAIL0
MCM_MAP_OK:

; Build a deterministic but bit-rich 512-byte source in common PAGE0 RAM.
; This happens with PSEL disabled and contains no IDE activity.
        LI      R2,MC_SRC
        LI      R1,0ACE1H
        LI      R4,0B400H
        LI      R0,NWORDS
MCM_FILL:
        MOV     R1,*R2+
        MOV     R1,R3
        SRL     R3,1
        JNC     MCM_NOX
        XOR     R4,R3
MCM_NOX:
        MOV     R3,R1
        DEC     R0
        JNE     MCM_FILL

;----------------------- PHASE 1: MOVB -------------------------------
        LI      R0,1
        MOV     R0,@MC_PHASE
        CLR     @MC_ITER
        PSEL_EN
MCM_B_ITER:
        LI      R2,MC_SRC
        LI      R4,ST_DMA
        LI      R0,BYTSEC
MCM_B_COPY:
        MOVB    *R2+,*R4+
        DEC     R0
        JNE     MCM_B_COPY

; Verify as words.  Source is SEG0/PAGE0; destination is SEG11/PAGE2.
        LI      R2,MC_SRC
        LI      R4,ST_DMA
        CLR     R3
        LI      R0,NWORDS
MCM_B_VER:
        MOV     *R2+,R5
        MOV     *R4+,R6
        C       R5,R6
        JEQ     MCB_VOK
        B       @MCM_B_BAD
MCB_VOK:
        INCT    R3
        DEC     R0
        JNE     MCM_B_VER

        INC     @MC_ITER
        MOV     @MC_ITER,R0
        CI      R0,MC_ITERS
        JL      MCM_B_ITER
        PSEL_DIS

        LI      R0,MC_B_OK_MSG
        CALL    @PRINTMSG

;----------------------- PHASE 2: MOV -------------------------------
        LI      R0,2
        MOV     R0,@MC_PHASE
        CLR     @MC_ITER
        PSEL_EN
MCM_W_ITER:
        LI      R2,MC_SRC
        LI      R4,ST_DMA
        LI      R0,NWORDS
MCM_W_COPY:
        MOV     *R2+,*R4+
        DEC     R0
        JNE     MCM_W_COPY

        LI      R2,MC_SRC
        LI      R4,ST_DMA
        CLR     R3
        LI      R0,NWORDS
MCM_W_VER:
        MOV     *R2+,R5
        MOV     *R4+,R6
        C       R5,R6
        JEQ     MCW_VOK
        B       @MCM_W_BAD
MCW_VOK:
        INCT    R3
        DEC     R0
        JNE     MCM_W_VER

        INC     @MC_ITER
        MOV     @MC_ITER,R0
        CI      R0,MC_ITERS
        JL      MCM_W_ITER
        PSEL_DIS

        LI      R0,MC_W_OK_MSG
        CALL    @PRINTMSG

; Check that the mapper still has exactly the expected test mapping.
        CALL    @CHK_TEST_MAPS
        MOV     R1,R1
        JEQ     MCM_DONE
        LI      R0,3
        MOV     R0,@MC_PHASE
        B       @MCM_FAIL0

MCM_DONE:
        CALL    @RESTORE_MAPS
        LI      R0,MC_OK_MSG
        CALL    @PRINTMSG
        CLR     R1
        RET

MCM_B_BAD:
        MOV     R3,@BAD_OFFSET
        MOV     R5,@EXPECTED
        MOV     R6,@ACTUAL
        B       @MCM_FAIL

MCM_W_BAD:
        MOV     R3,@BAD_OFFSET
        MOV     R5,@EXPECTED
        MOV     R6,@ACTUAL
        B       @MCM_FAIL

MCM_FAIL:
        PSEL_DIS
MCM_FAIL0:
        CALL    @RESTORE_MAPS
        LI      R0,MC_FAIL_MSG
        CALL    @PRINTMSG
        LI      R0,MC_PHASE_MSG
        CALL    @PRINTMSG
        WHEX    @MC_PHASE
        LI      R0,MC_ITER_MSG
        CALL    @PRINTMSG
        WHEX    @MC_ITER
        LI      R0,MC_OFF_MSG
        CALL    @PRINTMSG
        WHEX    @BAD_OFFSET
        LI      R0,MC_EXP_MSG
        CALL    @PRINTMSG
        WHEX    @EXPECTED
        LI      R0,MC_ACT_MSG
        CALL    @PRINTMSG
        WHEX    @ACTUAL
        LI      R0,CRLF_MSG
        CALL    @PRINTMSG
        SETO    R1
        RET

;-----------------------------------------------------------------------
; RUN_PSEL_STRESS - isolate corruption caused by disk I/O while PSEL is on.
;
; Test strategy:
;   1. Save all 16 mapper registers; set every segment to PAGE0, then map only
;      SEG11 to ST_DMA_PAGE.  BDTEST code/data remain flat, while the X-mode
;      DMA buffer at >B100 is genuinely paged when PSEL is enabled.
;   2. Initialize guard words around the mapped >B100 DMA buffer.
;   3. Create and seed a 64-record file while PSEL is enabled.
;   4. Perform STRESS_ITERS pseudo-random reads and writes.  Each write:
;        - writes a unique seed-derived pattern,
;        - verifies that WRRND did not modify the source DMA buffer,
;        - immediately reads the record back and verifies it.
;      Random reads verify against a shadow seed table plus complement table.
;   5. Every 32 iterations close/reopen the file under PSEL to exercise
;      directory/BAT/metadata paths as well as data-sector I/O.
;   6. If a PSEL-enabled read returns bad data, repeat that same read once
;      with PSEL disabled:
;        TRIAGE=1 : PSEL-off reread is GOOD -> PSEL/read-memory path problem.
;        TRIAGE=2 : PSEL-off reread is BAD  -> not a PSEL-only read failure;
;                   suspect the write/disk path or a non-PSEL read fault.
;        TRIAGE=3 : PSEL-off reread errors  -> control read itself failed.
;        TRIAGE=5 : whole 512-byte read landed in flat PAGE0 at >B100.
;        TRIAGE=6 : second 256-byte transfer landed in PAGE0.
;        TRIAGE=7 : first 256-byte transfer landed in PAGE0.
;      Before each read PAGE0 and PAGE2 receive distinct poison patterns;
;      on failure each 256-byte half is classified before the control reread.
;      A write that mutates the mapped DMA source sets TRIAGE=4 immediately.
;   7. On exit, disable PSEL and verify the X-mode mapper registers.  The
;      original mapper register images are always restored before returning.
;
; The test file is deliberately left on disk after a failure so the disk image
; can be preserved and inspected.  It is erased only after a clean pass.
;-----------------------------------------------------------------------
RUN_PSEL_STRESS:
        CLR     @FAIL_ID
        CLR     @LAST_STATUS
        CLR     @BAD_OFFSET
        CLR     @EXPECTED
        CLR     @ACTUAL
        CLR     @STRESS_ITER
        CLR     @STRESS_OP
        CLR     @STRESS_TRIAGE
        CLR     @P2_HSTAT
        CLR     @P1_HSTAT
        CLR     @P0_HSTAT
        CLR     @P3_HSTAT
        CLR     @ST_CTRL_STAT
        CLR     @MAP_BAD_SEG
        CLR     @MAP_EXPECT
        CLR     @MAP_ACTUAL
        CLR     @STRESS_WRITES
        CLR     @STRESS_READS
        CLR     @STRESS_REOPENS

        LI      R0,ST_BEGIN_MSG
        CALL    @PRINTMSG
        LI      R0,STRESS_RECS
        MOV     R0,@TARGET_RECS
        CLR     @FULFLG

; Save the caller's mapping.  Start from SHELLV62's PAGE0 flat map, then map
; only SEG11 to ST_DMA_PAGE.  This keeps executing segments in PAGE0 while
; giving disk I/O a real paged DMA target at >B100.
        PSEL_DIS
        CALL    @SAVE_MAPS
        CALL    @SET_TEST_MAPS
        CALL    @CHK_TEST_MAPS
        MOV     R1,R1
        JEQ     RJ_T01
        JMP     RJ_F01
RJ_T01:
        B       @RPS_MAP_OK
RJ_F01:
        LI      R0,E_PMAP
        MOV     R0,@FAIL_ID
        B       @RPS_FAIL_DIS
RPS_MAP_OK:
; From this point until clean completion/failure handling, STRESS_BDOS
; reasserts PSEL_EN immediately before and after every BDOS call.
        PSEL_EN
        CALL    @INIT_ST_GUARD
        CALL    @CHK_ST_POSTIO ; prove map readback/guards are clean with PSEL on
        MOV     R1,R1
        JLT     RJ_T02
        JMP     RJ_F02
RJ_T02:
        B       @RPS_FAIL
RJ_F02:
        LI      R0,1
        MOV     R0,@STRESS_OP
        CALL    @STRESS_CREATE
        MOV     R1,R1
        JLT     RJ_T03
        JMP     RJ_F03
RJ_T03:
        B       @RPS_FAIL
RJ_F03:

        LI      R0,2
        MOV     R0,@STRESS_OP
        CALL    @ST_SEED_FILE
        MOV     R1,R1
        JLT     RJ_T04
        JMP     RJ_F04
RJ_T04:
        B       @RPS_FAIL
RJ_F04:

        LI      R0,6
        MOV     R0,@STRESS_OP
        CALL    @STRESS_CLOSE
        MOV     R1,R1
        JLT     RJ_T05
        JMP     RJ_F05
RJ_T05:
        B       @RPS_FAIL
RJ_F05:

        LI      R0,7
        MOV     R0,@STRESS_OP
        CALL    @STRESS_OPEN
        MOV     R1,R1
        JLT     RJ_T06
        JMP     RJ_F06
RJ_T06:
        B       @RPS_FAIL
RJ_F06:

        LI      R0,STRESS_RNG_INIT
        MOV     R0,@STRESS_RNG
        CLR     @STRESS_ITER

RPS_LOOP:
        MOV     @STRESS_ITER,R0
        CI      R0,STRESS_ITERS
        JHE     RJ_T07
        JMP     RJ_F07
RJ_T07:
        B       @RPS_SWEEP
RJ_F07:

; First random value selects the record and operation.
        CALL    @NEXT_STRESS_RNG
        MOV     R0,R5
        ANDI    R0,003FH
        MOV     R0,@RAND_TARGET
        MOV     R0,@CUR_REC
        MOV     R5,R1
        ANDI    R1,0001H
        JNE     RJ_T08
        JMP     RJ_F08
RJ_T08:
        B       @RPS_DO_WRITE
RJ_F08:

;------------------------- random read -------------------------------
RPS_DO_READ:
        LI      R0,3
        MOV     R0,@STRESS_OP
        CALL    @LD_ST_EXPECT
        MOV     R1,R1
        JLT     RJ_T09
        JMP     RJ_F09
RJ_T09:
        B       @RPS_FAIL
RJ_F09:
        CALL    @PREP_READ_BUF
        CALL    @ST_RND_READ
        MOV     R1,R1
        JLT     RJ_T10
        JMP     RJ_F10
RJ_T10:
        B       @RPS_FAIL
RJ_F10:
        INC     @STRESS_READS
        CALL    @STRESS_VERIFY
        MOV     R1,R1
        JEQ     RJ_T11
        JMP     RJ_F11
RJ_T11:
        B       @RPS_READ_GOOD
RJ_F11:
        LI      R0,E_PDATA
        MOV     R0,@FAIL_ID
        CALL    @TRIAGE_BAD_READ
        B       @RPS_FAIL
RPS_READ_GOOD:
        CALL    @CHK_ST_STATE
        MOV     R1,R1
        JLT     RJ_T12
        JMP     RJ_F12
RJ_T12:
        B       @RPS_FAIL
RJ_F12:
        CALL    @CHK_ST_POSTIO
        MOV     R1,R1
        JLT     RJ_T13
        JMP     RJ_F13
RJ_T13:
        B       @RPS_FAIL
RJ_F13:
        B       @RPS_NEXT

;------------------------- random write ------------------------------
RPS_DO_WRITE:
        LI      R0,4
        MOV     R0,@STRESS_OP
        CALL    @NEXT_STRESS_RNG
        MOV     R0,@STRESS_SEED
        JNE     RJ_T14
        JMP     RJ_F14
RJ_T14:
        B       @RPS_SEED_NZ
RJ_F14:
        LI      R0,1
        MOV     R0,@STRESS_SEED
RPS_SEED_NZ:
        CALL    @STRESS_FILL
        CALL    @ST_RND_WRITE
        MOV     R1,R1
        JLT     RJ_T15
        JMP     RJ_F15
RJ_T15:
        B       @RPS_FAIL
RJ_F15:
        INC     @STRESS_WRITES

; A disk WRITE must never modify its source DMA buffer.  Detect that before
; poisoning the buffer for the readback.
        CALL    @STRESS_VERIFY
        MOV     R1,R1
        JEQ     RJ_T16
        JMP     RJ_F16
RJ_T16:
        B       @RPS_WBUF_OK
RJ_F16:
        LI      R0,E_PWBUF
        MOV     R0,@FAIL_ID
        LI      R0,4
        MOV     R0,@STRESS_TRIAGE
        B       @RPS_FAIL
RPS_WBUF_OK:
        CALL    @ST_ST_EXPECT
        CALL    @CHK_ST_STATE
        MOV     R1,R1
        JLT     RJ_T17
        JMP     RJ_F17
RJ_T17:
        B       @RPS_FAIL
RJ_F17:
        CALL    @CHK_ST_POSTIO
        MOV     R1,R1
        JLT     RJ_T18
        JMP     RJ_F18
RJ_T18:
        B       @RPS_FAIL
RJ_F18:

; Immediate PSEL-enabled readback of the record just written.
        LI      R0,5
        MOV     R0,@STRESS_OP
        CALL    @PREP_READ_BUF
        CALL    @ST_RND_READ
        MOV     R1,R1
        JLT     RJ_T19
        JMP     RJ_F19
RJ_T19:
        B       @RPS_FAIL
RJ_F19:
        INC     @STRESS_READS
        CALL    @STRESS_VERIFY
        MOV     R1,R1
        JEQ     RJ_T20
        JMP     RJ_F20
RJ_T20:
        B       @RPS_WRRD_OK
RJ_F20:
        LI      R0,E_PDATA
        MOV     R0,@FAIL_ID
        CALL    @TRIAGE_BAD_READ
        B       @RPS_FAIL
RPS_WRRD_OK:
        CALL    @CHK_ST_STATE
        MOV     R1,R1
        JLT     RJ_T21
        JMP     RJ_F21
RJ_T21:
        B       @RPS_FAIL
RJ_F21:
        CALL    @CHK_ST_POSTIO
        MOV     R1,R1
        JLT     RJ_T22
        JMP     RJ_F22
RJ_T22:
        B       @RPS_FAIL
RJ_F22:

RPS_NEXT:
        INC     @STRESS_ITER

; Exercise directory/metadata paths under PSEL every 32 iterations.
        MOV     @STRESS_ITER,R0
        ANDI    R0,ST_REOPEN_MSK
        JNE     RJ_T23
        JMP     RJ_F23
RJ_T23:
        B       @RPS_LOOP
RJ_F23:
        LI      R0,6
        MOV     R0,@STRESS_OP
        CALL    @STRESS_CLOSE
        MOV     R1,R1
        JLT     RJ_T24
        JMP     RJ_F24
RJ_T24:
        B       @RPS_FAIL
RJ_F24:
        LI      R0,7
        MOV     R0,@STRESS_OP
        CALL    @STRESS_OPEN
        MOV     R1,R1
        JLT     RJ_T25
        JMP     RJ_F25
RJ_T25:
        B       @RPS_FAIL
RJ_F25:
        INC     @STRESS_REOPENS
        B       @RPS_LOOP

; Final PSEL-enabled sweep verifies every record against the shadow table.
RPS_SWEEP:
        CLR     @CUR_REC
RPS_SWEEP_LOOP:
        MOV     @CUR_REC,R0
        CI      R0,STRESS_RECS
        JHE     RJ_T26
        JMP     RJ_F26
RJ_T26:
        B       @RPS_FINISH
RJ_F26:
        MOV     R0,@RAND_TARGET
        LI      R0,8
        MOV     R0,@STRESS_OP
        CALL    @LD_ST_EXPECT
        MOV     R1,R1
        JLT     RJ_T27
        JMP     RJ_F27
RJ_T27:
        B       @RPS_FAIL
RJ_F27:
        CALL    @PREP_READ_BUF
        CALL    @ST_RND_READ
        MOV     R1,R1
        JLT     RJ_T28
        JMP     RJ_F28
RJ_T28:
        B       @RPS_FAIL
RJ_F28:
        INC     @STRESS_READS
        CALL    @STRESS_VERIFY
        MOV     R1,R1
        JEQ     RJ_T29
        JMP     RJ_F29
RJ_T29:
        B       @RPS_SWEEP_GOOD
RJ_F29:
        LI      R0,E_PDATA
        MOV     R0,@FAIL_ID
        CALL    @TRIAGE_BAD_READ
        B       @RPS_FAIL
RPS_SWEEP_GOOD:
        CALL    @CHK_ST_STATE
        MOV     R1,R1
        JLT     RJ_T30
        JMP     RJ_F30
RJ_T30:
        B       @RPS_FAIL
RJ_F30:
        CALL    @CHK_ST_POSTIO
        MOV     R1,R1
        JLT     RJ_T31
        JMP     RJ_F31
RJ_T31:
        B       @RPS_FAIL
RJ_F31:
        INC     @CUR_REC
        B       @RPS_SWEEP_LOOP

RPS_FINISH:
        LI      R0,6
        MOV     R0,@STRESS_OP
        CALL    @STRESS_CLOSE
        MOV     R1,R1
        JLT     RJ_T32
        JMP     RJ_F32
RJ_T32:
        B       @RPS_FAIL
RJ_F32:

; Delete only after every check has passed, still with PSEL enabled.
        LI      R0,9
        MOV     R0,@STRESS_OP
        CALL    @STRESS_DELETE
        MOV     R1,R1
        JLT     RJ_T33
        JMP     RJ_F33
RJ_T33:
        B       @RPS_FAIL
RJ_F33:

; Return to a safe state and verify that disk activity did not alter the
; X-mode mapper state.  Then restore the original map images.
        PSEL_DIS
        CALL    @CHK_TEST_MAPS
        MOV     R1,R1
        JEQ     RJ_T34
        JMP     RJ_F34
RJ_T34:
        B       @RPS_MAPF_OK
RJ_F34:
        LI      R0,E_PMAP
        MOV     R0,@FAIL_ID
        B       @RPS_FAIL_DIS
RPS_MAPF_OK:
        CALL    @RESTORE_MAPS
        LI      R0,STRESS_OK_MSG
        CALL    @PRINTMSG
        LI      R0,ST_COUNT_MSG
        CALL    @PRINTMSG
        WHEX    @STRESS_ITER
        LI      R0,STRESS_WR_MSG
        CALL    @PRINTMSG
        WHEX    @STRESS_WRITES
        LI      R0,STRESS_RD_MSG
        CALL    @PRINTMSG
        WHEX    @STRESS_READS
        LI      R0,STRESS_RO_MSG
        CALL    @PRINTMSG
        WHEX    @STRESS_REOPENS
        LI      R0,CRLF_MSG
        CALL    @PRINTMSG
        LI      R0,PASS_MSG
        CALL    @PRINTMSG
        CLR     R1
        RET

; Failure while PSEL may still be enabled.  Disable it first, capture mapper
; state for diagnostics, then restore the caller's maps.  The test file is NOT
; erased here.
RPS_FAIL:
        PSEL_DIS
RPS_FAIL_DIS:
        CALL    @CHK_TEST_MAPS
        CALL    @RESTORE_MAPS
        CALL    @PRINT_FAILURE
        CALL    @PR_ST_DIAG
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; STRESS_BDOS - call BDOS with PSEL definitely enabled.
; Entry R2=function, R3=argument.  Returns BDOS R1 status.
;
; PSEL_EN is an XOP and may share R0-R7, so save the BDOS arguments in memory
; before asserting PSEL and reload them afterwards.  PSEL is intentionally
; left enabled on return; RUN_PSEL_STRESS disables it only for failure/exit.
;-----------------------------------------------------------------------
STRESS_BDOS:
        MOV     R2,@STRESS_BDOS_FN
        MOV     R3,@STRESS_BDOS_ARG
        PSEL_EN
        MOV     @STRESS_BDOS_FN,R2
        MOV     @STRESS_BDOS_ARG,R3
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        PSEL_EN                 ; caller must see mapped DMA window on return
        MOV     @LAST_STATUS,R1
        RET
;
;-----------------------------------------------------------------------
; Stress file lifecycle helpers.  No console I/O is performed while PSEL is
; active so the stress phase isolates filesystem/disk activity as far as
; practical.
;-----------------------------------------------------------------------
STRESS_CREATE:
        CALL    @INIT_FCB
        LI      R2,ERAFIL
        LI      R3,TESTFCB
        CALL    @STRESS_BDOS      ; stale file erase: ignore not-found
        CALL    @CHK_ST_POSTIO
        MOV     R1,R1
        JLT     STC_RET

        CALL    @INIT_FCB
        LI      R2,MAKFIL
        LI      R3,TESTFCB
        CALL    @STRESS_BDOS
        MOV     R1,R1
        JLT     STC_FAIL
        CALL    @CHK_ST_POSTIO
        MOV     R1,R1
        JLT     STC_RET
        MOV     @TESTFCB+FSB,R0
        CI      R0,FIRSTBLK
        JL      STC_FAIL
        CI      R0,MAXBLK
        JH      STC_FAIL
        LI      R2,SETDMA
        LI      R3,ST_DMA
        CALL    @STRESS_BDOS
        CALL    @CHK_ST_POSTIO
STC_RET:
        RET
STC_FAIL:
        LI      R0,E_PCREATE
        MOV     R0,@FAIL_ID
        SETO    R1
        RET

STRESS_CLOSE:
        LI      R2,FCLOSE
        LI      R3,TESTFCB
        CALL    @STRESS_BDOS
        MOV     R1,R1
        JLT     STCL_FAIL
        CALL    @CHK_ST_POSTIO
        RET
STCL_FAIL:
        LI      R0,E_PCLOSE
        MOV     R0,@FAIL_ID
        SETO    R1
        RET

STRESS_OPEN:
        CALL    @INIT_FCB
        LI      R2,OPEN
        LI      R3,TESTFCB
        CALL    @STRESS_BDOS
        MOV     R1,R1
        JLT     STO_FAIL
        CALL    @CHK_ST_POSTIO
        MOV     R1,R1
        JLT     STO_RET
        LI      R0,STRESS_RECS
        C       R0,@TESTFCB+FSZ
        JNE     STO_SIZE_FAIL
        LI      R2,SETDMA
        LI      R3,ST_DMA
        CALL    @STRESS_BDOS
        LI      R0,RANDCUR
        MOV     R0,@STRESS_CURSOR
        MOV     R0,@TESTFCB+CRN
        CLR     @TESTFCB+CBN
        CALL    @CHK_ST_POSTIO
STO_RET:
        RET
STO_FAIL:
        LI      R0,E_POPEN
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
STO_SIZE_FAIL:
        LI      R0,E_PSIZE
        MOV     R0,@FAIL_ID
        LI      R0,STRESS_RECS
        MOV     R0,@EXPECTED
        MOV     @TESTFCB+FSZ,@ACTUAL
        SETO    R1
        RET

STRESS_DELETE:
        CALL    @INIT_FCB
        LI      R2,ERAFIL
        LI      R3,TESTFCB
        CALL    @STRESS_BDOS
        MOV     R1,R1
        JLT     STD_FAIL
        CALL    @CHK_ST_POSTIO
        RET
STD_FAIL:
        LI      R0,E_PDELETE
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; Seed the fixed-size stress file sequentially.  Initial expected seed for
; record N is N XOR STRESS_SEED_XOR.  The seed and its complement are held in
; separate shadow tables so corruption of the expected-data table is itself
; detectable.
;-----------------------------------------------------------------------
ST_SEED_FILE:
        CLR     @CUR_REC
SSF_LOOP:
        MOV     @CUR_REC,R0
        CI      R0,STRESS_RECS
        JHE     SSF_DONE
        MOV     R0,R1
        LI      R2,STRESS_SEED_XOR
        XOR     R2,R1
        MOV     R1,@STRESS_SEED
        MOV     R0,@RAND_TARGET
        CALL    @STRESS_FILL
        LI      R2,WRSEQ
        LI      R3,TESTFCB
        CALL    @STRESS_BDOS
        MOV     R1,R1
        JLT     SSF_FAIL

; Sequential state must advance exactly one record per successful write.
        MOV     @CUR_REC,R0
        INC     R0
        C       R0,@TESTFCB+CRN
        JNE     SSF_STATE_FAIL
        C       R0,@TESTFCB+FSZ
        JNE     SSF_STATE_FAIL

; A write must not mutate its DMA source buffer.
        CALL    @STRESS_VERIFY
        MOV     R1,R1
        JEQ     SSF_WBUF_OK
        LI      R0,E_PWBUF
        MOV     R0,@FAIL_ID
        LI      R0,4
        MOV     R0,@STRESS_TRIAGE
        SETO    R1
        RET
SSF_WBUF_OK:
        CALL    @ST_ST_EXPECT
        CALL    @CHK_ST_POSTIO
        MOV     R1,R1
        JLT     SSF_RET
        INC     @CUR_REC
        B       @SSF_LOOP
SSF_DONE:
        CLR     R1
SSF_RET:
        RET
SSF_FAIL:
        LI      R0,E_PSEED
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
SSF_STATE_FAIL:
        LI      R0,E_PSTATE
        MOV     R0,@FAIL_ID
        MOV     @CUR_REC,R0
        INC     R0
        MOV     R0,@EXPECTED
        MOV     @TESTFCB+CRN,@ACTUAL
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; Random disk primitives.  RAND_TARGET is an absolute record number.
;-----------------------------------------------------------------------
ST_RND_READ:
        CLR     @TESTFCB+RELB
        MOV     @RAND_TARGET,@TESTFCB+RELR
        LI      R2,RDRND
        LI      R3,TESTFCB
        CALL    @STRESS_BDOS
        MOV     R1,R1
        JLT     STRR_FAIL
        CLR     R1
        RET
STRR_FAIL:
        LI      R0,E_PREAD
        MOV     R0,@FAIL_ID
        SETO    R1
        RET

ST_RND_WRITE:
        CLR     @TESTFCB+RELB
        MOV     @RAND_TARGET,@TESTFCB+RELR
        LI      R2,WRRND
        LI      R3,TESTFCB
        CALL    @STRESS_BDOS
        MOV     R1,R1
        JLT     STRW_FAIL
        CLR     R1
        RET
STRW_FAIL:
        LI      R0,E_PWRITE
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; CHK_ST_STATE - random I/O must preserve file size and sequential CRN.
;-----------------------------------------------------------------------
CHK_ST_STATE:
        LI      R0,STRESS_RECS
        C       R0,@TESTFCB+FSZ
        JNE     CSS_SIZE_FAIL
        MOV     @STRESS_CURSOR,R0
        C       R0,@TESTFCB+CRN
        JNE     CSS_CURSOR_FAIL
        CLR     R1
        RET
CSS_SIZE_FAIL:
        LI      R0,E_PSTATE
        MOV     R0,@FAIL_ID
        LI      R0,STRESS_RECS
        MOV     R0,@EXPECTED
        MOV     @TESTFCB+FSZ,@ACTUAL
        SETO    R1
        RET
CSS_CURSOR_FAIL:
        LI      R0,E_PSTATE
        MOV     R0,@FAIL_ID
        MOV     @STRESS_CURSOR,@EXPECTED
        MOV     @TESTFCB+CRN,@ACTUAL
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; Stress pattern format (512 bytes):
;   word0 = STRESS_MAGIC
;   word1 = logical record number
;   word2 = per-write pseudo-random seed
;   word3 = complement of seed
;   words4..255 = (seed XOR record)+4, then +0101H per word.
;-----------------------------------------------------------------------
STRESS_FILL:
        LI      R0,ST_DMA
        LI      R1,STRESS_MAGIC
        MOV     R1,*R0+
        MOV     @RAND_TARGET,*R0+
        MOV     @STRESS_SEED,R1
        MOV     R1,*R0+
        INV     R1
        MOV     R1,*R0+
        MOV     @STRESS_SEED,R1
        XOR     @RAND_TARGET,R1
        AI      R1,4
        LI      R2,NWORDS-4
STF_LOOP:
        MOV     R1,*R0+
        AI      R1,0101H
        DEC     R2
        JNE     STF_LOOP
        RET

STRESS_VERIFY:
        LI      R0,ST_DMA
        CLR     R3
        LI      R2,STRESS_MAGIC
        MOV     *R0+,R4
        C       R4,R2
        JNE     STV_FAIL
        INCT    R3
        MOV     @RAND_TARGET,R2
        MOV     *R0+,R4
        C       R4,R2
        JNE     STV_FAIL
        INCT    R3
        MOV     @STRESS_SEED,R2
        MOV     *R0+,R4
        C       R4,R2
        JNE     STV_FAIL
        INCT    R3
        INV     R2
        MOV     *R0+,R4
        C       R4,R2
        JNE     STV_FAIL
        INCT    R3
        MOV     @STRESS_SEED,R2
        XOR     @RAND_TARGET,R2
        AI      R2,4
        LI      R1,NWORDS-4
STV_LOOP:
        MOV     *R0+,R4
        C       R4,R2
        JNE     STV_FAIL
        INCT    R3
        AI      R2,0101H
        DEC     R1
        JNE     STV_LOOP
        CLR     R1
        RET
STV_FAIL:
        MOV     R3,@BAD_OFFSET
        MOV     R2,@EXPECTED
        MOV     R4,@ACTUAL
        SETO    R1
        RET

POISON_BUFFER:
; Flat/control poison used after PSEL has already been disabled.
        LI      R0,ST_DMA
        LI      R1,0BEEFH
        LI      R2,NWORDS
PB_LOOP:
        MOV     R1,*R0+
        AI      R1,0222H
        DEC     R2
        JNE     PB_LOOP
        RET

; PREP_READ_BUF - poison all four physical pages at the DMA address.
; Each page receives a distinct sequence.  The intended DMA destination is
; PAGE2.  Leaves SEG11 mapped to PAGE2 with PSEL enabled.
PREP_READ_BUF:
        LI      R0,0
        CALL    @SET_DMAPG
        LI      R0,ST_DMA
        LI      R1,0BEEFH
        LI      R2,NWORDS
PRB_P0:
        MOV     R1,*R0+
        AI      R1,0222H
        DEC     R2
        JNE     PRB_P0

        LI      R0,1
        CALL    @SET_DMAPG
        LI      R0,ST_DMA
        LI      R1,0A55AH
        LI      R2,NWORDS
PRB_P1:
        MOV     R1,*R0+
        AI      R1,0333H
        DEC     R2
        JNE     PRB_P1

        LI      R0,2
        CALL    @SET_DMAPG
        LI      R0,ST_DMA
        LI      R1,0DEADH
        LI      R2,NWORDS
PRB_P2:
        MOV     R1,*R0+
        AI      R1,0111H
        DEC     R2
        JNE     PRB_P2

        LI      R0,3
        CALL    @SET_DMAPG
        LI      R0,ST_DMA
        LI      R1,05AA5H
        LI      R2,NWORDS
PRB_P3:
        MOV     R1,*R0+
        AI      R1,0444H
        DEC     R2
        JNE     PRB_P3

        LI      R0,ST_DMA_PAGE
        CALL    @SET_DMAPG
        RET

; SET_DMAPG - map SEG11 to page R0 and enable PSEL.
SET_DMAPG:
        MOV     R0,@TMP_DMAPG
        PSEL_DIS
        LI      R12,ST_DMA_CRU
        MOV     @TMP_DMAPG,R0
        SLA     R0,8
        LDCR    R0,MAPWIDTH
        PSEL_EN
        RET

CHK_EXP_H0:
        LI      R0,ST_DMA
        LI      R2,STRESS_MAGIC
        MOV     *R0+,R4
        C       R4,R2
        JNE     CEH0_BAD
        MOV     @RAND_TARGET,R2
        MOV     *R0+,R4
        C       R4,R2
        JNE     CEH0_BAD
        MOV     @STRESS_SEED,R2
        MOV     *R0+,R4
        C       R4,R2
        JNE     CEH0_BAD
        INV     R2
        MOV     *R0+,R4
        C       R4,R2
        JNE     CEH0_BAD
        MOV     @STRESS_SEED,R2
        XOR     @RAND_TARGET,R2
        AI      R2,4
        LI      R3,124
CEH0_LOOP:
        MOV     *R0+,R4
        C       R4,R2
        JNE     CEH0_BAD
        AI      R2,0101H
        DEC     R3
        JNE     CEH0_LOOP
        CLR     R1
        RET
CEH0_BAD:
        SETO    R1
        RET

CHK_EXP_H1:
        LI      R0,ST_DMA+0100H
        MOV     @STRESS_SEED,R2
        XOR     @RAND_TARGET,R2
        AI      R2,07C7CH
        LI      R3,128
CEH1_LOOP:
        MOV     *R0+,R4
        C       R4,R2
        JNE     CEH1_BAD
        AI      R2,0101H
        DEC     R3
        JNE     CEH1_LOOP
        CLR     R1
        RET
CEH1_BAD:
        SETO    R1
        RET

CHK_P2_PO0:
        LI      R0,ST_DMA
        LI      R2,0DEADH
        LI      R3,0111H
        B       @CHK_PO128
CHK_P2_PO1:
        LI      R0,ST_DMA+0100H
        LI      R2,0672DH
        LI      R3,0111H
        B       @CHK_PO128
CHK_P0_PO0:
        LI      R0,ST_DMA
        LI      R2,0BEEFH
        LI      R3,0222H
        B       @CHK_PO128
CHK_P0_PO1:
        LI      R0,ST_DMA+0100H
        LI      R2,0CFEFH
        LI      R3,0222H
        B       @CHK_PO128
CHK_P1_PO0:
        LI      R0,ST_DMA
        LI      R2,0A55AH
        LI      R3,0333H
        B       @CHK_PO128
CHK_P1_PO1:
        LI      R0,ST_DMA+0100H
        LI      R2,03EDAH
        LI      R3,0333H
        B       @CHK_PO128
CHK_P3_PO0:
        LI      R0,ST_DMA
        LI      R2,05AA5H
        LI      R3,0444H
        B       @CHK_PO128
CHK_P3_PO1:
        LI      R0,ST_DMA+0100H
        LI      R2,07CA5H
        LI      R3,0444H
CHK_PO128:
        LI      R1,128
CPO_LOOP:
        MOV     *R0+,R4
        C       R4,R2
        JNE     CPO_BAD
        A       R3,R2
        DEC     R1
        JNE     CPO_LOOP
        CLR     R1
        B       *R11
CPO_BAD:
        SETO    R1
        B       *R11

PROF_P2:
        CLR     @ERR_CNT
        CLR     @ERR_H0
        CLR     @ERR_H1
        CLR     @ERR_XOROR
        CLR     @ERR_CLROR
        CLR     @ERR_SETOR
        CLR     @ERR_X3CNT
        SETO    @ERR_FIRST
        CLR     @ERR_LAST
        LI      R0,ST_DMA
        CLR     R3
        LI      R2,STRESS_MAGIC
        BL      @PROF_WORD
        MOV     @RAND_TARGET,R2
        BL      @PROF_WORD
        MOV     @STRESS_SEED,R2
        BL      @PROF_WORD
        INV     R2
        BL      @PROF_WORD
        MOV     @STRESS_SEED,R2
        XOR     @RAND_TARGET,R2
        AI      R2,4
        LI      R1,NWORDS-4
PP2_LOOP:
        BL      @PROF_WORD
        AI      R2,0101H
        DEC     R1
        JNE     PP2_LOOP
        RET

PROF_WORD:
        MOV     *R0+,R4
        C       R4,R2
        JEQ     PW_OK
        INC     @ERR_CNT
        MOV     @ERR_CNT,R5
        CI      R5,1
        JNE     PW_NOT1
        MOV     R3,@ERR_FIRST
PW_NOT1:
        MOV     R3,@ERR_LAST
        CI      R3,0100H
        JL      PW_H0
        INC     @ERR_H1
        JMP     PW_BITS
PW_H0:
        INC     @ERR_H0
PW_BITS:
        MOV     R4,R5
        XOR     R2,R5
        SOC     R5,@ERR_XOROR
        CI      R5,0003H
        JNE     PW_NX3
        INC     @ERR_X3CNT
PW_NX3:
        MOV     R2,R5
        SZC     R4,R5
        SOC     R5,@ERR_CLROR
        MOV     R4,R5
        SZC     R2,R5
        SOC     R5,@ERR_SETOR
PW_OK:
        INCT    R3
        B       *R11

CLASS_CUR:
        CLR     @TMP_HSTAT
        CALL    @CHK_EXP_H0
        MOV     R1,R1
        JEQ     CC_H0_EXP
        BL      *R5
        MOV     R1,R1
        JNE     CC_H0_DONE
        LI      R0,0200H
        MOV     R0,@TMP_HSTAT
        JMP     CC_H0_DONE
CC_H0_EXP:
        LI      R0,0100H
        MOV     R0,@TMP_HSTAT
CC_H0_DONE:
        CALL    @CHK_EXP_H1
        MOV     R1,R1
        JEQ     CC_H1_EXP
        BL      *R6
        MOV     R1,R1
        JNE     CC_H1_DONE
        INCT    @TMP_HSTAT
        JMP     CC_H1_DONE
CC_H1_EXP:
        INC     @TMP_HSTAT
CC_H1_DONE:
        MOV     @TMP_HSTAT,R0
        RET

SNAP_HALVES:
        CLR     @P0_HSTAT
        CLR     @P1_HSTAT
        CLR     @P2_HSTAT
        CLR     @P3_HSTAT
        CALL    @PROF_P2
        LI      R5,CHK_P2_PO0
        LI      R6,CHK_P2_PO1
        CALL    @CLASS_CUR
        MOV     R0,@P2_HSTAT
        LI      R0,0
        CALL    @SET_DMAPG
        LI      R5,CHK_P0_PO0
        LI      R6,CHK_P0_PO1
        CALL    @CLASS_CUR
        MOV     R0,@P0_HSTAT
        LI      R0,1
        CALL    @SET_DMAPG
        LI      R5,CHK_P1_PO0
        LI      R6,CHK_P1_PO1
        CALL    @CLASS_CUR
        MOV     R0,@P1_HSTAT
        LI      R0,3
        CALL    @SET_DMAPG
        LI      R5,CHK_P3_PO0
        LI      R6,CHK_P3_PO1
        CALL    @CLASS_CUR
        MOV     R0,@P3_HSTAT
        PSEL_DIS
        LI      R12,ST_DMA_CRU
        LI      R0,ST_DMA_PAGE
        SLA     R0,8
        LDCR    R0,MAPWIDTH
        RET
;
;-----------------------------------------------------------------------
; Shadow-table helpers.  The complement table detects corruption of the
; tester's own expected-data bookkeeping.
;-----------------------------------------------------------------------
ST_ST_EXPECT:
        MOV     @RAND_TARGET,R0
        SLA     R0,1
        LI      R1,STRESS_SHADOW
        A       R0,R1
        MOV     @STRESS_SEED,*R1
        LI      R1,ST_SHAD_INV
        A       R0,R1
        MOV     @STRESS_SEED,R2
        INV     R2
        MOV     R2,*R1
        RET

LD_ST_EXPECT:
        MOV     @RAND_TARGET,R0
        SLA     R0,1
        LI      R1,STRESS_SHADOW
        A       R0,R1
        MOV     *R1,R2
        MOV     R2,@STRESS_SEED
        INV     R2
        LI      R1,ST_SHAD_INV
        A       R0,R1
        C       R2,*R1
        JNE     LSE_FAIL
        CLR     R1
        RET
LSE_FAIL:
        LI      R0,E_PSHADOW
        MOV     R0,@FAIL_ID
        MOV     R2,@EXPECTED
        MOV     *R1,@ACTUAL
        MOV     @RAND_TARGET,R0
        SLA     R0,1
        MOV     R0,@BAD_OFFSET
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; Guard words immediately surrounding ST_DMA catch DMA overruns/underruns.
;-----------------------------------------------------------------------
INIT_ST_GUARD:
        LI      R0,ST_GLO
        LI      R1,GUARD_WORDS
        LI      R2,GUARD_LO_PAT
ISG_LO:
        MOV     R2,*R0+
        DEC     R1
        JNE     ISG_LO
        LI      R0,ST_GHI
        LI      R1,GUARD_WORDS
        LI      R2,GUARD_HI_PAT
ISG_HI:
        MOV     R2,*R0+
        DEC     R1
        JNE     ISG_HI
        RET

CHK_ST_POSTIO:
        CALL    @CHK_TEST_MAPS
        MOV     R1,R1
        JEQ     CSPO_MAP_OK
        LI      R0,E_PMAP
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
CSPO_MAP_OK:
        CALL    @CHK_ST_GUARDS
        RET

CHK_ST_GUARDS:
        LI      R0,ST_GLO
        LI      R1,GUARD_WORDS
        LI      R2,GUARD_LO_PAT
CSG_LO:
        MOV     *R0+,R4
        C       R4,R2
        JNE     CSG_FAIL
        DEC     R1
        JNE     CSG_LO
        LI      R0,ST_GHI
        LI      R1,GUARD_WORDS
        LI      R2,GUARD_HI_PAT
CSG_HI:
        MOV     *R0+,R4
        C       R4,R2
        JNE     CSG_FAIL
        DEC     R1
        JNE     CSG_HI
        CLR     R1
        RET
CSG_FAIL:
        LI      R1,E_PGUARD
        MOV     R1,@FAIL_ID
        MOV     R0,R1
        DECT    R1
        MOV     R1,@BAD_OFFSET    ; absolute address of damaged guard word
        MOV     R2,@EXPECTED
        MOV     R4,@ACTUAL
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; TRIAGE_BAD_READ - a PSEL-enabled read has already failed STRESS_VERIFY.
; Save that mismatch, disable PSEL, and reread the same record once through
; ordinary BDOS.  This does not write the disk.
;-----------------------------------------------------------------------
TRIAGE_BAD_READ:
        MOV     @BAD_OFFSET,@PSEL_BAD_OFFSET
        MOV     @EXPECTED,@PSEL_EXPECTED
        MOV     @ACTUAL,@PSEL_ACTUAL

; Preserve the corrupt PAGE2 image before touching PSEL or the mapper.
; BAD_COPY lives with the test image in the normal PAGE0 address space.
        LI      R0,ST_DMA
        LI      R1,BAD_COPY
        LI      R2,NWORDS
TBR_BCPY:
        MOV     *R0+,*R1+
        DEC     R2
        JNE     TBR_BCPY

; Control A: toggle PSEL only.  No mapper write and no disk I/O.
; If the same PAGE2 record now verifies, the RAM contents were good and
; the failure was a transient PSEL/GAL visibility state after disk I/O.
        PSEL_DIS
        PSEL_EN
        CALL    @STRESS_VERIFY
        MOV     R1,R1
        JNE     TBR_REMAP
        LI      R0,10
        MOV     R0,@STRESS_TRIAGE
        PSEL_DIS
        B       @TBR_RESTORE

; Control B: explicitly rewrite SEG11=PAGE2, still with no disk I/O.
; If this alone fixes the record, the mapper register/output state was stale
; even though its later readback may have looked correct.
TBR_REMAP:
        LI      R0,ST_DMA_PAGE
        CALL    @SET_DMAPG
        CALL    @STRESS_VERIFY
        MOV     R1,R1
        JNE     TBR_SNAP
        LI      R0,11
        MOV     R0,@STRESS_TRIAGE
        PSEL_DIS
        B       @TBR_RESTORE

; The record is still bad after a PSEL toggle and explicit remap.  Snapshot
; all physical pages, then perform the original PSEL-off disk reread control.
TBR_SNAP:
        CALL    @SNAP_HALVES

; Whole record landed in PAGE0.
        MOV     @P0_HSTAT,R0
        CI      R0,0101H
        JNE     TBR_CHK_H1
        LI      R0,5
        MOV     R0,@STRESS_TRIAGE
        B       @TBR_RESTORE

; First 256 bytes are correct in PAGE2, while second 256 bytes are correct
; in PAGE0: the transfer switched physical bank at the half-record boundary.
TBR_CHK_H1:
        MOV     @P2_HSTAT,R0
        ANDI    R0,0FF00H
        CI      R0,0100H
        JNE     TBR_CHK_H0
        MOV     @P0_HSTAT,R0
        ANDI    R0,00FFH
        CI      R0,0001H
        JNE     TBR_CHK_H0
        LI      R0,6
        MOV     R0,@STRESS_TRIAGE
        B       @TBR_RESTORE

; Mirror case: first transfer landed in PAGE0, second is correct in PAGE2.
TBR_CHK_H0:
        MOV     @P0_HSTAT,R0
        ANDI    R0,0FF00H
        CI      R0,0100H
        JNE     TBR_P1
        MOV     @P2_HSTAT,R0
        ANDI    R0,00FFH
        CI      R0,0001H
        JNE     TBR_P1
        LI      R0,7
        MOV     R0,@STRESS_TRIAGE
        B       @TBR_RESTORE
TBR_P1:
        MOV     @P1_HSTAT,R0
        CI      R0,0101H
        JNE     TBR_P3
        LI      R0,8
        MOV     R0,@STRESS_TRIAGE
        B       @TBR_RESTORE
TBR_P3:
        MOV     @P3_HSTAT,R0
        CI      R0,0101H
        JNE     TBR_CTRL
        LI      R0,9
        MOV     R0,@STRESS_TRIAGE
        B       @TBR_RESTORE

; No alternate page contains a complete record.  Perform the
; original PSEL-off reread to distinguish transient PSEL-path corruption
; from bad disk/file data.
TBR_CTRL:
        CALL    @POISON_BUFFER
        CLR     @TESTFCB+RELB
        MOV     @RAND_TARGET,@TESTFCB+RELR
        LI      R2,RDRND
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@ST_CTRL_STAT
        MOV     R1,R1
        JLT     TBR_CTRL_ERR
        CALL    @STRESS_VERIFY
        MOV     R1,R1
        JNE     TBR_CTRL_BAD
        LI      R0,1
        MOV     R0,@STRESS_TRIAGE
        B       @TBR_RESTORE
TBR_CTRL_BAD:
        LI      R0,2
        MOV     R0,@STRESS_TRIAGE
        B       @TBR_RESTORE
TBR_CTRL_ERR:
        LI      R0,3
        MOV     R0,@STRESS_TRIAGE
TBR_RESTORE:
        MOV     @PSEL_BAD_OFFSET,@BAD_OFFSET
        MOV     @PSEL_EXPECTED,@EXPECTED
        MOV     @PSEL_ACTUAL,@ACTUAL
        RET
;
;-----------------------------------------------------------------------
; 16-bit Galois LFSR.  Returns new value in R0.
;-----------------------------------------------------------------------
NEXT_STRESS_RNG:
        MOV     @STRESS_RNG,R0
        SRL     R0,1
        JNC     NSR_STORE
        LI      R1,0B400H
        XOR     R1,R0
NSR_STORE:
        MOV     R0,@STRESS_RNG
        RET
;
;-----------------------------------------------------------------------
; Mapper save / test-map / check / restore.
; MAP_GET encoding follows MAPDEBUG/SHELL hardware convention:
; STCR count 2 returns the mapper byte in the high byte; SRL 8 yields PAGE.
; Restore uses PAGE << 8 followed by LDCR count 2, exactly like MAP_SET.
; X mode expects PAGE0 everywhere except SEG11=ST_DMA_PAGE.
;-----------------------------------------------------------------------
SAVE_MAPS:
        PSEL_DIS
        LI      R8,ORIG_MAPS
        CLR     R9
SVM_LOOP:
        LI      R12,MAP_BASE_PORT
        MOV     R9,R0
        SLA     R0,1
        A       R0,R12
        CLR     R0
        STCR    R0,MAPWIDTH
        SRL     R0,8
        MOV     R0,*R8+
        INC     R9
        CI      R9,16
        JL      SVM_LOOP
        CLR     R1
        RET

SET_TEST_MAPS:
        PSEL_DIS
; shell flat map first
        LI      R12,MAP_BASE_PORT
        CLR     R0
        LI      R9,16
STM_ZERO:
        LDCR    R0,MAPWIDTH
        INCT    R12
        DEC     R9
        JNE     STM_ZERO
; only SEG11 is nonzero: genuine paged DMA window at >B000->>BFFF
        LI      R12,ST_DMA_CRU
        LI      R0,ST_DMA_PAGE
        SLA     R0,8
        LDCR    R0,MAPWIDTH
        CLR     R1
        RET

CHK_TEST_MAPS:
        CLR     @MAP_BAD_SEG
        CLR     @MAP_EXPECT
        CLR     @MAP_ACTUAL
        LI      R12,MAP_BASE_PORT
        CLR     R9
CTM_LOOP:
        CLR     R0
        STCR    R0,MAPWIDTH
        SRL     R0,8
        CLR     R1
        CI      R9,ST_DMA_SEG
        JNE     CTM_COMPARE
        LI      R1,ST_DMA_PAGE
CTM_COMPARE:
        C       R0,R1
        JNE     CTM_FAIL
        INCT    R12
        INC     R9
        CI      R9,16
        JL      CTM_LOOP
        CLR     R1
        RET
CTM_FAIL:
        MOV     R9,@MAP_BAD_SEG
        MOV     R1,@MAP_EXPECT
        MOV     R0,@MAP_ACTUAL
        SETO    R1
        RET

RESTORE_MAPS:
        PSEL_DIS
        LI      R8,ORIG_MAPS
        CLR     R9
RSM_LOOP:
        LI      R12,MAP_BASE_PORT
        MOV     R9,R0
        SLA     R0,1
        A       R0,R12
        MOV     *R8+,R0
        SLA     R0,8
        LDCR    R0,MAPWIDTH
        INC     R9
        CI      R9,16
        JL      RSM_LOOP
        CLR     R1
        RET
;
;-----------------------------------------------------------------------
; PR_ST_DIAG - extra forensic information for X-mode failures.
;-----------------------------------------------------------------------
PR_ST_DIAG:
        LI      R0,ST_DIAG_MSG
        CALL    @PRINTMSG
        WHEX    @STRESS_ITER
        LI      R0,STRESS_OP_MSG
        CALL    @PRINTMSG
        WHEX    @STRESS_OP
        LI      R0,STRESS_RNG_MSG
        CALL    @PRINTMSG
        WHEX    @STRESS_RNG
        LI      R0,ST_TRI_MSG
        CALL    @PRINTMSG
        WHEX    @STRESS_TRIAGE
        LI      R0,STRESS_CTRL_MSG
        CALL    @PRINTMSG
        WHEX    @ST_CTRL_STAT
        LI      R0,ST_MAPS_MSG
        CALL    @PRINTMSG
        WHEX    @MAP_BAD_SEG
        LI      R0,ST_MAPE_MSG
        CALL    @PRINTMSG
        WHEX    @MAP_EXPECT
        LI      R0,ST_MAPA_MSG
        CALL    @PRINTMSG
        WHEX    @MAP_ACTUAL
        LI      R0,ST_HALF2_MSG
        CALL    @PRINTMSG
        WHEX    @P2_HSTAT
        LI      R0,ST_HALF0_MSG
        CALL    @PRINTMSG
        WHEX    @P0_HSTAT
        LI      R0,ST_HALF1_MSG
        CALL    @PRINTMSG
        WHEX    @P1_HSTAT
        LI      R0,ST_HALF3_MSG
        CALL    @PRINTMSG
        WHEX    @P3_HSTAT
        LI      R0,CRLF_MSG
        CALL    @PRINTMSG
        LI      R0,HALF_KEY_MSG
        CALL    @PRINTMSG
        LI      R0,ERRCNT_MSG
        CALL    @PRINTMSG
        WHEX    @ERR_CNT
        LI      R0,ERRH0_MSG
        CALL    @PRINTMSG
        WHEX    @ERR_H0
        LI      R0,ERRH1_MSG
        CALL    @PRINTMSG
        WHEX    @ERR_H1
        LI      R0,ERRXOR_MSG
        CALL    @PRINTMSG
        WHEX    @ERR_XOROR
        LI      R0,ERRCLR_MSG
        CALL    @PRINTMSG
        WHEX    @ERR_CLROR
        LI      R0,ERRSET_MSG
        CALL    @PRINTMSG
        WHEX    @ERR_SETOR
        LI      R0,ERRX3_MSG
        CALL    @PRINTMSG
        WHEX    @ERR_X3CNT
        LI      R0,ERRFST_MSG
        CALL    @PRINTMSG
        WHEX    @ERR_FIRST
        LI      R0,ERRLST_MSG
        CALL    @PRINTMSG
        WHEX    @ERR_LAST
        LI      R0,CRLF_MSG
        CALL    @PRINTMSG

; For TRIAGE 1, PAGE0 now contains the clean control reread and BAD_COPY
; contains the original corrupt PAGE2 image.  Print a 16-word window around
; the first cutover so byte/word skew is visible immediately.
        MOV     @STRESS_TRIAGE,R0
        CI      R0,1
        JNE     PSD_NOEDGE
        CALL    @PRINT_EDGE
PSD_NOEDGE:
        MOV     @STRESS_TRIAGE,R0
        JEQ     PSD_RET
        CI      R0,1
        JEQ     PSD_T1
        CI      R0,2
        JEQ     PSD_T2
        CI      R0,3
        JEQ     PSD_T3
        CI      R0,4
        JEQ     PSD_T4
        CI      R0,5
        JEQ     PSD_T5
        CI      R0,6
        JEQ     PSD_T6
        CI      R0,7
        JEQ     PSD_T7
        CI      R0,8
        JEQ     PSD_T8
        CI      R0,9
        JEQ     PSD_T9
        CI      R0,10
        JEQ     PSD_T10
        CI      R0,11
        JEQ     PSD_T11
        B       @PSD_RET
PSD_T1:
        LI      R0,TRIAGE1_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T2:
        LI      R0,TRIAGE2_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T3:
        LI      R0,TRIAGE3_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T4:
        LI      R0,TRIAGE4_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T5:
        LI      R0,TRIAGE5_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T6:
        LI      R0,TRIAGE6_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T7:
        LI      R0,TRIAGE7_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T8:
        LI      R0,TRIAGE8_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T9:
        LI      R0,TRIAGE9_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T10:
        LI      R0,TRIAGE10_MSG
        CALL    @PRINTMSG
        B       @PSD_RET
PSD_T11:
        LI      R0,TRIAGE11_MSG
        CALL    @PRINTMSG
PSD_RET:
        RET

;-----------------------------------------------------------------------
; PRINT_EDGE - compare clean PAGE0 reread with saved corrupt PAGE2 image.
; Prints four words before the first mismatch and twelve words after it.
;-----------------------------------------------------------------------
PRINT_EDGE:
        MOV     @PSEL_BAD_OFFSET,R8
        CI      R8,8
        JHE     PEDGE_SUB
        CLR     R8
        JMP     PEDGE_SET
PEDGE_SUB:
        AI      R8,-8
PEDGE_SET:
        LI      R0,16
        MOV     R0,@EDGE_CNT
        LI      R0,EDGE_HDR_MSG
        CALL    @PRINTMSG
PEDGE_LOOP:
        LI      R9,ST_DMA
        A       R8,R9
        MOV     *R9,@EDGE_GOOD
        LI      R9,BAD_COPY
        A       R8,R9
        MOV     *R9,@EDGE_BAD
        MOV     @EDGE_BAD,R9
        XOR     @EDGE_GOOD,R9
        MOV     R9,@EDGE_XOR

        LI      R0,EDGE_O_MSG
        CALL    @PRINTMSG
        WHEX    R8
        LI      R0,EDGE_G_MSG
        CALL    @PRINTMSG
        WHEX    @EDGE_GOOD
        LI      R0,EDGE_B_MSG
        CALL    @PRINTMSG
        WHEX    @EDGE_BAD
        LI      R0,EDGE_X_MSG
        CALL    @PRINTMSG
        WHEX    @EDGE_XOR
        LI      R0,CRLF_MSG
        CALL    @PRINTMSG

        INCT    R8
        DEC     @EDGE_CNT
        JNE     PEDGE_LOOP
        RET

;-----------------------------------------------------------------------
; RND_ACT_TEST - tests against the first open of the 12-record file.
;-----------------------------------------------------------------------
RND_ACT_TEST:
; SETREL must copy CRN to RELR and clear RELB.
        SETO    @TESTFCB+RELB
        CLR     @TESTFCB+RELR
        LI      R2,SETREL
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     @TESTFCB+RELB,R0
        JEQ     RAT_SETREL_OK1
        B       @RAT_SETREL_FAIL
RAT_SETREL_OK1:
        MOV     @RAND_CURSOR,R0
        C       R0,@TESTFCB+RELR
        JEQ     RAT_SETREL_OK2
        B       @RAT_SETREL_FAIL
RAT_SETREL_OK2:

; GETSIZ must return the current file size in RELR and clear RELB.
        SETO    @TESTFCB+RELB
        CLR     @TESTFCB+RELR
        LI      R2,GETSIZ
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     RAT_GETSIZ_BAD1
        JMP     RAT_GETSIZ_OK1
RAT_GETSIZ_BAD1:
        B       @RAT_GETSIZ_FAIL
RAT_GETSIZ_OK1:
        MOV     @TESTFCB+RELB,R0
        JEQ     RAT_GETSIZ_OK2
        B       @RAT_GETSIZ_FAIL
RAT_GETSIZ_OK2:
        MOV     @RAND_SIZE,R0
        C       R0,@TESTFCB+RELR
        JEQ     RAT_GETSIZ_OK3
        B       @RAT_GETSIZ_FAIL
RAT_GETSIZ_OK3:
        CALL    @CHECK_RND_STATE
        MOV     R1,R1
        JEQ     RAT_CONT1
        RET
RAT_CONT1:

; Read records on both sides of allocation-block boundaries.
        CLR     R0
        CLR     R1
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT2
        RET
RAT_CONT2:
        LI      R0,3
        LI      R1,3
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT3
        RET
RAT_CONT3:
        LI      R0,4
        LI      R1,4
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT4
        RET
RAT_CONT4:
        LI      R0,7
        LI      R1,7
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT5
        RET
RAT_CONT5:
        LI      R0,8
        LI      R1,8
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT6
        RET
RAT_CONT6:
        LI      R0,11
        LI      R1,11
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT7
        RET
RAT_CONT7:

; Reading exactly at EOF must fail without moving the sequential cursor.
        MOV     @RAND_SIZE,R0
        MOV     R0,@RAND_TARGET
        CLR     @TESTFCB+RELB
        MOV     R0,@TESTFCB+RELR
        LI      R2,RDRND
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     RAT_EOF_STATE
        LI      R0,E_REOF
        MOV     R0,@FAIL_ID
        MOV     @RAND_TARGET,@CUR_REC
        SETO    R1
        RET
RAT_EOF_STATE:
        CALL    @CHECK_RND_STATE
        MOV     R1,R1
        JEQ     RAT_CONT8
        RET
RAT_CONT8:

; A nonzero high random-record word is invalid for this disk geometry.
        CLR     @RAND_TARGET
        LI      R0,1
        MOV     R0,@TESTFCB+RELB
        CLR     @TESTFCB+RELR
        LI      R2,RDRND
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     RAT_RELB_STATE
        LI      R0,E_RRELB
        MOV     R0,@FAIL_ID
        CLR     @CUR_REC
        SETO    R1
        RET
RAT_RELB_STATE:
        CLR     @TESTFCB+RELB
        CALL    @CHECK_RND_STATE
        MOV     R1,R1
        JEQ     RAT_CONT9
        RET
RAT_CONT9:

; Overwrite logical record 4 with a distinct pattern.  FSZ must remain 12.
        LI      R0,4
        MOV     R0,@RAND_TARGET
        LI      R0,ALTPAT
        MOV     R0,@CUR_REC
        CALL    @FILL_BUFFER
        CLR     @TESTFCB+RELB
        LI      R0,4
        MOV     R0,@TESTFCB+RELR
        LI      R2,WRRND
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JEQ     RAT_WRITE_OK1
        B       @RAT_WRITE_FAIL
RAT_WRITE_OK1:
        CALL    @CHECK_RND_STATE
        MOV     R1,R1
        JEQ     RAT_CONT10
        RET
RAT_CONT10:

; Verify target and neighbours immediately.
        LI      R0,3
        LI      R1,3
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT11
        RET
RAT_CONT11:
        LI      R0,4
        LI      R1,ALTPAT
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT12
        RET
RAT_CONT12:
        LI      R0,5
        LI      R1,5
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT13
        RET
RAT_CONT13:

; Append record 12 exactly at EOF.  This allocates the next 4-record block.
        LI      R0,RANDRECS
        MOV     R0,@RAND_TARGET
        MOV     R0,@CUR_REC
        CALL    @FILL_BUFFER
        CLR     @TESTFCB+RELB
        MOV     @RAND_TARGET,@TESTFCB+RELR
        LI      R2,WRRND
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JEQ     RAT_WRITE_OK2
        B       @RAT_WRITE_FAIL
RAT_WRITE_OK2:
        INC     @RAND_SIZE
        CALL    @CHECK_RND_STATE
        MOV     R1,R1
        JEQ     RAT_CONT14
        RET
RAT_CONT14:
        LI      R0,RANDRECS
        LI      R1,RANDRECS
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RAT_CONT15
        RET
RAT_CONT15:

; A sparse write one record beyond EOF (record 14 while size is 13) must fail.
        MOV     @RAND_SIZE,R0
        INC     R0
        MOV     R0,@RAND_TARGET
        MOV     R0,@CUR_REC
        CALL    @FILL_BUFFER
        CLR     @TESTFCB+RELB
        MOV     @RAND_TARGET,@TESTFCB+RELR
        LI      R2,WRRND
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     RAT_SP_STATE
        LI      R0,E_RSPARSE
        MOV     R0,@FAIL_ID
        MOV     @RAND_TARGET,@CUR_REC
        SETO    R1
        RET
RAT_SP_STATE:
        CALL    @CHECK_RND_STATE
        MOV     R1,R1
        JEQ     RAT_CONT16
        RET
RAT_CONT16:

        LI      R0,RND_ACT_OK_MSG
        CALL    @PRINTMSG
        CLR     R1
RAT_RET:
        RET

RAT_SETREL_FAIL:
        LI      R0,E_RSETREL
        MOV     R0,@FAIL_ID
        MOV     @RAND_CURSOR,@EXPECTED
        MOV     @TESTFCB+RELR,@ACTUAL
        MOV     @RAND_CURSOR,@CUR_REC
        SETO    R1
        RET
RAT_GETSIZ_FAIL:
        LI      R0,E_RGETSIZ
        MOV     R0,@FAIL_ID
        MOV     @RAND_SIZE,@EXPECTED
        MOV     @TESTFCB+RELR,@ACTUAL
        MOV     @RAND_SIZE,@CUR_REC
        SETO    R1
        RET
RAT_WRITE_FAIL:
        LI      R0,E_RWRITE
        MOV     R0,@FAIL_ID
        MOV     @RAND_TARGET,@CUR_REC
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; RND_REOP_TEST - prove random changes survived close and reopen.
;-----------------------------------------------------------------------
RND_REOP_TEST:
        LI      R0,3
        LI      R1,3
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RROT_CONT1
        RET
RROT_CONT1:
        LI      R0,4
        LI      R1,ALTPAT
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RROT_CONT2
        RET
RROT_CONT2:
        LI      R0,5
        LI      R1,5
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RROT_CONT3
        RET
RROT_CONT3:
        LI      R0,RANDRECS
        LI      R1,RANDRECS
        CALL    @RAND_READ_CHECK
        MOV     R1,R1
        JEQ     RROT_CONT4
        RET
RROT_CONT4:

; GETSIZ must now report 13 records.
        SETO    @TESTFCB+RELB
        CLR     @TESTFCB+RELR
        LI      R2,GETSIZ
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     RROT_GSZ_FAIL
        MOV     @TESTFCB+RELB,R0
        JNE     RROT_GSZ_FAIL
        MOV     @RAND_SIZE,R0
        C       R0,@TESTFCB+RELR
        JNE     RROT_GSZ_FAIL
        CALL    @CHECK_RND_STATE
        MOV     R1,R1
        JEQ     RROT_CONT5
        RET
RROT_CONT5:

; EOF must remain immediately after the appended record.
        MOV     @RAND_SIZE,R0
        MOV     R0,@RAND_TARGET
        CLR     @TESTFCB+RELB
        MOV     R0,@TESTFCB+RELR
        LI      R2,RDRND
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     RROT_EOF_STATE
        LI      R0,E_REOF
        MOV     R0,@FAIL_ID
        MOV     @RAND_TARGET,@CUR_REC
        SETO    R1
        RET
RROT_EOF_STATE:
        CALL    @CHECK_RND_STATE
        MOV     R1,R1
        JEQ     RROT_CONT6
        RET
RROT_CONT6:

        LI      R0,RND_RO_OK_MSG
        CALL    @PRINTMSG
        CLR     R1
RROT_RET:
        RET
RROT_GSZ_FAIL:
        LI      R0,E_RGETSIZ
        MOV     R0,@FAIL_ID
        MOV     @RAND_SIZE,@EXPECTED
        MOV     @TESTFCB+RELR,@ACTUAL
        MOV     @RAND_SIZE,@CUR_REC
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; RAND_READ_CHECK
;   R0 = logical record address to read
;   R1 = record number used to generate the expected pattern
;-----------------------------------------------------------------------
RAND_READ_CHECK:
        MOV     R0,@RAND_TARGET
        MOV     R1,@CUR_REC
        CLR     @TESTFCB+RELB
        MOV     R0,@TESTFCB+RELR
        LI      R2,RDRND
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     RRC_READ_FAIL

        CALL    @CHECK_RND_STATE
        MOV     R1,R1
        JEQ     RRC_STATE_OK
        RET
RRC_STATE_OK:

        CALL    @VERIFY_BUFFER
        MOV     R1,R1
        JLT     RRC_DATA_FAIL
        CLR     R1
RRC_RET:
        RET
RRC_READ_FAIL:
        LI      R0,E_RREAD
        MOV     R0,@FAIL_ID
        MOV     @RAND_TARGET,@CUR_REC
        SETO    R1
        RET
RRC_DATA_FAIL:
        LI      R0,E_RDATA
        MOV     R0,@FAIL_ID
        MOV     @RAND_TARGET,@CUR_REC
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; CHECK_RND_STATE - random operations must preserve CRN and FSZ.
;-----------------------------------------------------------------------
CHECK_RND_STATE:
        MOV     @RAND_CURSOR,R0
        C       R0,@TESTFCB+CRN
        JNE     CRS_CURSOR_FAIL
        MOV     @RAND_SIZE,R0
        C       R0,@TESTFCB+FSZ
        JNE     CRS_SIZE_FAIL
        CLR     R1
        RET
CRS_CURSOR_FAIL:
        LI      R0,E_RCURSOR
        MOV     R0,@FAIL_ID
        MOV     @RAND_CURSOR,@EXPECTED
        MOV     @TESTFCB+CRN,@ACTUAL
        MOV     @RAND_TARGET,@CUR_REC
        SETO    R1
        RET
CRS_SIZE_FAIL:
        LI      R0,E_RSIZE
        MOV     R0,@FAIL_ID
        MOV     @RAND_SIZE,@EXPECTED
        MOV     @TESTFCB+FSZ,@ACTUAL
        MOV     @RAND_TARGET,@CUR_REC
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; CREATE_FILE - erase any stale test file, then create a clean one.
;-----------------------------------------------------------------------
CREATE_FILE:
        CALL    @INIT_FCB
        LI      R2,ERAFIL
        LI      R3,TESTFCB
        CALL    @BDOS            ; ignore "not found"

        CALL    @INIT_FCB        ; erase/search may have altered fields
        LI      R2,MAKFIL
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     CF_MAKE_FAIL

        MOV     @TESTFCB+FSB,R0
        CI      R0,FIRSTBLK
        JL      CF_FSB_FAIL
        CI      R0,MAXBLK
        JH      CF_FSB_FAIL

        CALL    @SET_TEST_DMA
        CLR     R1
        RET

CF_MAKE_FAIL:
        LI      R0,E_MAKE
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
CF_FSB_FAIL:
        LI      R0,E_FSB
        MOV     R0,@FAIL_ID
        MOV     @TESTFCB+FSB,@ACTUAL
        LI      R0,FIRSTBLK
        MOV     R0,@EXPECTED
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; WRITE_FILE - append TARGET_RECS records and check FSZ/CRN each time.
;-----------------------------------------------------------------------
WRITE_FILE:
        CLR     @CUR_REC

WF_LOOP:
        MOV     @CUR_REC,R0
        C       R0,@TARGET_RECS
        JEQ     WF_DONE

        CALL    @FILL_BUFFER
        LI      R2,WRSEQ
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     WF_WRITE_ERROR

        MOV     @CUR_REC,R0
        INC     R0               ; expected next-record pointer and size
        C       R0,@TESTFCB+CRN
        JNE     WF_FCB_FAIL
        C       R0,@TESTFCB+FSZ
        JNE     WF_FCB_FAIL

        MOV     R0,@CUR_REC
        CALL    @PROGRESS
        JMP     WF_LOOP

WF_DONE:
        MOV     @FULFLG,R0
        JEQ     WF_OK

; If all 2872 possible records were written, one further append must fail.
; On a partially occupied disk, an earlier write failure is accepted as the
; clean end of remaining capacity, provided FSZ and CRN did not advance.
        CALL    @FILL_BUFFER
        LI      R2,WRSEQ
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     WF_FULL_STATE

        LI      R0,E_FULL
        MOV     R0,@FAIL_ID
        SETO    R1
        RET

WF_FULL_STATE:
        MOV     @TARGET_RECS,R0
        C       R0,@TESTFCB+CRN
        JNE     WF_FSTATE_FAIL
        C       R0,@TESTFCB+FSZ
        JNE     WF_FSTATE_FAIL

WF_OK:
        LI      R0,WRITE_OK_MSG
        CALL    @PRINTMSG
        CLR     R1
        RET

WF_WRITE_ERROR:
        MOV     @FULFLG,R0
        JEQ     WF_WRITE_FAIL

; Disk-full allocation can occur only when a new 4-record block is needed.
; A failure inside an already allocated block is an I/O or chain error.
        MOV     @CUR_REC,R0
        JEQ     WF_WRITE_FAIL
        MOV     R0,R1
        ANDI    R1,0003H
        JNE     WF_WRITE_FAIL

; Expected capacity exhaustion during F mode.  The number already written
; becomes the readback target.  The rejected write must not advance state.
        MOV     R0,@TARGET_RECS
        C       R0,@TESTFCB+CRN
        JNE     WF_FSTATE_FAIL
        C       R0,@TESTFCB+FSZ
        JNE     WF_FSTATE_FAIL
        LI      R0,CAPACITY_MSG
        CALL    @PRINTMSG
        WHEX    @TARGET_RECS
        LI      R0,RECORDS_MSG
        CALL    @PRINTMSG
        JMP     WF_OK

WF_WRITE_FAIL:
        LI      R0,E_WRITE
        MOV     R0,@FAIL_ID
        SETO    R1
        RET

WF_FCB_FAIL:
        LI      R0,E_WFCB
        MOV     R0,@FAIL_ID
        MOV     @CUR_REC,R0
        INC     R0
        MOV     R0,@EXPECTED
        MOV     @TESTFCB+CRN,@ACTUAL
        SETO    R1
        RET

WF_FSTATE_FAIL:
        LI      R0,E_FSTATE
        MOV     R0,@FAIL_ID
        MOV     @TARGET_RECS,@EXPECTED
        MOV     @TESTFCB+FSZ,@ACTUAL
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; CLOSE_FILE.
;-----------------------------------------------------------------------
CLOSE_FILE:
        LI      R2,FCLOSE
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     CL_FAIL
        CLR     R1
        RET
CL_FAIL:
        LI      R0,E_CLOSE
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; OPEN_FILE - rebuild filename-only FCB, open, verify recorded size.
;-----------------------------------------------------------------------
OPEN_FILE:
        CALL    @INIT_FCB
        LI      R2,OPEN
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     OF_OPEN_FAIL

        MOV     @TARGET_RECS,R0
        C       R0,@TESTFCB+FSZ
        JNE     OF_SIZE_FAIL
        MOV     @TESTFCB+CRN,R0
        JNE     OF_SIZE_FAIL

        CALL    @SET_TEST_DMA
        CLR     R1
        RET

OF_OPEN_FAIL:
        LI      R0,E_OPEN
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
OF_SIZE_FAIL:
        LI      R0,E_SIZE
        MOV     R0,@FAIL_ID
        MOV     @TARGET_RECS,@EXPECTED
        MOV     @TESTFCB+FSZ,@ACTUAL
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; READ_FILE - sequentially read/verify all records and then verify EOF.
;-----------------------------------------------------------------------
READ_FILE:
        CLR     @CUR_REC

RF_LOOP:
        MOV     @CUR_REC,R0
        C       R0,@TARGET_RECS
        JEQ     RF_EOF_TEST

        LI      R2,RDSEQ
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     RF_READ_FAIL

        CALL    @VERIFY_BUFFER
        MOV     R1,R1
        JLT     RF_DATA_FAIL

        INC     @CUR_REC
        CALL    @PROGRESS
        JMP     RF_LOOP

RF_EOF_TEST:
        LI      R2,RDSEQ
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     RF_OK

        LI      R0,E_EOF
        MOV     R0,@FAIL_ID
        SETO    R1
        RET

RF_OK:
        LI      R0,READ_OK_MSG
        CALL    @PRINTMSG
        CLR     R1
        RET

RF_READ_FAIL:
        LI      R0,E_READ
        MOV     R0,@FAIL_ID
        SETO    R1
        RET

RF_DATA_FAIL:
        LI      R0,E_DATA
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; DELETE_FILE - delete the verified file and reclaim its chain.
;-----------------------------------------------------------------------
DELETE_FILE:
        CALL    @INIT_FCB
        LI      R2,ERAFIL
        LI      R3,TESTFCB
        CALL    @BDOS
        MOV     R1,@LAST_STATUS
        MOV     R1,R1
        JLT     DF_FAIL
        LI      R0,DELETE_OK_MSG
        CALL    @PRINTMSG
        CLR     R1
        RET
DF_FAIL:
        LI      R0,E_ERASE
        MOV     R0,@FAIL_ID
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; INIT_FCB - clear all 36 bytes and copy the fixed 8.3 filename.
;-----------------------------------------------------------------------
INIT_FCB:
        LI      R0,FCBSIZ/2
        LI      R1,TESTFCB
IF_ZERO:
        CLR     *R1+
        DEC     R0
        JNE     IF_ZERO

        LI      R0,11
        LI      R1,TEST_NAME
        LI      R2,TESTFCB
IF_NAME:
        MOVB    *R1+,*R2+
        DEC     R0
        JNE     IF_NAME
        RET
;
;-----------------------------------------------------------------------
; SET_TEST_DMA - point BDOS sequential I/O at the local 512-byte buffer.
;-----------------------------------------------------------------------
SET_TEST_DMA:
        LI      R2,SETDMA
        LI      R3,DMABUF
        CALL    @BDOS
        RET
;
;-----------------------------------------------------------------------
; FILL_BUFFER - create deterministic contents for CUR_REC.
;-----------------------------------------------------------------------
FILL_BUFFER:
        LI      R0,DMABUF
        LI      R1,MAGIC
        MOV     R1,*R0+
        MOV     @CUR_REC,*R0+
        MOV     @CUR_REC,R1
        INV     R1
        MOV     R1,*R0+

        LI      R2,PATWORDS
        MOV     @CUR_REC,R1
        AI      R1,3
FB_LOOP:
        MOV     R1,*R0+
        INC     R1
        DEC     R2
        JNE     FB_LOOP
        RET
;
;-----------------------------------------------------------------------
; VERIFY_BUFFER - verify all 256 words against CUR_REC.
; On failure saves byte offset, expected and actual values.
;-----------------------------------------------------------------------
VERIFY_BUFFER:
        LI      R0,DMABUF
        CLR     R3               ; byte offset

        LI      R2,MAGIC
        MOV     *R0+,R4
        C       R4,R2
        JNE     VB_FAIL
        INCT    R3

        MOV     @CUR_REC,R2
        MOV     *R0+,R4
        C       R4,R2
        JNE     VB_FAIL
        INCT    R3

        MOV     @CUR_REC,R2
        INV     R2
        MOV     *R0+,R4
        C       R4,R2
        JNE     VB_FAIL
        INCT    R3

        LI      R1,PATWORDS
        MOV     @CUR_REC,R2
        AI      R2,3
VB_LOOP:
        MOV     *R0+,R4
        C       R4,R2
        JNE     VB_FAIL
        INCT    R3
        INC     R2
        DEC     R1
        JNE     VB_LOOP

        CLR     R1
        RET

VB_FAIL:
        MOV     R3,@BAD_OFFSET
        MOV     R2,@EXPECTED
        MOV     R4,@ACTUAL
        SETO    R1
        RET
;
;-----------------------------------------------------------------------
; PROGRESS - print one dot after each 64 records.
;-----------------------------------------------------------------------
PROGRESS:
        MOV     @CUR_REC,R0
        ANDI    R0,003FH
        JNE     PR_RET
        LI      R3,'.'
        CALL    @PUTC
PR_RET:
        RET
;
;-----------------------------------------------------------------------
; PRINT_FAILURE - compact diagnostic, all values in hexadecimal.
;-----------------------------------------------------------------------
PRINT_FAILURE:
        MOV     @TESTFCB+FSZ,@FAIL_FSZ
        MOV     @TESTFCB+CRN,@FAIL_CRN
        MOV     @TESTFCB+FSB,@FAIL_FSB

        LI      R0,FAIL_MSG
        CALL    @PRINTMSG
        WHEX    @FAIL_ID
        LI      R0,REC_MSG
        CALL    @PRINTMSG
        WHEX    @CUR_REC
        LI      R0,STATUS_MSG
        CALL    @PRINTMSG
        WHEX    @LAST_STATUS
        LI      R0,FSB_MSG
        CALL    @PRINTMSG
        WHEX    @FAIL_FSB
        LI      R0,FSZ_MSG
        CALL    @PRINTMSG
        WHEX    @FAIL_FSZ
        LI      R0,CRN_MSG
        CALL    @PRINTMSG
        WHEX    @FAIL_CRN
        LI      R0,OFF_MSG
        CALL    @PRINTMSG
        WHEX    @BAD_OFFSET
        LI      R0,EXP_MSG
        CALL    @PRINTMSG
        WHEX    @EXPECTED
        LI      R0,ACT_MSG
        CALL    @PRINTMSG
        WHEX    @ACTUAL
        LI      R0,CRLF_MSG
        CALL    @PRINTMSG
        RET
;
;-----------------------------------------------------------------------
; Console helpers.
; PRINTMSG: R0 -> null-terminated bytes.
; PUTC: R3 low byte = output character.
;-----------------------------------------------------------------------
PRINTMSG:
        MOVB    *R0+,R3
        JEQ     PM_DONE
        SWPB    R3
        PUSH    R0
        CALL    @PUTC
        POP     R0
        JMP     PRINTMSG
PM_DONE:
        RET

PUTC:
        LI      R2,COUT
        CALL    @BDOS
        RET
;
;-----------------------------------------------------------------------
; Messages and fixed test filename.
;-----------------------------------------------------------------------
BANNER:
        BYTE    0DH,0AH
        TEXT    'BDTEST59 - BDOS 5.9 + PSEL MEM/CUTOVER DIAG'
        BYTE    0DH,0AH
        TEXT    'DESTRUCTIVE ONLY TO BDTEST.DAT'
        BYTE    0DH,0AH,0
        EVEN
MENU_MSG:
        BYTE    0DH,0AH
        TEXT    'S=5 B=505 P=1017 2=2041 F=FULL R=RANDOM M=PMEM X=PSEL A=ALL Q=QUIT > '
        BYTE    0
        EVEN
BAD_KEY:
        TEXT    'UNKNOWN OPTION'
        BYTE    0DH,0AH,0
        EVEN
ALL_MSG:
        TEXT    'RUNNING 5, 505, 1017, 2041 AND RANDOM TESTS'
        BYTE    0DH,0AH,0
        EVEN
BEGIN_MSG:
        BYTE    0DH,0AH
        TEXT    'BEGIN RECORDS=>'
        BYTE    0
        EVEN
RECORDS_MSG:
        TEXT    ' (HEX)'
        BYTE    0DH,0AH,0
        EVEN
CAPACITY_MSG:
        BYTE    0DH,0AH
