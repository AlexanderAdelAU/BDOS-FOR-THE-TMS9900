;-----------------------------------------------------------------------
; BDTEST62 - BDOS 6.0 sequential, random, and directory integrity tester
;
; Written for Alexander Cameron's TMS9900/TMS99000 CP/M-style system.
; Updated for 16.77MB Isolated Geometry and Folder Compartmentalization.
;
; DESTRUCTIVE ONLY TO THE FILE:  BDTEST.DAT AND FOLDER: TESTDIR
;
; Menu tests:
;   S = 5 records       - basic allocation-chain extension
;   B = 505 records     - crosses physical block 127 -> 128
;   P = 1017 records    - crosses BAT page 0 -> 1 (block 256)
;   2 = 2041 records    - crosses BAT page 1 -> 2 (block 512)
;   F = fill remaining free space (32,704 records max on 16.77MB disk)
;   R = random read/write, cursor, size, EOF and allocation-boundary tests
;   C = sequential cursor repositioning
;   D = directory creation and compartmentalization test
;   A = All of the above (except F)
;   Q = quit
;-----------------------------------------------------------------------
;
; Monitor XOPs used by existing applications.
;
	DXOP	PSEL_DIS,0
	DXOP	PSEL_EN,1
	DXOP	CALL,6
	DXOP	RET,7
	DXOP	PUSH,8
	DXOP	POP,9
	DXOP	WHEX,10
;
; Register equates.
;
R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
R9	EQU	9
SP	EQU	10
R11	EQU	11
R12	EQU	12
;
; Operating-system pointers and entry values, matching XMODEM57.A99.
;
TPA	EQU	00500H	; old flat load address - see COMBASE below
COMBASE	EQU	01000H	; where the shell loads a COM (FCB FLA)
SHELL	EQU	080H            ; low-memory pointer to shell entry
BDOS	EQU	084H            ; low-memory pointer to BDOS entry
CMDL	EQU	0A0H            ; low-memory pointer to the typed command line
;
; BDOS functions.
;
CIN	EQU	1
COUT	EQU	2
OPEN	EQU	15
FCLOSE	EQU	16
ERAFIL	EQU	19
RDSEQ	EQU	20
WRSEQ	EQU	21
MAKFIL	EQU	22
SETDMA	EQU	26
RDRND	EQU	33
WRRND	EQU	34
GETSIZ	EQU	35
SETREL	EQU	36
MKDIR	EQU	41
CHDIR	EQU	42
;
; FCB offsets used by BDOS60.
;
NAM	EQU	0
FTY	EQU	11
FSB	EQU	12
FSZ	EQU	14
FLA	EQU	16
FLD_ID	EQU	18
LRBL	EQU	20
CBN	EQU	24
CRN	EQU	26
RELB	EQU	28
RELR	EQU	30
FCBSIZ	EQU	36
;
; Test constants.
;
BYTSEC	EQU	512
NWORDS	EQU	BYTSEC/2
PATWORDS	EQU	NWORDS-3
MAGIC	EQU	0B059H

; --- 16.77 MB Disk Geometry Equates ---
FIRSTBLK	EQU	8               ; OS System Blocks 0-7
MAXBLK		EQU	4095            ; 4096 blocks total (0-4095)
FULLRECS	EQU	32704           ; 4088 blocks * 8 sectors

RANDRECS	EQU	12              ; three complete allocation blocks
RANDCUR	EQU	6               ; sequential cursor sentinel
ALTPAT	EQU	0A504H          ; replacement pattern for logical record 4
;
; Failure identifiers printed in hexadecimal.
;
E_MAKE	EQU	1
E_FSB	EQU	2
E_WRITE	EQU	3
E_WFCB	EQU	4
E_CLOSE	EQU	5
E_OPEN	EQU	6
E_SIZE	EQU	7
E_READ	EQU	8
E_DATA	EQU	9
E_EOF	EQU	10
E_ERASE	EQU	11
E_FULL	EQU	12
E_FSTATE	EQU	13
E_RSETREL	EQU	14
E_RGETSIZ	EQU	15
E_RREAD	EQU	16
E_RDATA	EQU	17
E_RCURSOR	EQU	18
E_RSIZE	EQU	19
E_RWRITE	EQU	20
E_REOF	EQU	21
E_RRELB	EQU	22
E_RSPARSE	EQU	23
E_SKOPEN	EQU	29
E_SKREAD	EQU	30
E_SKDATA	EQU	31
E_SKCRN	EQU	32
E_MKDIR	EQU	38
E_CHDIR	EQU	39
;
	AORG	COMBASE
	JMP	START
;
;-----------------------------------------------------------------------
; Main menu.
;-----------------------------------------------------------------------
START:
	CALL	@ARGSCAN
	LI	R0,BANNER
	CALL	@PRINTMSG

MENU:
	MOV	@ARGPTR,R9
	JNE	MENU_ARG
	LI	R0,MENU_MSG
	CALL	@PRINTMSG
	LI	R2,CIN
	CLR	R3
	CALL	@BDOS
	MOV	R1,R8
	ANDI	R8,00FFH
	JMP	MENU_ECHO
;
MENU_ARG:
	MOVB	*R9,R1
	INC	R9
	SRL	R1,8
	JEQ	MENU_ARGE
	CI	R1,00DH
	JEQ	MENU_ARGE
	CI	R1,020H
	JLE	MENU_ARG
	MOV	R9,@ARGPTR
	MOV	R1,R8
	MOV	R8,R3
	CALL	@PUTC
	JMP	MENU_ECHO
MENU_ARGE:
	B	@EXIT
;
MENU_ECHO:
	LI	R3,00DH
	CALL	@PUTC
	LI	R3,00AH
	CALL	@PUTC

	CI	R8,'2'
	JEQ	MENU_2

	ANDI	R8,00DFH
	CI	R8,'Q'
	JNE	MENU_NOT_Q
	B	@EXIT
MENU_NOT_Q:
	CI	R8,'S'
	JEQ	MENU_S
	CI	R8,'B'
	JEQ	MENU_B
	CI	R8,'P'
	JEQ	MENU_P
	CI	R8,'F'
	JEQ	MENU_F
	CI	R8,'R'
	JEQ	MENU_R
	CI	R8,'C'
	JEQ	MENU_C
	CI	R8,'D'
	JEQ	MENU_D
	CI	R8,'A'
	JEQ	MENU_A

	LI	R0,BAD_KEY
	CALL	@PRINTMSG
	B	@MENU

MENU_S:
	LI	R0,5
	CLR	R1
	CALL	@RUNTEST
	MOV	R1,R1
	JLT	FAIL_EXIT
	B	@MENU

MENU_B:
	LI	R0,505
	CLR	R1
	CALL	@RUNTEST
	MOV	R1,R1
	JLT	FAIL_EXIT
	B	@MENU

MENU_P:
	LI	R0,1017
	CLR	R1
	CALL	@RUNTEST
	MOV	R1,R1
	JLT	FAIL_EXIT
	B	@MENU

MENU_2:
	LI	R0,2041
	CLR	R1
	CALL	@RUNTEST
	MOV	R1,R1
	JLT	FAIL_EXIT
	B	@MENU

MENU_F:
	LI	R0,FULLRECS
	LI	R1,1
	CALL	@RUNTEST
	MOV	R1,R1
	JLT	FAIL_EXIT
	B	@MENU

MENU_R:
	CALL	@RUN_RANDOM
	MOV	R1,R1
	JLT	FAIL_EXIT
	B	@MENU

MENU_C:
	CALL	@RUN_SEEK
	MOV	R1,R1
	JLT	FAIL_EXIT
	B	@MENU

MENU_D:
	CALL	@RUN_DIR
	MOV	R1,R1
	JLT	FAIL_EXIT
	B	@MENU

MENU_A:
	LI	R0,ALL_MSG
	CALL	@PRINTMSG
	LI	R0,5
	CLR	R1
	CALL	@RUNTEST
	MOV	R1,R1
	JLT	FAIL_EXIT
	LI	R0,505
	CLR	R1
	CALL	@RUNTEST
	MOV	R1,R1
	JLT	FAIL_EXIT
	LI	R0,1017
	CLR	R1
	CALL	@RUNTEST
	MOV	R1,R1
	JLT	FAIL_EXIT
	LI	R0,2041
	CLR	R1
	CALL	@RUNTEST
	MOV	R1,R1
	JLT	FAIL_EXIT
	CALL	@RUN_RANDOM
	MOV	R1,R1
	JLT	FAIL_EXIT
	CALL	@RUN_SEEK
	MOV	R1,R1
	JLT	FAIL_EXIT
	CALL	@RUN_DIR
	MOV	R1,R1
	JLT	FAIL_EXIT
	B	@MENU

FAIL_EXIT:
	LI	R0,STOP_MSG
	CALL	@PRINTMSG
	SETO	R1
	B	@SHELL

;-----------------------------------------------------------------------
; ARGSCAN
;-----------------------------------------------------------------------
ARGSCAN:
	CLR	@ARGPTR
	MOV	@CMDL,R9
	MOV	R9,R9
	JEQ	ARGS_RET
ARGS_CMD:
	MOVB	*R9,R1
	SRL	R1,8
	JEQ	ARGS_RET
	CI	R1,00DH
	JEQ	ARGS_RET
	CI	R1,020H
	JLE	ARGS_SEP
	INC	R9
	JMP	ARGS_CMD
ARGS_SEP:
	INC	R9
	MOVB	*R9,R1
	SRL	R1,8
	JEQ	ARGS_RET
	CI	R1,00DH
	JEQ	ARGS_RET
	CI	R1,020H
	JLE	ARGS_SEP
	MOV	R9,@ARGPTR
ARGS_RET:
	RET
;
EXIT:
	LI	R0,BYE_MSG
	CALL	@PRINTMSG
	CLR	R1
	B	@SHELL
;
;-----------------------------------------------------------------------
; RUNTEST
;-----------------------------------------------------------------------
RUNTEST:
	MOV	R0,@TARGET_RECS
	MOV	R1,@FULFLG
	CLR	@FAIL_ID
	CLR	@LAST_STATUS
	CLR	@BAD_OFFSET
	CLR	@EXPECTED
	CLR	@ACTUAL

	LI	R0,BEGIN_MSG
	CALL	@PRINTMSG
	WHEX	@TARGET_RECS
	LI	R0,RECORDS_MSG
	CALL	@PRINTMSG

	CALL	@CREATE_FILE
	MOV	R1,R1
	JLT	RT_FAIL
	CALL	@WRITE_FILE
	MOV	R1,R1
	JLT	RT_FAIL
	CALL	@CLOSE_FILE
	MOV	R1,R1
	JLT	RT_FAIL
	CALL	@OPEN_FILE
	MOV	R1,R1
	JLT	RT_FAIL
	CALL	@READ_FILE
	MOV	R1,R1
	JLT	RT_FAIL
	CALL	@CLOSE_FILE
	MOV	R1,R1
	JLT	RT_FAIL
	CALL	@DELETE_FILE
	MOV	R1,R1
	JLT	RT_FAIL

	LI	R0,PASS_MSG
	CALL	@PRINTMSG
	CLR	R1
	RET

RT_FAIL:
	CALL	@PRINT_FAILURE
	SETO	R1
	RET

;-----------------------------------------------------------------------
; RUN_DIR - Tests Folder Creation and Context Isolation
;-----------------------------------------------------------------------
RUN_DIR:
	CLR	@FAIL_ID
	CLR	@LAST_STATUS
	LI	R0,DIR_BEGIN_MSG
	CALL	@PRINTMSG

	; 1. Create the Directory (Ignore error if it already exists)
	LI	R2,MKDIR
	LI	R3,TEST_DIR
	CALL	@BDOS

	; 2. Change into the Directory
	LI	R2,CHDIR
	LI	R3,TEST_DIR
	CALL	@BDOS
	MOV	R1,R1
	JLT	RD_CFAIL

	; 3. Run a basic file lifecycle test inside the compartment
	LI	R0,5
	MOV	R0,@TARGET_RECS
	CLR	@FULFLG

	CALL	@CREATE_FILE
	MOV	R1,R1
	JLT	RD_FAIL
	CALL	@WRITE_FILE
	MOV	R1,R1
	JLT	RD_FAIL
	CALL	@CLOSE_FILE
	MOV	R1,R1
	JLT	RD_FAIL
	CALL	@OPEN_FILE
	MOV	R1,R1
	JLT	RD_FAIL
	CALL	@READ_FILE
	MOV	R1,R1
	JLT	RD_FAIL
	CALL	@CLOSE_FILE
	MOV	R1,R1
	JLT	RD_FAIL
	CALL	@DELETE_FILE
	MOV	R1,R1
	JLT	RD_FAIL

	; 4. Return to Root Directory
	LI	R2,CHDIR
	LI	R3,ROOT_DIR
	CALL	@BDOS

	LI	R0,DIR_OK_MSG
	CALL	@PRINTMSG
	CLR	R1
	RET

RD_CFAIL:
	LI	R0,E_CHDIR
	MOV	R0,@FAIL_ID
	SETO	R1
	RET
RD_FAIL:
	CALL	@PRINT_FAILURE
	SETO	R1
	RET

;
;-----------------------------------------------------------------------
; RUN_SEEK
;-----------------------------------------------------------------------
SEEKRECS	EQU	8
SEEK_FWD_REC	EQU	2
SEEK_BACK_REC	EQU	1

RUN_SEEK:
	LI	R0,SEEKRECS
	MOV	R0,@TARGET_RECS
	CLR	@FULFLG
	CLR	@FAIL_ID
	CLR	@LAST_STATUS
	CLR	@BAD_OFFSET
	CLR	@EXPECTED
	CLR	@ACTUAL

	LI	R0,SEEK_BEGIN_MSG
	CALL	@PRINTMSG
	CALL	@CREATE_FILE
	MOV	R1,R1
	JEQ	RS_C1
	B	@RS_FAIL
RS_C1:
	CALL	@WRITE_FILE
	MOV	R1,R1
	JEQ	RS_C2
	B	@RS_FAIL
RS_C2:
	CALL	@CLOSE_FILE
	MOV	R1,R1
	JEQ	RS_C3
	B	@RS_FAIL
RS_C3:
	CALL	@OPEN_FILE
	MOV	R1,R1
	JEQ	RS_C4
	B	@RS_FAIL
RS_C4:
	CLR	@CUR_REC
	CALL	@SEEK_RDSEQ
	MOV	R1,R1
	JLT	RS_FAIL

	LI	R0,SEEK_FWD_REC
	MOV	R0,@SEEK_TARGET
	CALL	@SEEK_PLANT

	MOV	@SEEK_TARGET,R0
	MOV	R0,@CUR_REC
	CALL	@SEEK_RDSEQ
	MOV	R1,R1
	JLT	RS_FAIL

	MOV	@SEEK_TARGET,R0
	INC	R0
	C	R0,@TESTFCB+CRN
	JEQ	RS_T2
	MOV	R0,@EXPECTED
	MOV	@TESTFCB+CRN,@ACTUAL
	LI	R0,E_SKCRN
	MOV	R0,@FAIL_ID
	B	@RS_FAIL

RS_T2:
	LI	R0,SEEK_BACK_REC
	MOV	R0,@SEEK_TARGET
	CALL	@SEEK_PLANT

	MOV	@SEEK_TARGET,R0
	MOV	R0,@CUR_REC
	CALL	@SEEK_RDSEQ
	MOV	R1,R1
	JLT	RS_FAIL

	MOV	@SEEK_TARGET,R0
	INC	R0
	C	R0,@TESTFCB+CRN
	JEQ	RS_PASS
	MOV	R0,@EXPECTED
	MOV	@TESTFCB+CRN,@ACTUAL
	LI	R0,E_SKCRN
	MOV	R0,@FAIL_ID
	B	@RS_FAIL

RS_PASS:
	CALL	@CLOSE_FILE
	CALL	@DELETE_FILE
	LI	R0,SEEK_OK_MSG
	CALL	@PRINTMSG
	CLR	R1
	RET

RS_FAIL:
	CALL	@CLOSE_FILE
	CALL	@DELETE_FILE
	LI	R0,SEEK_FAIL_MSG
	CALL	@PRINTMSG
	SETO	R1
	RET

SEEK_PLANT:
	MOV	@SEEK_TARGET,R0
	MOV	R0,@TESTFCB+CRN
	CLR	@TESTFCB+CBN
	RET

SEEK_RDSEQ:
	LI	R2,RDSEQ
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	SR_READ_FAIL
	CALL	@VERIFY_BUFFER
	MOV	R1,R1
	JLT	SR_DATA_FAIL
	CLR	R1
	RET

SR_READ_FAIL:
	LI	R0,E_SKREAD
	MOV	R0,@FAIL_ID
	SETO	R1
	RET

SR_DATA_FAIL:
	LI	R0,E_SKDATA
	MOV	R0,@FAIL_ID
	MOV	@CUR_REC,@EXPECTED
	SETO	R1
	RET

SEEK_TARGET:	WORD	0
SEEK_GOT:	WORD	0

RUN_RANDOM:
	LI	R0,RANDRECS
	MOV	R0,@TARGET_RECS
	CLR	@FULFLG
	CLR	@FAIL_ID
	CLR	@LAST_STATUS
	CLR	@BAD_OFFSET
	CLR	@EXPECTED
	CLR	@ACTUAL

	LI	R0,RND_BEGIN_MSG
	CALL	@PRINTMSG
	CALL	@CREATE_FILE
	MOV	R1,R1
	JEQ	RR_CONT1
	B	@RR_FAIL
RR_CONT1:
	CALL	@WRITE_FILE
	MOV	R1,R1
	JEQ	RR_CONT2
	B	@RR_FAIL
RR_CONT2:
	CALL	@CLOSE_FILE
	MOV	R1,R1
	JEQ	RR_CONT3
	B	@RR_FAIL
RR_CONT3:
	CALL	@OPEN_FILE
	MOV	R1,R1
	JEQ	RR_CONT4
	B	@RR_FAIL
RR_CONT4:

	LI	R0,RANDRECS
	MOV	R0,@RAND_SIZE
	LI	R0,RANDCUR
	MOV	R0,@RAND_CURSOR
	MOV	R0,@TESTFCB+CRN
	CLR	@TESTFCB+CBN
	CALL	@RND_ACT_TEST
	MOV	R1,R1
	JEQ	RR_CONT5
	B	@RR_FAIL
RR_CONT5:
	CALL	@CLOSE_FILE
	MOV	R1,R1
	JEQ	RR_CONT6
	B	@RR_FAIL
RR_CONT6:

	LI	R0,RANDRECS+1
	MOV	R0,@TARGET_RECS
	CALL	@OPEN_FILE
	MOV	R1,R1
	JEQ	RR_CONT7
	B	@RR_FAIL
RR_CONT7:

	LI	R0,RANDRECS+1
	MOV	R0,@RAND_SIZE
	LI	R0,RANDCUR
	MOV	R0,@RAND_CURSOR
	MOV	R0,@TESTFCB+CRN
	CLR	@TESTFCB+CBN
	CALL	@RND_REOP_TEST
	MOV	R1,R1
	JEQ	RR_CONT8
	B	@RR_FAIL
RR_CONT8:
	CALL	@CLOSE_FILE
	MOV	R1,R1
	JEQ	RR_CONT9
	B	@RR_FAIL
RR_CONT9:
	CALL	@DELETE_FILE
	MOV	R1,R1
	JEQ	RR_CONT10
	B	@RR_FAIL
RR_CONT10:

	LI	R0,RANDOM_OK_MSG
	CALL	@PRINTMSG
	LI	R0,PASS_MSG
	CALL	@PRINTMSG
	CLR	R1
	RET

RR_FAIL:
	CALL	@PRINT_FAILURE
	SETO	R1
	RET

;-----------------------------------------------------------------------
; RND_ACT_TEST
;-----------------------------------------------------------------------
RND_ACT_TEST:
	SETO	@TESTFCB+RELB
	CLR	@TESTFCB+RELR
	LI	R2,SETREL
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	@TESTFCB+RELB,R0
	JEQ	RAT_SETREL_OK1
	B	@RAT_SETREL_FAIL
RAT_SETREL_OK1:
	MOV	@RAND_CURSOR,R0
	C	R0,@TESTFCB+RELR
	JEQ	RAT_SETREL_OK2
	B	@RAT_SETREL_FAIL
RAT_SETREL_OK2:

	SETO	@TESTFCB+RELB
	CLR	@TESTFCB+RELR
	LI	R2,GETSIZ
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	RAT_GETSIZ_BAD1
	JMP	RAT_GETSIZ_OK1
RAT_GETSIZ_BAD1:
	B	@RAT_GETSIZ_FAIL
RAT_GETSIZ_OK1:
	MOV	@TESTFCB+RELB,R0
	JEQ	RAT_GETSIZ_OK2
	B	@RAT_GETSIZ_FAIL
RAT_GETSIZ_OK2:
	MOV	@RAND_SIZE,R0
	C	R0,@TESTFCB+RELR
	JEQ	RAT_GETSIZ_OK3
	B	@RAT_GETSIZ_FAIL
RAT_GETSIZ_OK3:
	CALL	@CHECK_RND_STATE
	MOV	R1,R1
	JEQ	RAT_CONT1
	RET
RAT_CONT1:

	CLR	R0
	CLR	R1
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT2
	RET
RAT_CONT2:
	LI	R0,3
	LI	R1,3
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT3
	RET
RAT_CONT3:
	LI	R0,4
	LI	R1,4
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT4
	RET
RAT_CONT4:
	LI	R0,7
	LI	R1,7
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT5
	RET
RAT_CONT5:
	LI	R0,8
	LI	R1,8
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT6
	RET
RAT_CONT6:
	LI	R0,11
	LI	R1,11
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT7
	RET
RAT_CONT7:

	MOV	@RAND_SIZE,R0
	MOV	R0,@RAND_TARGET
	CLR	@TESTFCB+RELB
	MOV	R0,@TESTFCB+RELR
	LI	R2,RDRND
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	RAT_EOF_STATE
	LI	R0,E_REOF
	MOV	R0,@FAIL_ID
	MOV	@RAND_TARGET,@CUR_REC
	SETO	R1
	RET
RAT_EOF_STATE:
	CALL	@CHECK_RND_STATE
	MOV	R1,R1
	JEQ	RAT_CONT8
	RET
RAT_CONT8:

	CLR	@RAND_TARGET
	LI	R0,1
	MOV	R0,@TESTFCB+RELB
	CLR	@TESTFCB+RELR
	LI	R2,RDRND
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	RAT_RELB_STATE
	LI	R0,E_RRELB
	MOV	R0,@FAIL_ID
	CLR	@CUR_REC
	SETO	R1
	RET
RAT_RELB_STATE:
	CLR	@TESTFCB+RELB
	CALL	@CHECK_RND_STATE
	MOV	R1,R1
	JEQ	RAT_CONT9
	RET
RAT_CONT9:

	LI	R0,4
	MOV	R0,@RAND_TARGET
	LI	R0,ALTPAT
	MOV	R0,@CUR_REC
	CALL	@FILL_BUFFER
	CLR	@TESTFCB+RELB
	LI	R0,4
	MOV	R0,@TESTFCB+RELR
	LI	R2,WRRND
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JEQ	RAT_WRITE_OK1
	B	@RAT_WRITE_FAIL
RAT_WRITE_OK1:
	CALL	@CHECK_RND_STATE
	MOV	R1,R1
	JEQ	RAT_CONT10
	RET
RAT_CONT10:

	LI	R0,3
	LI	R1,3
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT11
	RET
RAT_CONT11:
	LI	R0,4
	LI	R1,ALTPAT
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT12
	RET
RAT_CONT12:
	LI	R0,5
	LI	R1,5
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT13
	RET
RAT_CONT13:

	LI	R0,RANDRECS
	MOV	R0,@RAND_TARGET
	MOV	R0,@CUR_REC
	CALL	@FILL_BUFFER
	CLR	@TESTFCB+RELB
	MOV	@RAND_TARGET,@TESTFCB+RELR
	LI	R2,WRRND
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JEQ	RAT_WRITE_OK2
	B	@RAT_WRITE_FAIL
RAT_WRITE_OK2:
	INC	@RAND_SIZE
	CALL	@CHECK_RND_STATE
	MOV	R1,R1
	JEQ	RAT_CONT14
	RET
RAT_CONT14:
	LI	R0,RANDRECS
	LI	R1,RANDRECS
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RAT_CONT15
	RET
RAT_CONT15:

	MOV	@RAND_SIZE,R0
	INC	R0
	MOV	R0,@RAND_TARGET
	MOV	R0,@CUR_REC
	CALL	@FILL_BUFFER
	CLR	@TESTFCB+RELB
	MOV	@RAND_TARGET,@TESTFCB+RELR
	LI	R2,WRRND
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	RAT_SP_STATE
	LI	R0,E_RSPARSE
	MOV	R0,@FAIL_ID
	MOV	@RAND_TARGET,@CUR_REC
	SETO	R1
	RET
RAT_SP_STATE:
	CALL	@CHECK_RND_STATE
	MOV	R1,R1
	JEQ	RAT_CONT16
	RET
RAT_CONT16:

	LI	R0,RND_ACT_OK_MSG
	CALL	@PRINTMSG
	CLR	R1
RAT_RET:
	RET

RAT_SETREL_FAIL:
	LI	R0,E_RSETREL
	MOV	R0,@FAIL_ID
	MOV	@RAND_CURSOR,@EXPECTED
	MOV	@TESTFCB+RELR,@ACTUAL
	MOV	@RAND_CURSOR,@CUR_REC
	SETO	R1
	RET
RAT_GETSIZ_FAIL:
	LI	R0,E_RGETSIZ
	MOV	R0,@FAIL_ID
	MOV	@RAND_SIZE,@EXPECTED
	MOV	@TESTFCB+RELR,@ACTUAL
	MOV	@RAND_SIZE,@CUR_REC
	SETO	R1
	RET
RAT_WRITE_FAIL:
	LI	R0,E_RWRITE
	MOV	R0,@FAIL_ID
	MOV	@RAND_TARGET,@CUR_REC
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; RND_REOP_TEST
;-----------------------------------------------------------------------
RND_REOP_TEST:
	LI	R0,3
	LI	R1,3
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RROT_CONT1
	RET
RROT_CONT1:
	LI	R0,4
	LI	R1,ALTPAT
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RROT_CONT2
	RET
RROT_CONT2:
	LI	R0,5
	LI	R1,5
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RROT_CONT3
	RET
RROT_CONT3:
	LI	R0,RANDRECS
	LI	R1,RANDRECS
	CALL	@RAND_READ_CHECK
	MOV	R1,R1
	JEQ	RROT_CONT4
	RET
RROT_CONT4:

	SETO	@TESTFCB+RELB
	CLR	@TESTFCB+RELR
	LI	R2,GETSIZ
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	RROT_GSZ_FAIL
	MOV	@TESTFCB+RELB,R0
	JNE	RROT_GSZ_FAIL
	MOV	@RAND_SIZE,R0
	C	R0,@TESTFCB+RELR
	JNE	RROT_GSZ_FAIL
	CALL	@CHECK_RND_STATE
	MOV	R1,R1
	JEQ	RROT_CONT5
	RET
RROT_CONT5:

	MOV	@RAND_SIZE,R0
	MOV	R0,@RAND_TARGET
	CLR	@TESTFCB+RELB
	MOV	R0,@TESTFCB+RELR
	LI	R2,RDRND
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	RROT_EOF_STATE
	LI	R0,E_REOF
	MOV	R0,@FAIL_ID
	MOV	@RAND_TARGET,@CUR_REC
	SETO	R1
	RET
RROT_EOF_STATE:
	CALL	@CHECK_RND_STATE
	MOV	R1,R1
	JEQ	RROT_CONT6
	RET
RROT_CONT6:

	LI	R0,RND_RO_OK_MSG
	CALL	@PRINTMSG
	CLR	R1
RROT_RET:
	RET
RROT_GSZ_FAIL:
	LI	R0,E_RGETSIZ
	MOV	R0,@FAIL_ID
	MOV	@RAND_SIZE,@EXPECTED
	MOV	@TESTFCB+RELR,@ACTUAL
	MOV	@RAND_SIZE,@CUR_REC
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; RAND_READ_CHECK
;-----------------------------------------------------------------------
RAND_READ_CHECK:
	MOV	R0,@RAND_TARGET
	MOV	R1,@CUR_REC
	CLR	@TESTFCB+RELB
	MOV	R0,@TESTFCB+RELR
	LI	R2,RDRND
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	RRC_READ_FAIL
	CALL	@CHECK_RND_STATE
	MOV	R1,R1
	JEQ	RRC_STATE_OK
	RET
RRC_STATE_OK:
	CALL	@VERIFY_BUFFER
	MOV	R1,R1
	JLT	RRC_DATA_FAIL
	CLR	R1
RRC_RET:
	RET
RRC_READ_FAIL:
	LI	R0,E_RREAD
	MOV	R0,@FAIL_ID
	MOV	@RAND_TARGET,@CUR_REC
	SETO	R1
	RET
RRC_DATA_FAIL:
	LI	R0,E_RDATA
	MOV	R0,@FAIL_ID
	MOV	@RAND_TARGET,@CUR_REC
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; CHECK_RND_STATE
;-----------------------------------------------------------------------
CHECK_RND_STATE:
	MOV	@RAND_CURSOR,R0
	C	R0,@TESTFCB+CRN
	JNE	CRS_CURSOR_FAIL
	MOV	@RAND_SIZE,R0
	C	R0,@TESTFCB+FSZ
	JNE	CRS_SIZE_FAIL
	CLR	R1
	RET
CRS_CURSOR_FAIL:
	LI	R0,E_RCURSOR
	MOV	R0,@FAIL_ID
	MOV	@RAND_CURSOR,@EXPECTED
	MOV	@TESTFCB+CRN,@ACTUAL
	MOV	@RAND_TARGET,@CUR_REC
	SETO	R1
	RET
CRS_SIZE_FAIL:
	LI	R0,E_RSIZE
	MOV	R0,@FAIL_ID
	MOV	@RAND_SIZE,@EXPECTED
	MOV	@TESTFCB+FSZ,@ACTUAL
	MOV	@RAND_TARGET,@CUR_REC
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; CREATE_FILE
;-----------------------------------------------------------------------
CREATE_FILE:
	CALL	@INIT_FCB
	LI	R2,ERAFIL
	LI	R3,TESTFCB
	CALL	@BDOS

	CALL	@INIT_FCB
	LI	R2,MAKFIL
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	CF_MAKE_FAIL

	MOV	@TESTFCB+FSB,R0
	CI	R0,FIRSTBLK
	JL	CF_FSB_FAIL
	CI	R0,MAXBLK
	JH	CF_FSB_FAIL

	CALL	@SET_TEST_DMA
	CLR	R1
	RET

CF_MAKE_FAIL:
	LI	R0,E_MAKE
	MOV	R0,@FAIL_ID
	SETO	R1
	RET
CF_FSB_FAIL:
	LI	R0,E_FSB
	MOV	R0,@FAIL_ID
	MOV	@TESTFCB+FSB,@ACTUAL
	LI	R0,FIRSTBLK
	MOV	R0,@EXPECTED
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; WRITE_FILE
;-----------------------------------------------------------------------
WRITE_FILE:
	CLR	@CUR_REC

WF_LOOP:
	MOV	@CUR_REC,R0
	C	R0,@TARGET_RECS
	JEQ	WF_DONE

	CALL	@FILL_BUFFER
	LI	R2,WRSEQ
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	WF_WRITE_ERROR

	MOV	@CUR_REC,R0
	INC	R0
	C	R0,@TESTFCB+CRN
	JNE	WF_FCB_FAIL
	C	R0,@TESTFCB+FSZ
	JNE	WF_FCB_FAIL

	MOV	R0,@CUR_REC
	CALL	@PROGRESS
	JMP	WF_LOOP

WF_DONE:
	MOV	@FULFLG,R0
	JEQ	WF_OK

	CALL	@FILL_BUFFER
	LI	R2,WRSEQ
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	WF_FULL_STATE

	LI	R0,E_FULL
	MOV	R0,@FAIL_ID
	SETO	R1
	RET

WF_FULL_STATE:
	MOV	@TARGET_RECS,R0
	C	R0,@TESTFCB+CRN
	JNE	WF_FSTATE_FAIL
	C	R0,@TESTFCB+FSZ
	JNE	WF_FSTATE_FAIL

WF_OK:
	LI	R0,WRITE_OK_MSG
	CALL	@PRINTMSG
	CLR	R1
	RET

WF_WRITE_ERROR:
	MOV	@FULFLG,R0
	JEQ	WF_WRITE_FAIL
	MOV	@CUR_REC,R0
	JEQ	WF_WRITE_FAIL
	MOV	R0,R1
	ANDI	R1,0003H
	JNE	WF_WRITE_FAIL
	MOV	R0,@TARGET_RECS
	C	R0,@TESTFCB+CRN
	JNE	WF_FSTATE_FAIL
	C	R0,@TESTFCB+FSZ
	JNE	WF_FSTATE_FAIL
	LI	R0,CAPACITY_MSG
	CALL	@PRINTMSG
	WHEX	@TARGET_RECS
	LI	R0,RECORDS_MSG
	CALL	@PRINTMSG
	JMP	WF_OK

WF_WRITE_FAIL:
	LI	R0,E_WRITE
	MOV	R0,@FAIL_ID
	SETO	R1
	RET

WF_FCB_FAIL:
	LI	R0,E_WFCB
	MOV	R0,@FAIL_ID
	MOV	@CUR_REC,R0
	INC	R0
	MOV	R0,@EXPECTED
	MOV	@TESTFCB+CRN,@ACTUAL
	SETO	R1
	RET

WF_FSTATE_FAIL:
	LI	R0,E_FSTATE
	MOV	R0,@FAIL_ID
	MOV	@TARGET_RECS,@EXPECTED
	MOV	@TESTFCB+FSZ,@ACTUAL
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; CLOSE_FILE
;-----------------------------------------------------------------------
CLOSE_FILE:
	LI	R2,FCLOSE
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	CL_FAIL
	CLR	R1
	RET
CL_FAIL:
	LI	R0,E_CLOSE
	MOV	R0,@FAIL_ID
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; OPEN_FILE
;-----------------------------------------------------------------------
OPEN_FILE:
	CALL	@INIT_FCB
	LI	R2,OPEN
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	OF_OPEN_FAIL

	MOV	@TARGET_RECS,R0
	C	R0,@TESTFCB+FSZ
	JNE	OF_SIZE_FAIL
	MOV	@TESTFCB+CRN,R0
	JNE	OF_SIZE_FAIL
	CALL	@SET_TEST_DMA
	CLR	R1
	RET

OF_OPEN_FAIL:
	LI	R0,E_OPEN
	MOV	R0,@FAIL_ID
	SETO	R1
	RET
OF_SIZE_FAIL:
	LI	R0,E_SIZE
	MOV	R0,@FAIL_ID
	MOV	@TARGET_RECS,@EXPECTED
	MOV	@TESTFCB+FSZ,@ACTUAL
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; READ_FILE
;-----------------------------------------------------------------------
READ_FILE:
	CLR	@CUR_REC

RF_LOOP:
	MOV	@CUR_REC,R0
	C	R0,@TARGET_RECS
	JEQ	RF_EOF_TEST

	LI	R2,RDSEQ
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	RF_READ_FAIL
	CALL	@VERIFY_BUFFER
	MOV	R1,R1
	JLT	RF_DATA_FAIL
	INC	@CUR_REC
	CALL	@PROGRESS
	JMP	RF_LOOP

RF_EOF_TEST:
	LI	R2,RDSEQ
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	RF_OK
	LI	R0,E_EOF
	MOV	R0,@FAIL_ID
	SETO	R1
	RET

RF_OK:
	LI	R0,READ_OK_MSG
	CALL	@PRINTMSG
	CLR	R1
	RET

RF_READ_FAIL:
	LI	R0,E_READ
	MOV	R0,@FAIL_ID
	SETO	R1
	RET

RF_DATA_FAIL:
	LI	R0,E_DATA
	MOV	R0,@FAIL_ID
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; DELETE_FILE
;-----------------------------------------------------------------------
DELETE_FILE:
	CALL	@INIT_FCB
	LI	R2,ERAFIL
	LI	R3,TESTFCB
	CALL	@BDOS
	MOV	R1,@LAST_STATUS
	MOV	R1,R1
	JLT	DF_FAIL
	LI	R0,DELETE_OK_MSG
	CALL	@PRINTMSG
	CLR	R1
	RET
DF_FAIL:
	LI	R0,E_ERASE
	MOV	R0,@FAIL_ID
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; INIT_FCB
;-----------------------------------------------------------------------
INIT_FCB:
	LI	R0,FCBSIZ/2
	LI	R1,TESTFCB
IF_ZERO:
	CLR	*R1+
	DEC	R0
	JNE	IF_ZERO
	LI	R0,11
	LI	R1,TEST_NAME
	LI	R2,TESTFCB
IF_NAME:
	MOVB	*R1+,*R2+
	DEC	R0
	JNE	IF_NAME
	RET
;
;-----------------------------------------------------------------------
; SET_TEST_DMA
;-----------------------------------------------------------------------
SET_TEST_DMA:
	LI	R2,SETDMA
	LI	R3,DMABUF
	CALL	@BDOS
	RET
;
;-----------------------------------------------------------------------
; FILL_BUFFER
;-----------------------------------------------------------------------
FILL_BUFFER:
	LI	R0,DMABUF
	LI	R1,MAGIC
	MOV	R1,*R0+
	MOV	@CUR_REC,*R0+
	MOV	@CUR_REC,R1
	INV	R1
	MOV	R1,*R0+
	LI	R2,PATWORDS
	MOV	@CUR_REC,R1
	AI	R1,3
FB_LOOP:
	MOV	R1,*R0+
	INC	R1
	DEC	R2
	JNE	FB_LOOP
	RET
;
;-----------------------------------------------------------------------
; VERIFY_BUFFER
;-----------------------------------------------------------------------
VERIFY_BUFFER:
	LI	R0,DMABUF
	CLR	R3
	LI	R2,MAGIC
	MOV	*R0+,R4
	C	R4,R2
	JNE	VB_FAIL
	INCT	R3
	MOV	@CUR_REC,R2
	MOV	*R0+,R4
	C	R4,R2
	JNE	VB_FAIL
	INCT	R3
	MOV	@CUR_REC,R2
	INV	R2
	MOV	*R0+,R4
	C	R4,R2
	JNE	VB_FAIL
	INCT	R3
	LI	R1,PATWORDS
	MOV	@CUR_REC,R2
	AI	R2,3
VB_LOOP:
	MOV	*R0+,R4
	C	R4,R2
	JNE	VB_FAIL
	INCT	R3
	INC	R2
	DEC	R1
	JNE	VB_LOOP
	CLR	R1
	RET

VB_FAIL:
	MOV	R3,@BAD_OFFSET
	MOV	R2,@EXPECTED
	MOV	R4,@ACTUAL
	SETO	R1
	RET
;
;-----------------------------------------------------------------------
; PROGRESS
;-----------------------------------------------------------------------
PROGRESS:
	MOV	@CUR_REC,R0
	ANDI	R0,003FH
	JNE	PR_RET
	LI	R3,'.'
	CALL	@PUTC
PR_RET:
	RET
;
;-----------------------------------------------------------------------
; PRINT_FAILURE
;-----------------------------------------------------------------------
PRINT_FAILURE:
	MOV	@TESTFCB+FSZ,@FAIL_FSZ
	MOV	@TESTFCB+CRN,@FAIL_CRN
	MOV	@TESTFCB+FSB,@FAIL_FSB

	LI	R0,FAIL_MSG
	CALL	@PRINTMSG
	WHEX	@FAIL_ID
	LI	R0,REC_MSG
	CALL	@PRINTMSG
	WHEX	@CUR_REC
	LI	R0,STATUS_MSG
	CALL	@PRINTMSG
	WHEX	@LAST_STATUS
	LI	R0,FSB_MSG
	CALL	@PRINTMSG
	WHEX	@FAIL_FSB
	LI	R0,FSZ_MSG
	CALL	@PRINTMSG
	WHEX	@FAIL_FSZ
	LI	R0,CRN_MSG
	CALL	@PRINTMSG
	WHEX	@FAIL_CRN
	LI	R0,OFF_MSG
	CALL	@PRINTMSG
	WHEX	@BAD_OFFSET
	LI	R0,EXP_MSG
	CALL	@PRINTMSG
	WHEX	@EXPECTED
	LI	R0,ACT_MSG
	CALL	@PRINTMSG
	WHEX	@ACTUAL
	LI	R0,CRLF_MSG
	CALL	@PRINTMSG
	RET
;
;-----------------------------------------------------------------------
; Console helpers.
;-----------------------------------------------------------------------
PRINTMSG:
	MOVB	*R0+,R3
	JEQ	PM_DONE
	SWPB	R3
	PUSH	R0
	CALL	@PUTC
	POP	R0
	JMP	PRINTMSG
PM_DONE:
	RET

PUTC:
	LI	R2,COUT
	CALL	@BDOS
	RET
;
;-----------------------------------------------------------------------
; Messages and fixed test filename.
;-----------------------------------------------------------------------
BANNER:
	BYTE	0DH,0AH
	TEXT	'BDTEST62 - BDOS 6.0 + 16MB GEOMETRY + DIRECTORY'
	BYTE	0DH,0AH
	TEXT	'DESTRUCTIVE ONLY TO BDTEST.DAT AND TESTDIR'
	BYTE	0DH,0AH,0
	EVEN
MENU_MSG:
	BYTE	0DH,0AH
	TEXT	'S=5 B=505 P=1017 2=2041 F=FULL R=RAND C=CURS D=DIR A=ALL Q=QUIT > '
	BYTE	0
	EVEN
BAD_KEY:
	TEXT	'UNKNOWN OPTION'
	BYTE	0DH,0AH,0
	EVEN
ALL_MSG:
	TEXT	'RUNNING 5, 505, 1017, 2041, RANDOM, CURSOR AND DIR TESTS'
	BYTE	0DH,0AH,0
	EVEN
BEGIN_MSG:
	BYTE	0DH,0AH
	TEXT	'BEGIN RECORDS=>'
	BYTE	0
	EVEN
DIR_BEGIN_MSG:
	BYTE	0DH,0AH
	TEXT	'BEGIN DIRECTORY ISOLATION TEST'
	BYTE	0DH,0AH,0
	EVEN
DIR_OK_MSG:
	TEXT	'DIRECTORY CREATION/ISOLATION TEST PASSED'
	BYTE	0DH,0AH,0
	EVEN
RECORDS_MSG:
	TEXT	' (HEX)'
	BYTE	0DH,0AH,0
	EVEN
CAPACITY_MSG:
	BYTE	0DH,0AH
	TEXT	'DISK FULL AFTER RECORDS=>'
	BYTE	0
	EVEN
RND_BEGIN_MSG:
	BYTE	0DH,0AH
	TEXT	'BEGIN RANDOM ACCESS TEST'
	BYTE	0DH,0AH,0
	EVEN
RND_ACT_OK_MSG:
	TEXT	'RANDOM READ/OVERWRITE/APPEND/REJECT CHECK OK'
	BYTE	0DH,0AH,0
	EVEN
RND_RO_OK_MSG:
	TEXT	'RANDOM CLOSE/REOPEN PERSISTENCE CHECK OK'
	BYTE	0DH,0AH,0
	EVEN
RANDOM_OK_MSG:
	TEXT	'RANDOM ACCESS TEST COMPLETE'
	BYTE	0DH,0AH,0
	EVEN
SEEK_BEGIN_MSG:
	BYTE	0DH,0AH
	TEXT	'BEGIN SEQUENTIAL CURSOR TEST'
	BYTE	0DH,0AH,0
	EVEN
SEEK_OK_MSG:
	BYTE	0DH,0AH
	TEXT	'CURSOR OK - CRN REPOSITIONS A SEQUENTIAL READ'
	BYTE	0DH,0AH,0
	EVEN
SEEK_FAIL_MSG:
	BYTE	0DH,0AH
	TEXT	'CURSOR FAILED - SEE FAIL ID'
	BYTE	0DH,0AH,0
	EVEN
WRITE_OK_MSG:
	BYTE	0DH,0AH
	TEXT	'WRITE/CAPACITY CHECK OK'
	BYTE	0DH,0AH,0
	EVEN
READ_OK_MSG:
	BYTE	0DH,0AH
	TEXT	'READ/PATTERN/EOF CHECK OK'
	BYTE	0DH,0AH,0
	EVEN
DELETE_OK_MSG:
	TEXT	'DELETE/RECLAIM OK'
	BYTE	0DH,0AH,0
	EVEN
PASS_MSG:
	TEXT	'*** TEST PASSED ***'
	BYTE	0DH,0AH,0
	EVEN
FAIL_MSG:
	BYTE	0DH,0AH
	TEXT	'*** TEST FAILED *** CODE=>'
	BYTE	0
	EVEN
REC_MSG:
	TEXT	' REC=>'
	BYTE	0
	EVEN
STATUS_MSG:
	TEXT	' STATUS=>'
	BYTE	0
	EVEN
FSB_MSG:
	TEXT	' FSB=>'
	BYTE	0
	EVEN
FSZ_MSG:
	TEXT	' FSZ=>'
	BYTE	0
	EVEN
CRN_MSG:
	TEXT	' CRN=>'
	BYTE	0
	EVEN
OFF_MSG:
	TEXT	' BYTE-OFF=>'
	BYTE	0
	EVEN
EXP_MSG:
	TEXT	' EXPECT=>'
	BYTE	0
	EVEN
ACT_MSG:
	TEXT	' ACTUAL=>'
	BYTE	0
	EVEN
CRLF_MSG:
	BYTE	0DH,0AH,0
	EVEN
STOP_MSG:
	TEXT	'TEST STOPPED - PRESERVE THE DISK IMAGE BEFORE RETRYING'
	BYTE	0DH,0AH,0
	EVEN
BYE_MSG:
	TEXT	'BDTEST62 EXIT'
	BYTE	0DH,0AH,0
	EVEN
TEST_NAME:
	TEXT	'BDTEST  DAT'
	EVEN
TEST_DIR:
	TEXT	'TESTDIR    '
	EVEN
ROOT_DIR:
	TEXT	'           '		; 11 spaces automatically returns to Root ID 0
	EVEN
;
;-----------------------------------------------------------------------
; Test state and buffers.
;-----------------------------------------------------------------------
ARGPTR:
	WORD	0               ; next command-line option, 0 = interactive
TARGET_RECS:
	WORD	0
FULFLG:
	WORD	0
CUR_REC:
	WORD	0
FAIL_ID:
	WORD	0
LAST_STATUS:
	WORD	0
BAD_OFFSET:
	WORD	0
EXPECTED:
	WORD	0
ACTUAL:
	WORD	0
FAIL_FSB:
	WORD	0
FAIL_FSZ:
	WORD	0
FAIL_CRN:
	WORD	0
RAND_SIZE:
	WORD	0
RAND_CURSOR:
	WORD	0
RAND_TARGET:
	WORD	0

TESTFCB:
	BSS	FCBSIZ
	EVEN
DMABUF:
	BSS	BYTSEC
	EVEN

	END
