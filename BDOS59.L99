                        ;	DURING JULY 1983.
                        
                        ;	18 NOV 2019	BDOS IS CONFIGURED TO SHARE CALLING PROGRAMME WORKSPACE AND STACK
                        ;		THAT IS IT DOES NOT DEFINE ITS OWN STACK
                        ;	25 MAY 2024	NEW VERSION 3 TO INCORPORATE IDE HARD DRIVE - FLOPPY I/F WILL BE REMOVED
                        ;	26 AUGUST 2024	NEW VERSION 4 TO ADD MODULE LOAD CAPABILITY TO ALLOW FOR SEGMENTED MEMORY
                        ;	13 JANUARY 2025 NEW VERSION 4.1 TO ADD LONG CALL INTO BDOS.
                        ;       	01 APRIL 2025   4.6 INCORPORATE INDEPENDANT RDSEC/WRSEC and RDDIR/WRDIR ROUTINES
                        ;	05 APRIL 2025   4.9 WORKING BASELINE
                        ;	04 JUNE 2026    5.4/5 SUPPORTING TRANSPARENT MAPPING
                        ;	19 JULY 2026   5.9 PHASE 1 FILESYSTEM SAFETY REPAIR
                        ;	19 JULY 2026   5.9R2 RANDOM I/O REPAIR; DIRECTORY/MLBUF SEPARATION RESTORED
                        ;-----------------------------------------------------------
                        ;
                        ; DEFINE XOP FUNCTIONS
                        ; THESE XOP ARE DEFINED IN THE MONITOR.
                        ; BECAUSE THE XOP WORKSPACES OVERLAP,
                        ; THEN R0 TO R7 ARE SHARED WHEN A CALL FUNCTION OCCURS.
                        ;
                        ;
                        ;
                        ;
                        ;	DEFINE SOME XOP'S DEFINED IN MONITOR
                        ;
                        	DXOP	PUSHREG,4
                        	DXOP	POPREG,5
                        	DXOP	CALL,6
                        	DXOP	RET,7
                        	DXOP	PUSH,8
                        	DXOP	POP,9
                        	DXOP	WHEX,10		;WRITE OUT A 16 BIT HEX VALUE
                        ;	DXOP	RHEX,11		;READ IN A 16 BIT HEX VALUE
                        ;	DXOP	WRITE,12		;WRITE CHAR IN MSB
                        ;	DXOP	READ,13		;READ CHAR IN MSB
                        ;	DXOP	MESG,14		;OUTPUT NULL TERMINATED MESSAGE
                        	DXOP	DEBUG,15
                        ;
                        ;	REGISTER EQUATES
                        ;
                        
  0000                  R0	EQU	0
  0001                  R1	EQU	1
  0002                  R2	EQU	2
  0003                  R3	EQU	3
  0004                  R4	EQU	4
  0005                  R5	EQU	5
  0006                  R6	EQU	6
  0007                  R7	EQU	7
  0008                  R8	EQU	8
  0009                  R9	EQU	9
  000A                  R10	EQU	10
  000A                  SP	EQU	10
  10FF                  HALT	EQU	10FFH
                        
                        ;
                        ; OPERATING SYSTEM EQUATES
                        ;
  F000                  MONITOR:	EQU	0F000H
                        
  E500                  BDOS:	EQU	0E500H
                        ;
  E500                  	AORG	BDOS
                        ;
                        ; BDOS ENTRY POINT;  BDOS IS CALLED VIA A CALL SO THAT
                        ;
                        ;	WHEX	R2
  E500   0A12           	SLA	R2,1		;ADJUST FOR JUMP
  E502   0282 0050      	CI	R2,2*40		;MAKE SURE IT A LEGAL VALUE
  E506   1B2C           	JH	EXIT	
  E508   C022 E50E      	MOV	@FUN00(R2),R0
  E50C   0450           	B	*R0
                        ;
                        ;	JUMP TABLE - ENTER WITH VALUE IN R3
                        ;
  E50E   E57A           FUN00	WORD	BDOS0			;WARM BOOT		
  E510   E5A0           FUN01	WORD	CIN			;CONSOLE INPUT
  E512   E596           FUN02	WORD	COUT	 		;CONSOLE OUTPUT (OUTPUT LSB OF R3)
  E514   E560           FUN03	WORD	EXIT	
  E516   E560           FUN04	WORD	EXIT	
  E518   E560           FUN05	WORD	EXIT	
  E51A   E5A8           FUN06	WORD	DCONIO			;DIRECT CONSOLE IO		
  E51C   E560           FUN07	WORD	EXIT	 
  E51E   E560           FUN08	WORD	EXIT	
  E520   E560           FUN09	WORD	EXIT	
  E522   E560           FUN10	WORD	EXIT	
  E524   E560           FUN11	WORD	EXIT	
  E526   E560           FUN12	WORD	EXIT	
  E528   E560           FUN13	WORD	EXIT
  E52A   E5B2           FUN14	WORD	DSKFUN			;SELECT A DISK 
  E52C   E5FC           FUN15	WORD	FOPEN	 		;LONG/NEAR-OPEN A FILE
  E52E   E692           FUN16	WORD	FCLOSE	 		;CLOSE A FILE
  E530   E828           FUN17	WORD	SEARCH1	 		;LONG/NEAR LOOK FOR A FILE
  E532   E83C           FUN18	WORD	SEARCH2			;SEARCH NEXT
  E534   E9BC           FUN19	WORD	ERAFIL	 		;ERASE A FILE
  E536   E760           FUN20	WORD	RDSEQ	 		;LONG/NEAR READ SQUENTIAL
  E538   E6D6           FUN21	WORD	WRSEQ	 		;WRITE SQUENTIAL
  E53A   E8A0           FUN22	WORD	MAKFIL	 		;MAKE A FILE
  E53C   E99A           FUN23	WORD	RENAME			;RENAME A FILE	
  E53E   E560           FUN24	WORD	EXIT	
  E540   E5E6           FUN25	WORD	CDFUNC			;RETURN CURRENT DISK
  E542   E5EC           FUN26	WORD	DMAFUN			;LONG/NEAR SET DMA ADDRESS
  E544   E560           FUN27	WORD	EXIT	 		;
  E546   E560           FUN28	WORD	EXIT	 		;
  E548   E560           FUN29	WORD	EXIT	 		;
  E54A   E560           FUN30	WORD	EXIT	 		;
  E54C   E560           FUN31	WORD	EXIT	 		;
  E54E   E560           FUN32	WORD	EXIT	 		;
  E550   E7A4           FUN33	WORD	RDRND	 		;READ A RANDOM RECORD
  E552   E7D6           FUN34	WORD	WRRND	 		;WRITE A RANDOM RECORD
  E554   E84A           FUN35	WORD	GETSIZ			;GET FILE SIZE
  E556   E860           FUN36	WORD	SETREL			;SET RELATIVE RECORD
  E558   E560           FUN37	WORD	EXIT
  E55A   E560           FUN38	WORD	EXIT
  E55C   E560           FUN39	WORD	EXIT
  E55E   E560           FUN40	WORD	EXIT
  E560   0701           EXIT	SETO	R1			;ERROR 
  E562   2DC0           	RET
                        
                        ;
                        ; BIOS EQUATES
                        ;
                        ;
                        ;TEMPORARY TESTING ADDRESS TO MIMIC MONITOR BEING AT LOCATION F000
  0086                  MON_PTR	EQU	086H			;LOW MEMORY POINTER TO MONITOR
                        ;
                        ;	BIOS VECTORS ARRANGED AS N*L WHERE
                        ;
                        ;	N IS THE NTH VECTOR IN THE MONITOR, AND
                        ;	L IS THE NUMBER OF BYTES PER VECTOR
                        ;
                        ;	WHEN CALLING MRDREC, MWRREC ETC IT IS NECESSARY TO CALL USING
                        ;	LBA VALUES, NOT SECTORS.
                        ;
  F00C                  MCONIN	EQU	MONITOR+3*4	;CONSOLE IN
  F010                  MCONOUT	EQU	MONITOR+4*4	;CONSOLE OUT
  F014                  MSELDSK	EQU	MONITOR+5*4	;SET CURRENT LOGGED DRIVE
  F018                  MRECAL	EQU	MONITOR+6*4
  F01C                  MSEEK	EQU	MONITOR+7*4
  F028                  MRDID	EQU	MONITOR+10*4
  F02C                  MWBOOT	EQU	MONITOR+11*4	;WARM BOOT
                        ;
                        ; NOTE THAT THESE CALLS ARE REASONABLY COMPLEX AND EXECUTE IN ANOTHER WORKSPACE, SO NO CONSIDERATION
                        ; TO PRESERVING CALLING PROCEDURE REGISTERS IS NECESSARY
                        ;
  F020                  MRDREC	EQU	MONITOR+8*4	;READ A STANDARD RECOR0D
  F024                  MWRREC	EQU	MONITOR+9*4	;WRITE A STANDARD RECORD
  F038                  MRDDBR	EQU	MONITOR+14*4	;READ A STANDARD DIRECTORY/BAT RECORD
  F03C                  MWRDBR	EQU	MONITOR+15*4	;WRITE A STANDARD DIRECTORY RECORD
                        
                        ;
                        ;************************************************************************************************************
                        ;
                        ;	FCB EQUATES
                        ;
                        ;	THE FCB CONSISTS OF 36 BYTES OF DATA:
                        ;	ONLY BYTES 0 TO 31 ARE AN EXACT COPY OF THE DIRECTORY ENTRY
                        ;
                        ;	   
                        ;	   BYTES	FUNCTION
                        ;	   -----        --------
                        ;	   0 -7	FILENAME
                        ;	   8 -10 	FILENAME EXTENSION
                        ;	   11	FTY  - FILE TYPE
                        ;	   12-13	FSB  - FILE'S STARTING BLOCK
                        ;	   14-15 	FSZ  - FILE SIZE IN RECORDS (A RECORD IS EQUIVALENT TO A SECTOR)
                        ;	   16-17 	FLA  - FILE LOAD ADDRESS - USED TO DETERMINE WHERE FILE WILL LOAD
                        ;	   18-19	SPARE
                        ;	   20-21	LRBL - THIS LAST RECORD BYTE LENGTH OR NUMBER OF BYTES IN THE LAST RECORD
                        ;		SO ACTUAL FILE SIZE IN BYTES IS 512*(FSZ - 1) +  LRBL)
                        ;	   22-23 	SPARE
                        ;	   24-25	CBN  - FILE'S CURRENT BLOCK NUMBER (extent in cp/m)
                        ;	   26-27	CRN  - CURRENT RECORD NUMBER - DATA BEGINS AT CRN=1.  CRN=O is the MODULE LOAD TABLE
                        ;	   28-29	RELB - RELATIVE BLOCK NUMBER - USED FOR RANDOM ACCESS
                        ;	   30-31 	RELR - RELATIVE RECORD NUMBER THAT WILL BE LOADED.
                        ;
                        ;	-----------------32 to 36 ARE TRANSIENT VALLUES AND NOT IN THE DIRECTORY------------------
                        ;	   .
                        ;	   32	CMLTI - THIS IS THE CURRENT MODULE LOAD INDEX.  JUST ONE BYTE I.E UP TO 256 MODULES
                        ;	   33	NMSECT - MODULE SIZE IN SECTORS. THIS IS THE NUMBER OF RECORDS IN THE PARTICULAR MODULE;
                        ;		WHICH IN POINTED TO MY CMLTI
                        ;	   34	MEMORY PAGE TO LOAD
                        ;	   34 	DRIVE
                        ;	   35 	LBUFCNT - NUMBER BYTES IN LAST BUFFER.  ALLOWS TO MANAGE BINARY FILES SO CPMEOF IS NOT NEEDED
                        ;
                        ;	THE LBA VALUES SEQUENTIALLY GO FROM 0, 2, 4 ETC BECAUSE WE ARE READING BYTES BACK FROM THE DRIVE
                        ;	RATHER THAN 16 BITS , SO TWO 256 READS (2 LBAs) WILL EQUAL 512 BYTES WHICH IS THE NOMINAL BYTES PER SECTOR
                        ;	DISC STRUCTURE.  EACH SECTOR READ WILL READ IN 2 LBA SECTORS
                        ;	[LBA0][LBA2][LBA4][LBA6][LBA8][LBA10][LBA12][LBA14]<-------FILES BEGIN AT BLOCK 2
                        ;	[BOOT][BAT1][BAT2][BAT3][DIR1][DIR2 ][DIR3 ][DIR4 ][REC1BLK2,REC2BLK2,RECS3BLK2,REC4BLK2][REC1BLCK3...ETC]
                        ;	<-------BLOCK 0--------><--------BLOCK 1----------><-----------BLOCK 2------------------>
                        ;
                        ;	EACH BLOCK IS 4 SECTORS OR or 4 x 512 = 2048 Bytes - we can call see the similarity of blocks to pages
                        ;
                        ;	BLOCK ALLOCATION TABLE [BAT] SECTORS ARE INITIALISED TO 0, THUS AVAILABLE BLOCKS ARE INDICATED BY THE VALUE OF 0000H.
                        ;	WITH THE LAST AVAILABLE BLOCK BEING SET TO -1 IN THE LAST BAT PAGE.
                        ;	ALLOCATED BLOCKS HAVE A NON ZERO BLOCK NUMBER POINTING TO THE NEXT BLOCK IN THE LINK AND THE FINAL BLOCK
                        ;	IN THE LINK INDICATED BY A BLOCK NUMBER VALUE OF FF80H WHICH IS A SIMPLE INVERSION OF THE FIRST 9 BITS
                        ;	WHICH ARE UNUSED.
                        ;
                        ;	FOR EXAMPLE, BAT 1 WOULD LOOK LIKE THIS
                        ;
                        ;	BAT 1
                        ;	BLOCK NUMBER	VALUE	COMMENT
                        ;
                        ;	[ 0	FF80   ]	BOOT SECTOR, PLUS BATs OCCUPY A SINGLE BLOCK (BLOCK 0)
                        ;	[ 1	FF80   ]	DIRECTORY SECTORS OCCUPY A SINGLE BLOCK (BLOCK 1)
                        ;	[ 2	0003   ]	POINTS TO NEXT BLOCK IN LINK.  FILE IS SHELL.SYS (2 BLOCKS IN SIZE)
                        ;	[ 3	FF80   ]	LAST BLOCK IN THE FILE
                        ;	[ 4	0005   ]	POINTS TO NEXT BLOCK IN LINK.  FILE IS BDOS.SYS (2 BLOCKS IN SIZE)
                        ;	[ 5	FF80   ]	LAST BLOCK IN THE LINK
                        ;	[ 6	0007   ]	TEST FILE 3 BLOCKS LONG
                        ;	[ 7	0008   ]	2ND BLOCK
                        ;	[ 8	FF80   ]	LAST BLOCK IN FILE
                        ;	[ 9	0000   ]
                        ;	[ 9	0000   ]
                        ;		ETC
                        ;
                        ;	FOR THIS REASON THE FCB MUST CONTAIN THE FILE STARTING BLOCK (FSB) SO THE START  OF THE LINK
                        ; 	CAN BE FOUND.
                        ;
                        ;	BAT SECTORS ARE ORGANSIED AS FOLLOWS:
                        ;
                        ;	BAT SECTOR 1[BLK0,BLK1,BLK2,BLK3.......BLK255]
                        ;	BAT SECTOR 2[BLK256,BLK257,BLK258,.....BLK511]
                        ;	BAT SECTOR 2[BLK512,BLK513,BLK514..... BLK719,-1]
                        ;
                        ;
                        ;	NOTE:  CPM/BDOS OPERATES AT THE RECORD LEVEL SO THE TASK OF TDOS IS TO BE ABLE TO
                        ;	MAP BETWEEN FILE RECORDS LOCATION WITHIN A BLOCK ON THE DISC TRACK AND SECTOR NUMBER
                        ;
                        ;	BAT SECTORS ARE ORGANSISED AS 3 BAT PAGES/SECTOR
                        ;	[PAGE3][PAGE2][PAGE1][ 0 0 0 0 0 0 0 0].
                        ;	SO THE LSB 8 BITS REPRESENT THE ACTUAL BLOCK NUMBER AND THE NEXT 3 BITS THE BAT PAGE NUMBERS
                        ;	BAT 0 = 000, BAT 1 = 001, BAT 2 = 010 AND BAT 3 = 011.
                        ;
                        ;	SO SHIFTING THE BLOCK NUMBER BY 8  SHIFT COUNT AND APPLYING THE MASK 00FFH YIELDS THE PAGE NUMBER
                        ;	TO WHICH THE BLOCK NUMBER BELONGS.
                        ;
                        ;**********************************************************************************************************************
                        ;
  0000                  NAM	EQU	0	
  000B                  FTY	EQU	11		;TYPE 
  0010                  FLA	EQU	16		;FILES LOAD ADDRESS
  001A                  CRN	EQU	26	 	;NEXT RECORD TO READ/WRITE 
  0018                  CBN	EQU	24	 	;CURRENT BLOCK NUMBER
  001C                  RELB	EQU	28		;RANDOM ACCESS RELATIVE BLOCK NUMBER
  001E                  RELR	EQU	30		;RELATIVE RECORD NUMBER
  000C                  FSB	EQU	12		;FILE STARTING BLOCK
  000E                  FSZ	EQU	14		;FILE SIZE IN SECTORS
  0014                  LRBL	EQU	20		;NUMBER OF BYTES IN THE LAST RECORD
  0020                  CMLTI	EQU	32		;CURRENT MLINDEX - 0 REFERS TO MAIN MODULE
  0021                  NMSECT	EQU	33		;NUMBER OF SECTORS/RECORDS IN THE PARTICULAR MODULE
  0022                  MPAGE	EQU	34
                        ;
                        ; MEDIA TYPE 00FDH FLOPPY DISC HAS BEEN DEPRECATED
                        ;
                        ;TRKDSK	EQU	80		;TRACKS PER DISK
  0012                  SECTRK	EQU	18		;SECTORS PER TRACK
  0200                  BYTSEC	EQU	512		;BYTES PER SECTOR
  0004                  SECBLK	EQU	4		;SECTOR PER BLOCK THIS MEANS THERE ARE 2 BAT SECTORS
                        				; 80*18*2/SECBLK = 720 IE 2*512 SECTORS REQUIRED
  0001                  LBASECT	EQU	1		;NUMBER OF LBAS PER SECTOR (DUE TO 256 BYTE READS)
  0001                  RSVDSEC	EQU	1		;RESERVED SECTORS FOR BOOT SECTOR
  0002                  NSIDES	EQU	2		;NUMBER OF SIDES
                        ;SECDSK	EQU	NSIDES*SECTRK*TRKDSK	;SECTORS ON DISK
  0001                  NBATS	EQU	1		;NO OF BAT ENTRIES ie backup etc
  0004                  NDSECT	EQU	4		;NO OF DIRECTORY SECTORS PER DISK
  0002                  FBATSEC 	EQU	RSVDSEC+1		;FIRST BAT SECTOR  OFFSET FROM 0
  0004                  FDIRRN	EQU	4		;FIRST DIRECTORY RECORD NUMBER ()
  0000                  DIRTRK	EQU	0		;DIRECTORY STARTS HERE
  0000                  BATTRK	EQU	0
  0008                  BATSF	EQU	8		;DETERMINES THE BAT PAGE (SEE EXPLANATION ABOVE)
                        ;BATMSK	EQU	01FFH		;BASED ON BYTSEC/2 ENTRIES PER BAT PAGE - USED IN GETBATP
                        ;BATMSK SHOULD BE 00FF
  00FF                  BATMSK	EQU	0FFH		;BASED ON BYTSEC/2 ENTRIES PER BAT PAGE - USED IN GETBATP
  FF80                  LASTBLK	EQU	0FF80H		;INDICATES LAST BLOCK IN A FILE
  0002                  FIRSTBLK	EQU	2		;BLOCKS 0 AND 1 ARE RESERVED
  02CF                  MAXBLK	EQU	719		;FINAL PHYSICAL BLOCK (BAT[720] IS THE -1 SENTINEL)
  02CE                  NDATABLK	EQU	MAXBLK-FIRSTBLK+1	;718 ALLOCATABLE BLOCKS
  0002                  LASTBAT	EQU	2		;VALID BAT PAGES ARE 0, 1 AND 2
  0200                  BUFSIZ	EQU	BYTSEC		;DISK BUFFER SIZE
                        ;
  000B                  NAMSIZ	EQU	11		;FILENAME SIZE IN BYTES
  0003                  EXTSIZ	EQU	3
  0012                  NAMEOFF2	EQU	18		;2ND NAME OFFSET INTO FCB
  0020                  DIRSIZ	EQU	32		;NO. OF BYTES PER ENTRY
  0001                  RDCMD	EQU	1	 	;READ COMMAND
  0002                  WRCMD	EQU	2	 	;WRITE COMMAND
                        
  FFFF                  MINUS1	EQU	-1		;USED FOR GENERAL ERROR
  E564   3F             WILD	BYTE	'?'
  E565   FF             ALLONES	BYTE	-1		;;USED FOR GENERAL ERROR
  E566                  	EVEN
                        ;
  E566   0000           DISK	WORD	0		;CURRENTLY SELECTED DISK LS BYTE USED
  E568   0000           CAB	WORD	0	 	;CURRENTLY ALLOCATED BLOCK NUMBER
  E56A   0000           CBP   	WORD	0		;CURRENT BAT LOCATION POINTER
  E56C   0000           CBO	WORD	0		;CURRENT OFFSET INTO BLOCK
  E56E   FFFF           CBSECT	WORD	-1		;CURRENT BAT SECTOR IN MEMORY
  E570   0000           DIRENT	WORD	0		;USED IN DIRECTORY SEARCH
  E572   EE7E           WRADDR	WORD	DIRBUFF		;CALLER DMA ADDRESS (SET BY FUNCTION 26)
  E574   0000           DMAADDR	WORD	0		;ACTIVE DMA ADDRESS FOR MONITOR/INTERNAL I/O
                        ;TRACK	WORD	0
                        ;SECTOR	WORD	0
                        
                        ; LBA + 0 = SECTOR
                        ; LBA + 1 = CYL LSB
                        ; LBA + 2 = CYL MSB
                        ; LBA + 3 = HEAD   (MSB)
                        ;
                        ;LBA	WORD	0,0		;
                        
  E576   0000           CDSECT	WORD	0	 	;CURRENT DIRECTORY SECTOR
  E578   0000           CCMD	WORD	0	 	;CURRENT COMMAND
  E57A                  	EVEN
                        ;
                        ; LBA CONSTANTS
                        ;
  0000                  BOOT_LBA	EQU	0
  0002                  BAT_LBA         EQU	2
  0008                  DIR_LBA         EQU	8
                        ;FINAL_LBA	EQU	16
                        ;BLK2_LBA	EQU	18
                        ;
                        ;LONG DISTANCE COMMANDS
                        ;
                        ;LDS:	EQU	0780H	;        Long Distance Source instruction operand.
                        ;LDD:	EQU	07C0H	;        Long Distance Destination instruction operand.
                        ;LDS	EQU	1000H
                        ;LDD	EQU	1000H
                        ;
                        ;******************************
                        ;
                        ;	WARM BOOT INTERCEPT
                        ;
                        ;*******************************
                        ;
  E57A   C020 EC78      BDOS0	MOV	@BATCHG,R0		;FLUSH A DIRTY BAT BEFORE WARM BOOT
  E57E   1304           	JEQ	BDOS0A
  E580   2DA0 EC2A      	CALL	@WRBAT
  E584   C041           	MOV	R1,R1
  E586   1106           	JLT	BDOS0E			;DO NOT DISCARD DIRTY METADATA ON ERROR
  E588   0720 E56E      BDOS0A	SETO	@CBSECT			;INVALIDATE THE BAT CACHE
  E58C   04E0 E568      	CLR	@CAB
  E590   0460 F02C      	B	@MWBOOT			;CALL MONITOR
  E594   2DC0           BDOS0E	RET
                        ;
                        ;*******************************
                        ;
                        ;	CONSOLE OUTPUT
                        ;	CHAR IN R3 LSB 
                        ;
                        ;********************************
                        ;
                        ;
  E596   06C3           COUT	SWPB	R3			;MOVE CHAR TO UPPER MSB FOR MCONOUT
  E598   D083           	MOVB	R3,R2	 		;CHAR IN MSB OF R2
  E59A   2DA0 F010      	CALL	@MCONOUT
  E59E   2DC0           	RET
                        ;
                        ;********************************
                        ;
                        ;	CONSOLE INPUT INTO LSB OF R1
                        ;	NOTE ALL OTHER SYSTEMS USE MSB
                        ;
                        ;********************************
                        ;
  E5A0   2DA0 F00C      CIN	CALL	@MCONIN		;(R0)			;INPUT CHAR IN R1
  E5A4   06C1           	SWPB	R1
  E5A6   2DC0           	RET				;RETURN CHAR IN MSB OF R1
                        ;
                        ;-----------------------------------
                        ;
                        ;  DIRECT CONSOLE IO - BYPASS ANY CHARACTER
                        ;  CHECKING.
                        ;
                        ;  IF R3 = FF00H THEN INPUT A CHAR
                        ;  IF R3 = IS LESS THAN 00FFH THEN OUTPUT THE CHAR IN MSB
                        ;
                        ;-----------------------------------------------------
                        ;
  E5A8   D020 E565      DCONIO	MOVB	@ALLONES,R0
  E5AC   9003           	CB	R3,R0
  E5AE   13F8           	JEQ	CIN
  E5B0   10F2           	JMP	COUT
                        ;
                        ;*************************
                        ;
                        ;	SELECT A DISK
                        ;
                        ;*************************
                        ;
  E5B2   2E03           DSKFUN	PUSH	R3			;PRESERVE REQUESTED DRIVE ACROSS A BAT FLUSH
  E5B4   C020 EC78      	MOV	@BATCHG,R0
  E5B8   1304           	JEQ	DSKFUN1
  E5BA   2DA0 EC2A      	CALL	@WRBAT
  E5BE   C041           	MOV	R1,R1
  E5C0   1110           	JLT	DSKFUNE			;KEEP CURRENT DRIVE IF METADATA CANNOT BE SAVED
  E5C2   2E43           DSKFUN1	POP	R3
  E5C4   C083           	MOV	R3,R2 	 		;FOR MONITOR
  E5C6   C803 E566      	MOV	R3,@DISK
  E5CA   0720 E56E      	SETO	@CBSECT			;NEVER REUSE ANOTHER DRIVE'S BAT PAGE
  E5CE   04E0 E568      	CLR	@CAB
  E5D2   04E0 EC7A      	CLR	@BATERR
  E5D6   0720 E570      	SETO	@DIRENT
  E5DA   04E0 E576      	CLR	@CDSECT
  E5DE   0460 F014      	B	@MSELDSK
  E5E2   2E43           DSKFUNE	POP	R3
  E5E4   2DC0           	RET
                        ;
                        ;*************************
                        ;
                        ;	GET CURRENT DISK
                        ;	RETURN IN MSB OF R1
                        ;
                        ;*************************
                        ;
  E5E6   C060 E566      CDFUNC	MOV	@DISK,R1	 		;FOR MONITOR
  E5EA   2DC0           	RET
                        ;
                        ;========================================================================
                        ;
                        ;	BDOS SET THE DMA ADDRESS
                        ;
                        ;=========================================================================
                        ;
                        DMAFUN
  E5EC   C803 E572      	MOV	R3,@WRADDR		;COPY FOR WRSEQ
  E5F0   C803 E574      	MOV	R3,@DMAADDR
  E5F4   2DC0           	RET
                        ;******************************
                        ;
                        ;	MONITOR SET THE DMA ADDRESS IN R2
                        ;
                        ;******************************
                        ;
  E5F6   C802 E574      _SETDMA	MOV	R2,@DMAADDR
  E5FA   2DC0           	RET
                        
                        ;--------------------------------------------------------------------------
                        ;
                        ;	OPEN A FILE (FUNCTION 15)
                        ;
                        ;	R3 -> FCB
                        ;
                        ;	THIS FUNCION TRANSFERS ALL THE FILE'S  DIRECTORY DATA
                        ;	TO THE FCB.  IF THE FILE IS NOT FOUND -1 IS RETURNED IN
                        ;	REGISTER R1. NOTE THAT THIS FUNCTION WILL NOT CREATE AN
                        ;	ENTRY IF ONE DOESN'T EXIST. 'MAKEFIL(FUNCTION 22) MUST
                        ;	FIRST BE CALLED, HOWEVER IF 'MAKEFIL' IS CALLED THEN
                        ;	OPEN DOES NOT NEED TO BE CALLED EXPLICITLY IN THIS 
                        ;	INSTANCE.
                        ;
                        ;
                        ;----------------------------------------------------------------------------
                        ;
  E5FC   C203           FOPEN:	MOV	R3,R8		;COPY FCB POINTER FOR INTERNAL USE
  E5FE   2DA0 E828      	CALL	@SEARCH1		;OPEN THE DIRECTORY - GET POINTER IN R3
  E602   C041           	MOV	R1,R1		;SUCCESSFUL OPEN ?
  E604   1115           	JLT	OPENE
  E606   C048           	MOV	R8,R1
  E608   C083           	MOV	R3,R2		;DONT TOUCH DIRECTORY POINTER
  E60A   0221 000B      	AI	R1,NAMSIZ 		;POINT TO FDE
  E60E   0222 000B      	AI	R2,NAMSIZ		;R2 -> DIRECTORY ENTRY
  E612   0200 0015      	LI	R0,DIRSIZ-NAMSIZ	;NO OF BYTES TO TRANSFER
                        
  E616   DC72           OPENA:	MOVB	*R2+,*R1+		;TRANSFER ENTRIES
  E618   0600           	DEC	R0
  E61A   16FD           	JNE	OPENA
                        ;
                        ;  'MAKFIL' ENTERS HERE ALSO;
                        ;
                        
  E61C   04C1           OPENENT:	CLR	R1
  E61E   CA01 0018       	MOV	R1,@CBN(R8)		;ZERO CURRENT BLOCK FIELD
  E622   CA01 001E       	MOV	R1,@RELR(R8)
  E626   CA01 001C      	MOV	R1,@RELB(R8)
                        ;	LRBL IS PERSISTENT FILE METADATA AND MUST SURVIVE OPEN
  E62A   CA01 001A      	MOV	R1,@CRN(R8)
                        ;	SETO	@MLBUF		;INVALIDATE MLBUF SO IT IS NOT REUSED FROM A PREVIOUS OPEN
  E62E   2DC0           	RET
                        
  E630   0701           OPENE:	SETO	R1
  E632   2DC0           	RET
                        
                        ;
                        ;  ENTER WITH FCB POINTER IN R3
                        ;
                        ;COPYFCB:	LI	R8,FCB		;LOCAL COPY OF FCB
                        
                        ;=================================================================================
                        ;
                        ;FOR VERSION 4, WE LOAD THE FIRST 512 BYTES INTO MLBUF TO MANAGE THE
                        ;LOCATION TABLE.   THE LOCATION TABLE IS 128 * 4 BYTES LONG OR 512
                        ;THEREFORE THE SECOND SECTOR IS THE FIRST FILE SECTOR.  THE FILE SYSTEM
                        ;DOES NOT NEED TO KNOW ABOUT THIS AS IT JUST MEANS THAT EACH FILE IS 512 BYTES LONGER
                        ;
                        ;ALL FILES, EXCEPT THE SYSTEM FILES HAVE THIS FORMAT.  IT MEANS THAT WHEN A FILE IS CREATED
                        ;AN EMPTY MODULE LOCATION TABLE SECTOR WILL BE ZEROED AND WILL BE THE FIRST SECTOR
                        ;WHICH MEANS THAT IF IT IS ZERO IT IS TREATED AS A NORMAL TPA/LADDR FILE LOAD/SEQUENTIAL READ.
                        ;
                        ;
                        ;CMLTI      NUMBER OF SECTORS   LOAD ADDRESS
                        ;[ 8 bits | ( NMSECT 8 bits)][     16 bits       ]
                        ;[SEG     |   Nx512 sectors ][LOAD ADDRESS OFFSET]
                        ;  0	   12	0X500H
                        ;  1	...etc
                        ;  FF	FF	FFFF	; END OF TABLE
                        ;
                        ;SO BEGIN LOADING AT THE FIRST INDEX.
                        ;THE NEXT INDEX WILL BE USED ONCE THE CRN - NMSECT
                        ;=================================================================================
                        ;
                        ;
                        ; LOAD AND INITIALISE THE LOCATION TABLE INTO MBUF.
                        ; ASSUME R8 HOLDS FCB
                        ;
                        ; CMLTI - THIS IS THE CURRENT MODULE LOAD INDEX.  JUST ONE BYTE I.E UP TO 256 MODULES
                        ; MODS - MODULE SIZE.  THIS IS THE NUMBER OF 512 BYTE RECORDS IN THE PARTICULAR MODULE;
                        ;
                        ; WHICH IN POINTED TO MY CMLTI
                        ;
                        ;
  E634   04C0           GETMLT:	CLR	R0
  E636   DA00 0020      	MOVB	R0,@CMLTI(R8)		;SET CLMTI TO ZERO
  E63A   0203 F07E      	LI	R3,MLBUF
  E63E   C803 E574      	MOV	R3,@DMAADDR		;SET DMA ADDRESS FOR MLBUF
  E642   C0C8           	MOV	R8,R3		;NEED THE FCB IN R3
  E644   2DA0 E760      	CALL	@RDSEQ		;RDSEQ INCREMENTS CRN ONLY AFTER A SUCCESSFUL READ
  E648   C820 E572      	MOV	@WRADDR,@DMAADDR	;RESTORE THE CALLER'S DMA ADDRESS
  E64C   E574           
  E64E   C041           	MOV	R1,R1
  E650   1109           	JLT	GETMLTE		;DO NOT PARSE AN UNREAD/FAILED BUFFER
                        ;
                        ; NOTE:  IF THE MLI IS ZERO, THAT IS, DEFAULT, THEN SETTING THE PARAMETERS BELOW WILL HAVE NO IMPACT
                        ;
  E652   0201 F07E      	LI	R1,MLBUF		;POINT TO THE MODULE INDEX BUFFER
  E656   DA31 0022      	MOVB	*R1+,@MPAGE(R8)		;THIS IS MEMORY PAGE
  E65A   DA31 0021      	MOVB	*R1+,@NMSECT(R8)	;NUMBER OF RECORDS IN THIS MODULE
  E65E   CA11 0010      	MOV	*R1,@FLA(R8)		;FLA OF ZERO IS DEFAULT. THIS IS THE LOAD ADDRESS FOR THE MODULE
  E662   04C1           	CLR	R1
  E664   2DC0           GETMLTE	RET
                        ;
                        ; WE NEED TO ZERO IT AS THIS IS THE DEFAULT FOR A SINGLE MODULE
                        ;
  E666   04C0           MAKEMLT:	CLR	R0
  E668   DA00 0020      	MOVB	R0,@CMLTI(R8)		;SET CLMTI TO ZERO
  E66C   0200 0100      	LI	R0,0100H		;CLR IS A WORD OPERATION: CLEAR 256 WORDS, NOT 512
  E670   0201 F07E      	LI	R1,MLBUF
  E674   04F1           MMLTA	CLR	*R1+		;PAGE = 0, NUMBER OF SECTORS = 0, STARTING ADDRESS = 0
  E676   0600           	DEC	R0
  E678   16FD           	JNE	MMLTA
                        ;
  E67A   0200 F07E      	LI	R0,MLBUF
  E67E   C800 E574      	MOV	R0,@DMAADDR		;SET DMA ADDRESS FOR MLBUF
  E682   C0C8           	MOV	R8,R3		;NEED THE FCB IN R3
  E684   2DA0 E6D6      	CALL	@WRSEQ		;WRSEQ INCREMENTS CRN AFTER SUCCESS
  E688   C820 E572      	MOV	@WRADDR,@DMAADDR	;RESTORE THE CALLER'S DMA ADDRESS
  E68C   E574           
  E68E   C041           	MOV	R1,R1		;RESTORE RETURN CONDITION AFTER THE DMA MOVE
  E690   2DC0           	RET
                        ;
                        ;
                        ;***************************************************************************
                        ;
                        ;	CLOSE A	FILE (FUNCTION 16)
                        ;
                        ;	R3 -> FCB
                        ;
                        ;	SIMILAR TO OPEN FUNCTION EXCEPT THAT THE FILE SHOULD 
                        ;	HAVE BEEN PREVIOUSLY EITHER OPENED USING 'OPEN' OR
                        ;	CREATED USING 'MAKFIL'. ANY OTHER METHOD OF CALLING
                        ;	WILL TRANSFER JUNK TO THE DIRECTORY - NOT A PLEASANT 
                        ;	THOUGHT.
                        ;
                        ;	CLOSE ALSO ZERO'S THE CRN & CBN WORDS SO THAT OPEN DOES
                        ;	NOT HAVE TO INITIALISE THESE TWO VALUES.
                        ;
                        ;*****************************************************************************
                        ;
  E692   C203           FCLOSE:	MOV	R3,R8		;COPY FCB POINTER
  E694   2DA0 E828      	CALL	@SEARCH1 		;MAKE SURE THE FILE EXISTS AND OPEN THE DIRECTORY
  E698   C041           	MOV	R1,R1	 	;ERROR ?
  E69A   111C           	JLT	CLOSEB	 	;YES
  E69C   C048           	MOV	R8,R1		;FCB POINTER
  E69E   C083           	MOV	R3,R2		;DONT TOUCH R3 IT POINTS TO DIRECTORY ENTRY
  E6A0   0221 000B      	AI	R1,NAMSIZ		;ENTRY DATA POINTER
  E6A4   0222 000B      	AI	R2,NAMSIZ		;DIR ENTRY POINTER
  E6A8   0200 0015      	LI	R0,DIRSIZ-NAMSIZ
                        
  E6AC   DCB1           FCLOSE1: 	MOVB	*R1+,*R2+		;UPDATE DIRECTORY ENTRY
  E6AE   0600           	DEC	R0
  E6B0   16FD           	JNE	FCLOSE1
                        ;
                        ; CBN/CRN/RELB/RELR ARE RUNTIME CURSORS.  NEVER PERSIST THEM IN THE DIRECTORY.
                        ; LEAVE THE CALLER'S FCB CURSORS INTACT, BUT ZERO THE DIRECTORY COPY.
                        ;
  E6B2   04E3 0018      	CLR	@CBN(R3)
  E6B6   04E3 001A      	CLR	@CRN(R3)
  E6BA   04E3 001C      	CLR	@RELB(R3)
  E6BE   04E3 001E      	CLR	@RELR(R3)
                        ;	
                        ; UPDATE DIRECTORY ENTRY
                        ;
                        
  E6C2   2DA0 EC5A      	CALL	@WRDIR		;UPDATE THE DIRECTORY ENTRY
  E6C6   C041           	MOV	R1,R1
  E6C8   1105           	JLT	CLOSEB			;NEVER CHANGE THE BAT IF DIRECTORY COMMIT FAILED
  E6CA   C068 000E      	MOV	@FSZ(R8),R1		;CAN'T RECLAIM IF FILE IS ZERO SIZE
  E6CE   1302           	JEQ	CLOSEB
  E6D0   2DA0 E9E6      	CALL	@RECLAIM		;TRY TO RECLAIM UNUSED BLOCKS
  E6D4   2DC0           CLOSEB	RET
                        ;
                        ;***************************************************
                        ;
                        ;	WRITE SEQUENTIALLY (FUNCTION 21)
                        ;	CALL TO SETDMA BEFORE CALLING THIS FUNCTION
                        ;	R3 -> FCB
                        ;
                        ;	THIS FUNCTION IS CONTROLLED MAINLY BY 
                        ;	THE CRN (NEXT RECORD TO READ) COUNTER.
                        ;
                        ;	FOR VERSION 4 AND THE INTRODUCTION OF MODULES BDOS NEEDS TO FIRST
                        ;	CREATE THE MODULE LOAD HEADER IF THIS THE FIRST WRITE TO AN OPEN FILE.
                        ;
                        ;
                        ;
                        ;*****************************************************
                        ;
  E6D6   C203           WRSEQ:	MOV	R3,R8		;SAVE FCB POINTER
                        ;
                        ; DO NOT CREATE A SPARSE GAP.  OVERWRITE (CRN < FSZ) OR APPEND (CRN = FSZ) ONLY.
                        ; THIS ALSO PREVENTS THE SINGLE-BLOCK ALLOCATION PATH FROM WRITING A DISTANT
                        ; RANDOM RECORD INTO THE WRONG PHYSICAL BLOCK.
                        ;
  E6D8   8A28 001A      	C	@CRN(R8),@FSZ(R8)
  E6DC   000E           
  E6DE   1B3E           	JH	WRSEQE		;UNSIGNED CRN > FSZ
  E6E0   2DA0 EADE      	CALL	@CRNTBC	 	;CRN TO RELATIVE BLOCK & REMAINDER
  E6E4   C803 E56C      	MOV	R3,@CBO		;SAVE OFFSET
                        ;
                        ;	IF WE COULD TRACE FROM EXISTING POSITION WE COULD SPEED THINGS UP AND STOP THRASHING
                        ;	TRACE1 WILL USE CRN
                        ;
  E6E8   C0C2           	MOV	R2,R3		;R3 NOW HOLDS RELATIVE BLOCK NUMBER
  E6EA   2DA0 EB56      	CALL	@TRACE
  E6EE   C020 EC7A      	MOV	@BATERR,R0
  E6F2   1630           	JNE	WRSEQ2			;ABORT ON A CORRUPT OR UNREADABLE CHAIN
  E6F4   8081           	C	R1,R2		;IF ALLOCATED CONTINUE
  E6F6   1319           	JEQ	WRSEQ0
                        ;
                        ;	AT THIS POINT WE HAVE THE CBP FROM TRACE
                        ;	NXTBLK WILL FIND A BLOCK AND ALLOCATE IT (LINK) 
                        ;	BASED ON CBP
                        ;
  E6F8   2DA0 EAEC      	CALL	@NXTBLK	 	;LOCATE A BLOCK AND RETURN IN R7
  E6FC   C041           	MOV	R1,R1		;ANY BLOCKS LEFT ?
  E6FE   112A           	JLT	WRSEQ2		;NO - SHOW ERROR
                        ;
                        ;	IN CASE WE CROSS BAT BOUNDARIES WE NEED TO ALLOCATE LAST BLOCK FIRST
                        ;	AND THEN POSTFIX THE CAB FOUND IN TRACE.  TRACE HAS FILLED THE CBP AND
                        ;	CAB WHICH NEED TO BE UPDATED. R7 IS THE CURRENT BLOCK POINTER AND
                        ;	R6 CONTAINS THE FREE BLOCK NUMBER
                        ;
  E700   0201 FF80      	LI	R1,LASTBLK		;ALLOCATE THIS BLOCK TO THIS FILE
  E704   C5C1           	MOV	R1,*R7		;NEW END OF LINK IN CURRENT BAT FROM NXTBLK
  E706   C807 E56A      	MOV	R7,@CBP		;AND KEEP CBP UPDATED
  E70A   0720 EC78      	SETO	@BATCHG		;FORCE AN UPDATE TO THE BAT
                        ;
                        ;	NOW UPDATE PREVIOUS LAST BLOCK TO POINT NOW TO THE NEW LAST BLOCK
                        ;
  E70E   2E06           	PUSH	R6		;PUSH NEW ALLOCATED BLOCK CAB
  E710   C0E0 E568      	MOV	@CAB,R3		;GET PREVIOUS LAST BLOCK RETURNED FROM TRACE
  E714   2DA0 EBAA      	CALL	@GETBATP		;FIND THE BAT AND GET THE POINTER FROM THE INDEX
  E718   2E46           	POP	R6
  E71A   C060 EC7A      	MOV	@BATERR,R1
  E71E   161A           	JNE	WRSEQ2			;DO NOT DEREFERENCE AN INVALID BAT POINTER
  E720   C5C6           	MOV	R6,*R7		;UPDATE TO NEW END OF LINK
  E722   C806 E568      	MOV	R6,@CAB		;UPDATED FROM NXTBLK
  E726   0720 EC78      	SETO	@BATCHG		;FORCE AN UPDATE TO THE BAT
                        ;	
  E72A   C0A0 E568      WRSEQ0	MOV	@CAB,R2		;RECOVER DISK BLOCK
  E72E   C0E0 E56C      	MOV	@CBO,R3		;AND OFFSET
  E732   0200 0002      	LI	R0,WRCMD
  E736   C800 E578      	MOV	R0,@CCMD		;CURRENT COMMAND
                        
  E73A   2DA0 E810      	CALL	@RWREC
  E73E   C041           	MOV	R1,R1		;WAS THERE AN ERROR
  E740   1109           	JLT	WRSEQ2		;JUMP IF YES
                        
                        ;
                        ; FILE SIZE IS THE HIGH-WATER MARK, NOT A COUNT OF SUCCESSFUL WRITE CALLS.
                        ; AN OVERWRITE MUST NOT GROW THE FILE; AN APPEND GROWS IT BY ONE RECORD.
                        ;
  E742   C028 001A      	MOV	@CRN(R8),R0
  E746   0580           	INC	R0			;END POSITION AFTER THIS WRITE
  E748   8A00 000E      	C	R0,@FSZ(R8)
  E74C   1B04           	JH	WRSEQG		;UNSIGNED NEW END > OLD FSZ
  E74E   05A8 001A      WRSEQI	INC	@CRN(R8) 		;BUMP CURRENT RECORD ONLY AFTER SUCCESS
                        
  E752   04C1           WRSEQ1	CLR	R1
  E754   2DC0           WRSEQ2	RET
  E756   CA00 000E      WRSEQG	MOV	R0,@FSZ(R8)
  E75A   10F9           	JMP	WRSEQI
  E75C   0701           WRSEQE	SETO	R1		;SPARSE/OUT-OF-RANGE WRITE REJECTED
  E75E   2DC0           	RET
                        
                        ;
                        ;=====================================================================================
                        ;	READ SEQUENTIALLY
                        ;	R3 -> FCB
                        ;	ASSUME THE CALL TO DMAFUNC HAS BEEN MADE SO WE CAN
                        ;	SAFELY SET THE PAGE INDEX IF NECESSARY USING FCB IN R3
                        ;
                        ;=================================================================================
                        ;
  E760   C203           RDSEQ:	MOV	R3,R8		;COPY FCB ADDRESS OF FCB
                        ;
                        ; EOF IS CRN >= FSZ.  THE OLD EQUALITY-ONLY TEST ALLOWED CRN > FSZ TO
                        ; FALL THROUGH AND READ FROM THE LAST BLOCK IN THE CHAIN.
                        ;
  E762   8A28 001A      	C	@CRN(R8),@FSZ(R8)
  E766   000E           
  E768   141B           	JHE	RDSEQ1		;UNSIGNED CRN >= FSZ
  E76A   2DA0 EADE      	CALL	@CRNTBC		;CONVERT CRN TO A RELATIVE BLOCK NUMBER
  E76E   C803 E56C      	MOV	R3,@CBO		;SAVE OFFSET AND USE BLOCK IN R2 TO
  E772   2DA0 EB56      	CALL	@TRACE		;TRACE THROUGH THE LINKED ALLOCATION LIST
  E776   C020 EC7A      	MOV	@BATERR,R0
  E77A   1612           	JNE	RDSEQ1			;DO NOT READ THROUGH A CORRUPT OR FAILED CHAIN
  E77C   8081           	C	R1,R2
  E77E   1610           	JNE	RDSEQ1			;CHAIN MUST ACTUALLY REACH THE REQUESTED BLOCK
  E780   C0E0 E56C      	MOV	@CBO,R3		;RECOVER VARIABLES FOR RWREC
  E784   C0A0 E568      	MOV	@CAB,R2
  E788   0200 0001      	LI	R0,RDCMD
  E78C   C800 E578      	MOV	R0,@CCMD		;CURRENT COMMAND
                        ;
                        ; R8 HOLDS FCB
                        ;
  E790   2DA0 E810      	CALL	@RWREC
  E794   C041           	MOV	R1,R1
  E796   1103           	JLT	RDSEQ2			;PROPAGATE MEDIA/BIOS ERROR, CURSOR UNCHANGED
  E798   05A8 001A      	INC	@CRN(R8)		;BUMP TO NEXT RECORD ONLY AFTER SUCCESS
  E79C   04C1           	CLR	R1
  E79E   2DC0           RDSEQ2	RET
                        ;
  E7A0   0701           RDSEQ1	SETO	R1
  E7A2   2DC0           	RET
                        ;
                        ;*******************************
                        ;
                        ;	R3 -> FCB
                        ;	READ RANDOM RECORD
                        ;
                        ;********************************
                        ;
  E7A4   C203           RDRND:	MOV	R3,R8		;SAVE FCB POINTER
  E7A6   C028 001C      	MOV	@RELB(R8),R0
  E7AA   1613           	JNE	RDRNDE			;CURRENT DISK USES A 16-BIT ABSOLUTE RECORD NUMBER
  E7AC   064A           	DECT	SP
  E7AE   C6A8 0018      	MOV	@CBN(R8),*SP		;PRESERVE SEQUENTIAL BLOCK CURSOR
  E7B2   064A           	DECT	SP
  E7B4   C6A8 001A      	MOV	@CRN(R8),*SP		;PRESERVE SEQUENTIAL RECORD CURSOR
  E7B8   04E8 0018      	CLR	@CBN(R8)
  E7BC   CA28 001E      	MOV	@RELR(R8),@CRN(R8)
  E7C0   001A           
  E7C2   C0C8           	MOV	R8,R3
  E7C4   2DA0 E760      	CALL	@RDSEQ
  E7C8   CA3A 001A      	MOV	*SP+,@CRN(R8)		;RESTORE CURSOR; R1 STATUS IS UNCHANGED
  E7CC   CA3A 0018      	MOV	*SP+,@CBN(R8)
  E7D0   2DC0           	RET
  E7D2   0701           RDRNDE	SETO	R1
  E7D4   2DC0           	RET
                        ;
                        ;*******************************
                        ;
                        ;	WRITE RANDOM RECORD
                        ;	R3 -> FCB
                        ;	(R3)RELR  MUST HOLD THE RECORD TO WRITE TO
                        ;
                        ;*******************************
                        ;
  E7D6   C203           WRRND:	MOV	R3,R8		;SAVE FCB POINTER
  E7D8   C028 001C      	MOV	@RELB(R8),R0
  E7DC   1617           	JNE	WRRNDE			;RELB MUST BE ZERO ON THIS DISK GEOMETRY
  E7DE   8A28 001E      	C	@RELR(R8),@FSZ(R8)
  E7E2   000E           
  E7E4   1B13           	JH	WRRNDE			;ALLOW OVERWRITE OR APPEND AT EOF, NOT SPARSE GAPS
  E7E6   064A           	DECT	SP
  E7E8   C6A8 0018      	MOV	@CBN(R8),*SP		;PRESERVE SEQUENTIAL BLOCK CURSOR
  E7EC   064A           	DECT	SP
  E7EE   C6A8 001A      	MOV	@CRN(R8),*SP		;PRESERVE SEQUENTIAL RECORD CURSOR
  E7F2   04E8 0018      	CLR	@CBN(R8)
  E7F6   CA28 001E      	MOV	@RELR(R8),@CRN(R8)
  E7FA   001A           
  E7FC   C0C8           	MOV	R8,R3
  E7FE   2DA0 E6D6      	CALL	@WRSEQ
  E802   CA3A 001A      	MOV	*SP+,@CRN(R8)		;RESTORE CURSOR; R1 STATUS IS UNCHANGED
  E806   CA3A 0018      	MOV	*SP+,@CBN(R8)
  E80A   2DC0           	RET
  E80C   0701           WRRNDE	SETO	R1
  E80E   2DC0           	RET
                        ;
                        ;*******************************************************
                        ;
                        ;	COMMON READ WRITE ENTRY
                        ;
                        ;	R8 --> FCB
                        ;	R2 = CURRENT BLOCK NUMBER (ID)
                        ;	R3 = CURRENT BLOCK OFFSET
                        ;
                        ;********************************************************
                        ;
  E810   0A22           RWREC:	SLA	R2,2		;THERE ARE 4 SECTORS PER BLOCK
  E812   A0C2           	A	R2,R3		;WE NOW HAVE THE BASE LBA
  E814   0A13           	SLA	R3,1		;BECAUSE WE HAVE TO READ TWO LBA FOR AN EFFECTIVE 512 BYTES
                        ;
                        ; DMAADDR IS AUTHORITATIVE.  DMAFUN SETS IT FOR CALLERS, WHILE INTERNAL
                        ; OPERATIONS MAY TEMPORARILY POINT IT AT MLBUF.  DO NOT OVERWRITE IT HERE.
                        ;
  E816   C020 E578      	MOV	@CCMD,R0		;GET TYPE
  E81A   0280 0002      	CI	R0,WRCMD		;READ ? 
  E81E   1602           	JNE	RWREC_R	 	;TRY FOR WRITE
  E820   0460 EB44      	B	@WRREC	 	;RETURN FROM RDREC
  E824   0460 EB32      RWREC_R:	B	@RDREC	 	;ASSSUME READ
                        ;
                        ;
                        ;***************************************************************
                        ;
                        ;	SEARCH FIRST( LOOK FOR DIRECTORY ENTRY)
                        ;
                        ;	NORMAL DIRECTORY SEARCH BEGINNING AT THE
                        ;	START OF THE DIRECTORY CONTINUING TILL END.
                        ;
                        ;	E5 => DELETED ENTRY	
                        ;	00 => END OF DIRECTORY	
                        ;	R3 -> FCB	
                        ;
                        ;	RETURN 
                        ;		R1 =  MINUS ONE FOR BAD RESULT 
                        ;		R3 -> FCB CURRENT DIRECTORY ENTRY
                        ;
                        ;***************************************************************
                        ;
                        
  E828   C203           SEARCH1:	MOV	R3,R8	;SAVE FCB FOR DIROPN
  E82A   0720 E570      	SETO	@DIRENT	;SET CURRENT SECTOR DIRECTORY INDEX
  E82E   04E0 E576      	CLR	@CDSECT	;BEGIN SEARCHING AT FIRST SECTOR
  E832   2DA0 EA7E      	CALL	@DIROPN	;OPEN THE DIRECTORY
  E836   C041           	MOV	R1,R1
  E838   1107           	JLT	SEARCHX	;PROPAGATE DIRECTORY READ FAILURE
  E83A   1018           	JMP	DLOOK	;RETURN FROM DLOOK
                        ;
                        ;***************************************************************
                        ;
                        ;	SEARCH NEXT (SEARCH2)
                        ;
                        ;	SIMILAR TO CPM - BASICALLY CONTINUES
                        ;	WHERE LAST SEARCH LEFT OFF. THAT IS IT 
                        ;	SIMPLY DOES NOT ALTER THE VALUE OF THE 
                        ;	DIRENT AND CDSECT VARIABLES.
                        ;
                        ;**************************************************************
                        ;
  E83C   C203           SEARCH2:	MOV	R3,R8
  E83E   2DA0 EA7E      	CALL	@DIROPN		;OPEN THE DIRECTORY
  E842   C041           	MOV	R1,R1
  E844   1101           	JLT	SEARCHX		;PROPAGATE DIRECTORY READ FAILURE
  E846   1012           	JMP	DLOOK
  E848   2DC0           SEARCHX	RET
                        ;
                        ;-------------------------------------------------
                        ;
                        ;  FUCTION 35 - GET FILE SIZE
                        ;
                        ;   R2 = FUNCTION NUMBER
                        ;   R3 -> FCB
                        ;
                        ;   PURPOSE - MOVE THE ADDRESS OF THE LAST RECORD
                        ;	      TO THE RELATIVE FIELDS
                        ;
                        ;-------------------------------------------------
                        ;
  E84A   C203           GETSIZ:	MOV	R3,R8		;COPY FCB POINTER FOR INTERNAL USE
  E84C   2DA0 E828      	CALL	@SEARCH1		;OPEN THE DIRECTORY
  E850   C041           	MOV	R1,R1		;SUCCESSFUL OPEN ?
  E852   1105           	JLT	GETSIZ1
  E854   04E8 001C      	CLR	@RELB(R8)		;16-BIT ABSOLUTE RECORD ADDRESS
  E858   CA23 000E      	MOV	@FSZ(R3),@RELR(R8)	;COPY SIZE FROM THE MATCHED DIRECTORY ENTRY
  E85C   001E           
  E85E   2DC0           GETSIZ1:	RET
                        ;
                        ;--------------------------------------------------
                        ;
                        ;	FUCTION 36 - SET RELATIVE RECORD
                        ;	R2 =  FUNCTION NUMBER
                        ;	R3 -> FCB
                        ;
                        ;	PURPOSE - THE RELATIVE RECORD FIELD IS SET TO THE
                        ;	SAME FILE ADDRESS AS THE CURRENT BLOCK AND
                        ;	CURRENT RECORD.
                        ;
                        ;---------------------------------------------------
                        ;
  E860   04E3 001C      SETREL:	CLR	@RELB(R3)		;CURRENT DISK USES A 16-BIT ABSOLUTE RECORD
  E864   C8E3 001A      	MOV	@CRN(R3),@RELR(R3)
  E868   001E           
  E86A   2DC0           	RET
                        ;
                        ;*****************************************
                        ;
                        ;	GENERAL DIRECTORY SEARCH SUBROUTINE
                        ;	R8 = PTR TO FCB
                        ;	MUST CHECK FILE ATTRIBUTES FOR FILE TYPE
                        ;
                        ;******************************************
                        ;
                        ;DBG_DLOOK1:	TEXT	"DBG_DLOOK1"	;TEMP FOR DEBUG
                        ;	EVEN
                        ;	WORD	0
                        
  E86C   2DA0 EAA2      DLOOK:	CALL	@DIRBLK	 ;GET NEXT ENTRY PNTR IN R3
  E870   1115           	JLT	NONTRY	 ;NOT FOUND
  E872   C083           	MOV	R3,R2	 ;SAVE PNTR TO DIRECTORY ENTRY
  E874   D012           	MOVB	*R2,R0	 ;TEST FOR EOD
  E876   11FA           	JLT	DLOOK	 ;DELETED ENTRY
  E878   1502           	JGT	DLOOK4	 ;VALID
  E87A   04C3           	CLR	R3	 ;SHOW END OF DIRECTORY REACHED
  E87C   100F           	JMP	NONTRY	
  E87E   0200 000B      DLOOK4	LI	R0,NAMSIZ 	;NUMBER OF CHARS TO MATCH
  E882   C148           	MOV	R8,R5	;SAVE FCB PNTR
                        
  E884   9815 E564      NXTLTR	CB	*R5,@WILD	;? WILL MATCH ALL (LIKE CPM)
  E888   1603           	JNE	DLOOK5	;PROCESS NORMALLY
  E88A   0585           	INC	R5	;ELSE ASSUME MATCH SO BUMP POINTERS
  E88C   0582           	INC	R2
  E88E   1002           	JMP	DLOOK6
                        
  E890   9D72           DLOOK5	CB	*R2+,*R5+	;MATCH ?
  E892   16EC           	JNE	DLOOK	 ;NO SO - KEEP LOOKING
  E894   0600           DLOOK6	DEC	R0	
  E896   16F6           	JNE	NXTLTR	 ;CONTINUE
  E898   04C1           	CLR	R1	 ;SHOW GOOD RESULT
  E89A   1001           	JMP	DLOOKEX
  E89C   0701           NONTRY	SETO	R1	 
                        
  E89E   2DC0           DLOOKEX	RET		;SHOW NOT FOUND
                        ;
                        ;********************************	
                        ;
                        ;	CREATE A DIRECTORY ENTRY (FUNCTION 22)
                        ;
                        ;	ENTRY: 	R3 -> FCB
                        ;		R2 = 22
                        ;
                        ;	RETURN:	R1 = 0 EMPTY DIRECTORY FOUND
                        ;		R1 = FF NO EMPTY DIRECTORY AVAILABLE
                        ;
                        ;	THIS FUNCTION SHOULD BE CALLED ONLY WITH THE
                        ;	FILENAME, EXTENSION AND FILE TYPE IN THE FIRST 11 + 1 BYTES OF THE FCB. THE
                        ;	FILE TYPE MUST BE SET BY THE ROUTINE CREATING THE FILE.  'MAKFIL'
                        ;	MAKES A POINT OF ZEROING ALL BAR THE FILENAME WITH
                        ;	THE DIRECTORY ENTRY BEFORE WRITING IT TO DISK. HENCE
                        ;	YOU MUST CALL CLOSE TO PROPERLY TRANSFER ANY FILE 
                        ;	ATTRIBUTES ETC. ALSO NOTE THAT THE FSB WILL BE RETURNED
                        ;	HOWEVER ALL OTHER FCB ENTRIES WILL BE ZEROED.
                        ;
                        ;
                        ;******************************	
                        ;
                        ;IDE_MODIFICTION_IN PROGRESS
                        ;DB_MAKF1:	TEXT	"MAKFL1"	;TEMP FOR DEBUG
                        ;	WORD	0
                        ;	EVEN
                        
  E8A0   C203           MAKFIL:	MOV	R3,R8			;LOCAL FCB COPY
  E8A2   2DA0 EAEC      	CALL	@NXTBLK	 		;FIND A SECTOR FOR FSB AND PLACE IN CAB
  E8A6   C041           	MOV	R1,R1	 		;ERROR ?
  E8A8   1136           	JLT	MAKERR			;LOOKS LIKE DISK FULL
                        
  E8AA   C806 E568       	MOV	R6,@CAB			;UPDATE BLOCK NUMBER AND
  E8AE   C807 E56A      	MOV	R7,@CBP			;POINTER TO THE CURRENT BLOCK
                        
  E8B2   0720 E570      	SETO	@DIRENT			;SIMILAR TO SEARCH1
  E8B6   04E0 E576      	CLR	@CDSECT			;MUST SET THESE VARIABLES
  E8BA   2DA0 EA7E      	CALL	@DIROPN 		;OPEN THE DIRECTORY
  E8BE   C041           	MOV	R1,R1
  E8C0   112A           	JLT	MAKERR			;DO NOT SEARCH STALE DIRECTORY DATA
  E8C2   2DA0 EAA2      NTHR	CALL	@DIRBLK 		;GET ENTRY THROUGH R3
  E8C6   1127           	JLT	MAKERR			;END OF DIRECTORY
  E8C8   D013           	MOVB	*R3,R0	 		;CHECK ENTRY
  E8CA   15FB           	JGT	NTHR	 		;VALID ENTRY
                        
                        ;
                        ; ASSUME R3 NOW POINTS TO DIR ENTRY
                        ;
  E8CC   04C0           	CLR	R0
  E8CE   C148           	MOV	R8,R5		;R8 HOLDS THE FCB
  E8D0   0225 000B      	AI	R5,NAMSIZ		;FLUSH FROM AFTER FILE TYPE ENTRY
  E8D4   0202 0015      	LI	R2,DIRSIZ-NAMSIZ 	;NUMBER OF BYTES TO ZERO - OMMIT FTY
                        
                        ;
  E8D8   DD40           MKFIL2	MOVB	R0,*R5+		;ZERO AFTER FILENAME
  E8DA   0602           	DEC	R2
  E8DC   16FD           	JNE	MKFIL2
  E8DE   CA20 E568      	MOV	@CAB,@FSB(R8)		;TRANSFER FSB
  E8E2   000C           
  E8E4   0201 FF80      	LI	R1,LASTBLK		;MARK AS FIRST AND LAST BLOCK IN BAT
  E8E8   C020 E56A      	MOV	@CBP,R0
  E8EC   C401           	MOV	R1,*R0		;SHOW ITS THE LAST BLOCK AS WELL AS THE FIRST
  E8EE   0720 EC78      	SETO	@BATCHG		;THE NEW ALLOCATION MUST BE COMMITTED
                        ;
                        ; GET THE FILE EXTENSION - ASSUME F8 HOLDS POINTER TO FCB
                        ;
  E8F2   2DA0 E928      	CALL	@GETTYPE
                        
                        ;
                        ; NOW CREATE THE ZERO LENGTH FILE
                        ;
                        ;	MOV	R3,@DMAADDR
  E8F6   0202 0020      	LI	R2,DIRSIZ		;TRANSFER FILENAME + FSB TO DIRECTORY
  E8FA   C148           	MOV	R8,R5	 	;SAVE FCB POINTER
                        
                        
  E8FC   DCF5           MKFIL1	MOVB	*R5+,*R3+		;TRANSER FCB ENTRY TO DIRECTRY RECORD
  E8FE   0602           	DEC	R2
  E900   16FD           	JNE	MKFIL1
                        ;
                        ;
                        ; COMMIT THE ALLOCATION BEFORE PUBLISHING THE DIRECTORY ENTRY.
                        ; A FAILURE CAN THEN LEAK A BLOCK, BUT CANNOT CREATE A CROSS-LINKED LIVE FILE.
                        ; R8 -> FCB
                        ;
  E902   2DA0 EC2A      	CALL	@WRBAT
  E906   C041           	MOV	R1,R1
  E908   1106           	JLT	MAKERR
  E90A   2DA0 EC5A      	CALL	@WRDIR
  E90E   C041           	MOV	R1,R1		;IF NO ERROR SIMULATE 'OPEN'
  E910   1102           	JLT	MAKERR
  E912   0460 E61C      	B	@OPENENT
  E916   0701           MAKERR	SETO	R1 
  E918   2DC0           	RET
                        ;---------------------------------------------------------
                        ; TYPE DETECTION AND FCB STORAGE - FCB IS IN R8
                        ;---------------------------------------------------------
                        
                        ;--- DATA ---
                        
  E91A   434F 4D42      EXT_TAB:	TEXT	'COMBASBAT'		;9 BYTES TOTAL
  E91E   4153 4241      
  E922   54             
  E923   54             CHRT:	BYTE	'T'		; FOR .BAT CHECK
  E924   4D             CHRM:	BYTE	'M'
  E925   53             CHRS:	BYTE	'S'		; USED FOR "BAS" CHECK
  E926   00             EXT_END:	BYTE	0
  E927   00             	EVEN
                        	;
                        ; FILE TYPES 0 IS DON'T CARE
                        ;
  0001                  COM	EQU	1;
  0002                  EXE	EQU	2
  0003                  TXT	EQU	3
  0004                  BAS	EQU	4
  0005                  PRO	EQU	5		;PROCEDURE
                        ;
                        
  E928   C108           GETTYPE:	MOV	R8,R4
  E92A   04C0           	CLR	R0		;DEFAULT IS 0 UNKNOWN TYPE
  E92C   0224 0008      	AI	R4,NAMSIZ-EXTSIZ	; POINT TO EXTENSION (OFFSET 8)
  E930   C054           	MOV	*R4,R1		; GET FIRST TWO BYTES
  E932   0281 434F      	CI	R1,'CO'		; TYPE 1: COM
  E936   1607           	JNE	TRYBAS
  E938   05C4           	INCT	R4		;POINT TO NEXT CHAR
  E93A   9814 E924      	CB	*R4,@CHRM		; OFFSET 10
  E93E   1603           	JNE	TRYBAS
  E940   0200 0001      	LI	R0,COM
  E944   1014           	JMP	STORETYPE
                        
  E946   0281 4241      TRYBAS:	CI	R1,'BA'		; TYPE 2: BAS
  E94A   1607           	JNE	TRYTXT
  E94C   05C4           	INCT	R4
  E94E   9814 E925      	CB	*R4,@CHRS	; OFFSET 10
  E952   1603           	JNE	TRYTXT
  E954   0200 0004      	LI	R0,BAS
  E958   100A           	JMP	STORETYPE
                        
  E95A   0281 5458      TRYTXT:	CI	R1,'TX'		; TYPE 3: TXT
  E95E   1607           	JNE	STORETYPE
  E960   0200 0003      	LI	R0,TXT
  E964   05C4           	INCT	R4
  E966   9814 E923      	CB	*R4,@CHRT	; OFFSET 10
  E96A   1301           	JEQ	STORETYPE
  E96C   04C0           	CLR	R0		;FORCE 0 UNKNOWN
                        
  E96E   06C0           STORETYPE:	SWPB	R0
  E970   DA00 000B      	MOVB	R0,@NAMSIZ(R8)	; STORE IN TYPE BYTE (OFFSET 11)
                        ;	CALL	@PRINTFCB
  E974   2DC0           	RET
                        
  E976   4745 5445      DB_GETEX:	TEXT	"GETEX"	;TEMP FOR DEBUG
  E97A   58             
  E97B   0000           	WORD	0
  E97D   00             	EVEN
                        
                        ;DEBUG ROUTINES
                        ;
  E97E   C048           PRINTFCB:	MOV	R8, R1
  E980   0200 0010      	LI	R0,16
  E984   2EB1           PFCB1	WHEX	*R1+
  E986   0640           	DECT	R0
  E988   16FD           	JNE	PFCB1
  E98A   2DC0           	RET
                        
  E98C   C043           PRINTCMDL:	MOV	R3,R1
  E98E   0200 0010      	LI	R0,16
  E992   2EB1           PFCL1	WHEX	*R1+
  E994   0640           	DECT	R0
  E996   16FD           	JNE	PFCL1
  E998   2DC0           	RET
                        ;
                        ;*************************************************
                        ;
                        ;  RENAME A FILE
                        ;
                        ;  R3 -> FCB
                        ;  BYTES 0 - 17  OLD NAME
                        ;  BYTES 18- 27  NEW NAME
                        ;
                        ;*************************************************
                        ;
  E99A   C203           RENAME:	MOV	R3,R8
  E99C   2DA0 E828      	CALL	@SEARCH1		;CHECK TO SEE IF THE FILE EXITS
  E9A0   C041           	MOV	R1,R1
  E9A2   110B           	JLT	RENAM2		;NOT FOUND
  E9A4   0200 000B      	LI	R0,NAMSIZ		;FILENAME SIZE	
  E9A8   C083           	MOV	R3,R2		;R2 -> DIRECTORY ENTRY
  E9AA   C048           	MOV	R8,R1
  E9AC   0221 0012      	AI	R1,NAMEOFF2		;POINT TO 2ND FILE NAME
  E9B0   DCB1           RENAM1	MOVB	*R1+,*R2+		;COPY NEW FILE NAME OVER OLD ONE
  E9B2   0600           	DEC	R0
  E9B4   16FD           	JNE	RENAM1		;JUMP IF NOT DONE
                        ;
                        ; NOW WRITE THE NEW DIRECTORY ENTRY BACK
                        ;
  E9B6   2DA0 EC5A      	CALL	@WRDIR		;ALL DIRECTORY POINTERS UNTOUCHED FROM SEARCH1
  E9BA   2DC0           RENAM2	RET
                        ;
                        ;******************************
                        ;
                        ;	ERASE A	DIRECTORY ENTRY
                        ;
                        ;	R3 -> FCB
                        ;
                        ;	ON RETURN R1 = 0 FOR DIRECTORY ENTRY FOUND
                        ;		     = -1 FOR NO DIRECTORY ENTRY FOUND
                        ;
                        ;*******************************
                        ;
  E9BC   C203           ERAFIL:	MOV	R3,R8
  E9BE   2DA0 E828      	CALL	@SEARCH1 		;LOOK FOR THE FILE ENTRY
  E9C2   C041           	MOV	R1,R1 	 	;DID WE FIND IT ?
  E9C4   115A           	JLT	ERAERR 	 	;NO
  E9C6   0201 8000      	LI	R1,8000H		;R3->DIR ENTRY
  E9CA   F8C1 0000      	SOCB	R1,@NAM(R3)		;MAKE DELETED
  E9CE   CA23 000C      	MOV	@FSB(R3),@FSB(R8)	;RECOVER THE CHAIN HEAD BEFORE WRDIR CLOBBERS R3
  E9D2   000C           
  E9D4   2DA0 EC5A      	CALL	@WRDIR 	 	;PERSIST THE TOMBSTONE BEFORE FREEING ANY BLOCK
  E9D8   C041           	MOV	R1,R1
  E9DA   114F           	JLT	ERAERR			;A LIVE DIRECTORY ENTRY MUST NEVER POINT TO FREED BLOCKS
  E9DC   04E8 000E      	CLR	@FSZ(R8)		;ZERO MEANS RECLAIM THE COMPLETE CHAIN
  E9E0   2DA0 E9E6      	CALL	@RECLAIM
  E9E4   2DC0           	RET
                        
                        ;
                        ;---RELEASE UNUSED OR DELETED FILE BLOCKS
                        ;
                        ; FSZ=0: FREE THE COMPLETE CHAIN.
                        ; FSZ>0: KEEP CEILING(FSZ/SECBLK) BLOCKS AND FREE ANY TAIL.
                        ;
  E9E6   C0E8 000C      RECLAIM:	MOV	@FSB(R8),R3		;STARTING PHYSICAL BLOCK
  E9EA   0283 0002      	CI	R3,FIRSTBLK
  E9EE   1404           	JHE	RECLFSB
  E9F0   C028 000E      	MOV	@FSZ(R8),R0
  E9F4   1340           	JEQ	ERA03			;AN EMPTY LEGACY ENTRY MAY HAVE NO ALLOCATION
  E9F6   1041           	JMP	ERAERR			;A NONEMPTY FILE MUST HAVE A VALID CHAIN HEAD
  E9F8   0283 02CF      RECLFSB	CI	R3,MAXBLK
  E9FC   1B3E           	JH	ERAERR			;CORRUPT DIRECTORY ENTRY
                        
  E9FE   C028 000E      	MOV	@FSZ(R8),R0
  EA02   131D           	JEQ	RECLALL			;DELETE: FREE FROM THE FIRST BLOCK
                        
  EA04   0600           	DEC	R0			;FINAL USED BLOCK IS (FSZ-1)/SECBLK
  EA06   C0C0           	MOV	R0,R3
  EA08   2DA0 EAE2      	CALL	@RECTBC		;R2 = RELATIVE BLOCK TO RETAIN
  EA0C   2DA0 EB56      	CALL	@TRACE
  EA10   C020 EC7A      	MOV	@BATERR,R0
  EA14   1632           	JNE	ERAERR
  EA16   8081           	C	R1,R2			;CHAIN MUST REACH THE REQUIRED BLOCK
  EA18   1630           	JNE	ERAERR
                        
  EA1A   C0D7           	MOV	*R7,R3		;FIRST BLOCK AFTER THE RETAINED TAIL
  EA1C   0283 FF80      	CI	R3,LASTBLK
  EA20   1327           	JEQ	ERA02			;CHAIN IS ALREADY THE CORRECT LENGTH
  EA22   0283 0002      	CI	R3,FIRSTBLK
  EA26   1A29           	JL	ERAERR
  EA28   0283 02CF      	CI	R3,MAXBLK
  EA2C   1B26           	JH	ERAERR
  EA2E   0201 FF80      	LI	R1,LASTBLK
  EA32   C5C1           	MOV	R1,*R7		;TERMINATE THE RETAINED CHAIN
  EA34   0720 EC78      	SETO	@BATCHG
  EA38   0205 02CE      	LI	R5,NDATABLK		;BOUND THE TAIL WALK EVEN IF THE BAT CONTAINS A CYCLE
  EA3C   1004           	JMP	RECLLP
                        
  EA3E   C0E8 000C      RECLALL:	MOV	@FSB(R8),R3
  EA42   0205 02CE      	LI	R5,NDATABLK		;BOUND A COMPLETE-CHAIN RECLAIM
  EA46   0283 0002      RECLLP:	CI	R3,FIRSTBLK
  EA4A   1A17           	JL	ERAERR			;ZERO/RESERVED LINK IS CORRUPTION
  EA4C   0283 02CF      	CI	R3,MAXBLK
  EA50   1B14           	JH	ERAERR
  EA52   2DA0 EBAA      	CALL	@GETBATP
  EA56   C020 EC7A      	MOV	@BATERR,R0
  EA5A   160F           	JNE	ERAERR
  EA5C   C0D7           	MOV	*R7,R3		;SAVE NEXT LINK BEFORE CLEARING THIS ENTRY
  EA5E   04D7           	CLR	*R7			;MARK BLOCK FREE
  EA60   0720 EC78      	SETO	@BATCHG		;RDBAT WILL FLUSH BEFORE CHANGING PAGES
  EA64   0283 FF80      	CI	R3,LASTBLK
  EA68   1303           	JEQ	ERA02
  EA6A   0605           	DEC	R5
  EA6C   16EC           	JNE	RECLLP
  EA6E   1005           	JMP	ERAERR			;MORE LINKS THAN PHYSICAL DATA BLOCKS MEANS A CYCLE
                        
  EA70   2DA0 EC2A      ERA02	CALL	@WRBAT		;FLUSH THE FINAL DIRTY BAT PAGE
  EA74   2DC0           	RET
  EA76   04C1           ERA03	CLR	R1		;DONE / NOTHING TO RECLAIM
  EA78   2DC0           	RET	
  EA7A   0701           ERAERR	SETO	R1
  EA7C   2DC0           	RET
                        ;
                        ;*********************************
                        ;
                        ;	READ IN THE DIRECTORY
                        ;
                        ;	ENTER WITH  R8 -> FCB
                        ;
                        ;
                        ;*********************************
  EA7E   C0E0 E576      DIROPN:	MOV	@CDSECT,R3		;ASSUME CURRENT DIRECTORY SECTPR THIS HAS BEEN SET
  EA82   0200 0008      	LI	R0,DIR_LBA		;GET FIRST DIRECTORY LBA
  EA86   0A13           	SLA	R3,1		;2 LBAS PER SECTOR
  EA88   A0C0           	A	R0,R3		;R3 HOLDS THE LBA
                        ;	LI	R2,DIRBUFF 		;BUFFER TO USE
                        ;	CALL	@_SETDMA	 	;BIOS DMA
                        ;	CALL	@RDREC	 	;READ IN DIRECTORY
  EA8A   0204 EE7E      	LI	R4,DIRBUFF 		;BUFFER TO USE
                        
  EA8E   2DA0 F038      	CALL	@MRDDBR 	 	;READ IN DIRECTORY
  EA92   C041           	MOV	R1,R1
  EA94   1604           	JNE	DIROPNE			;NEVER EXPOSE STALE DIRECTORY BUFFER DATA
  EA96   0203 EE7E      	LI	R3,DIRBUFF		;USE SAME BUFFER
  EA9A   04C1           	CLR	R1
  EA9C   2DC0           	RET
  EA9E   0701           DIROPNE	SETO	R1
  EAA0   2DC0           	RET
                        ;
                        ;
                        ;==============================================================
                        ;	FIND THE NEXT DIRECTORY ENTRY
                        ;	DIRENT IS JUST AN OFFSET INTO THE 
                        ;	DIRECTORY BUFFER. ITS VALUUE DEPENDS ON 
                        ;	THE BLOCK SIZE.
                        ;
                        ;	R3 -> TO FILE DIRECTORY CONTENTS
                        ;===============================================================
                        ;
  EAA2   05A0 E570      DIRBLK:	INC	@DIRENT	 	;UP THE LAST ENTRY, INITIALISED TO -1
  EAA6   C0E0 E570      	MOV	@DIRENT,R3
  EAAA   0A53           	SLA	R3,5		;*32 IE 32 BYTES DIRECTORY ENTRY
  EAAC   0223 EE7E      	AI	R3,DIRBUFF		;POINT TO NEXT ENTRY
  EAB0   0283 F07E      	CI	R3,DIRBUFF+BUFSIZ	;HAVE WE REACHED THE END OF THE BUFFER
  EAB4   1A0F           	JL	DIRB01		;NO
  EAB6   05A0 E576      	INC	@CDSECT	 	;NOW - TRY NEXT SECTOR
  EABA   C0E0 E576      	MOV	@CDSECT,R3		;R3 HOLDS RECORD OFFSET WITHIN BLOCK
  EABE   0283 0004      	CI	R3,NDSECT		;NUMBER OF SECTORS ALLOCATED TO DIRECTORY
  EAC2   140B           	JHE	DIRB03		;SHOW END OF DIRECTORY
  EAC4   2DA0 EA7E      	CALL	@DIROPN		;READ THE DIRECTORY
  EAC8   C041           	MOV	R1,R1
  EACA   1107           	JLT	DIRB03			;PROPAGATE DIRECTORY I/O FAILURE
                        ;
                        ;
  EACC   0720 E570      	SETO	@DIRENT		;RESET FOR NEXT TIME
  EAD0   0203 EE7E      	LI	R3,DIRBUFF		;-->DIRECTORY ENTRY
  EAD4   04C1           DIRB01:	CLR	R1		;FLAG SET
  EAD6   C041           DIRB02:	MOV	R1,R1	 	;SET STATUS
  EAD8   2DC0           	RET
  EADA   0701           DIRB03:	SETO	R1
  EADC   10FC           	JMP	DIRB02
                        ;
                        ;******************************
                        ;
                        ;	CONVERT CRN TO BLOCK NUMBER (CRNTBC)
                        ;
                        ;	THIS ROUTINE SIMPLY DIVIDES RECORD NUMBER
                        ;	BY BLOCK SIZE TO GIVE A RELATIVE BLOCK NO
                        ;	SO THAT THE BAT MAY BE INDEXED VIA RESULT
                        ;	IN R2.
                        ;
                        ;*******************************
                        ;
  EADE   C0E8 001A      CRNTBC:	MOV	@CRN(R8),R3 	;NEXT RECORD TO READ
                        ;
                        ;	ENTER HERE IF GENERAL RELATIVE CONVERSION REQUIRED
                        ;	R3 MUST HOLD RECORD NUMBER - NOTE RELATIVE OFFSET WITHIN BLOCK IS FOUND
                        ;	RECORDS BEGIN AT 1
                        ;	BLOCKS BEGIN AT 0
                        ;
  EAE2   04C2           RECTBC	CLR	R2	 	;FOR DIVIDE
  EAE4   0200 0004      	LI	R0,SECBLK	 	;SECTORS/BLOCK
  EAE8   3C80           	DIV	R0,R2	 	;R2 & R3 HOLD RESULT
  EAEA   2DC0           RECTBC1	RET
                        ;
                        ;------------------------------------------------------------------------
                        ;
                        ;	BLOCK NO. TO TRK/SECT CONVERSION
                        ;
                        ;	THIS ROUTINE WILL CONVERT A GIVEN BLOCK AND
                        ;	AND RECORD NUMBER WITHIN A FILE TO A PHYSICAL
                        ;	TRACK AND SECTOR. I.E. YOU MAY WISH TO LOCATE
                        ;	THE TRACK/SECTOR OF SAY RECORD 3 WITHIN BLOCK
                        ;	10 ETC.
                        ;
                        ;	THIS ROUTINE IS NORMALLY CALLED AFTER A CALL
                        ;	TO CRNTBC/RECTBC WITHIN RDSEQ ,WRSEQ ETC.
                        ;
                        ;	R1 = BLOCK NO.
                        ;	R3 = RECORD OFFSET WITHIN BLOCK
                        ;
                        ;	RECORDS BEGIN AT 1
                        ;	BLOCKS BEGIN AT 0
                        ;
                        ;	RETURN WITH R2=TRACK,R3=SECTOR
                        ;
                        ;	TRK = INT((BLK*SECBLK + R3)/SECTRK)
                        ;	SECT = REMAINDER(BLK...)+1		
                        ;
                        ;	R2 = TRK, R3 = SECT
                        ;
                        ; NOTE NEEDED TO REMOVE THE MULTIPY AS IT HAS A BUG.  SEE 99105 ERRATA
                        ;------------------------------------------------------------------------
                        ;
                        ;REVISED MULTIPLY TO AVOID 99105 MULTIPLY BUG
                        ;
                        
                        ;BTTSC	LI	R0,SECBLK
                        ;	CLR	R2
                        ;	JEQ	BTTSC2
                        ;BTTSC1	A	R1,R2		;R2=BLK*SECBLK
                        ;	DEC	R0
                        ;	JNE	BTTSC1
                        ;BTTSC2	A	R2,R3		;R3=BLK*SECBLK+R3
                        ;	CLR	R2		;MSB OF QUOTIENT
                        ;	LI	R0,SECTRK		;SECTORS/TRACK
                        ;	DIV	R0,R2	 	;R2=TRK,R3=SECT (R2+R3)/R0
                        ;	INC	R3		;TAKES CARE OF ZERO OFFSET FOR CRN
                        ;BTTSC0	RET
                        ;
                        ;*******************************
                        ;
                        ;	
                        ;	FIND A FREE BLOCK	
                        ;	NXTBLK WILL TRAVERSE THE BAT LOOKING FOR A ZEROED
                        ;	BAT ENTRY.  ONCE FOUND NO CHANGE TO THE BAT WILL BE
                        ;	MADE AND ONLY THE POINTERS TO THE ENTRY WILL BE RETURNED.
                        ;	IT IS THEN UP TO THE CALLING PROGRAMME TO INSERT THE NEW
                        ;	LINKS.
                        ;
                        ;	NOTE: RDBAT WILL PULL IN THE APPROPRIATE BAT SECTOR AS REQUIRED
                        ;
                        ;	R8 -> FCB
                        ;
                        ;	R1 = -1 (ERROR)
                        ;	R1 = 0  (GOOD RESULT)
                        ;	
                        ;
                        ;****************************************************************
                        ;
  EAEC   C020 E568      NXTBLK:	MOV	@CAB,R0			;BEGIN NEAR THE MOST RECENT ALLOCATION
  EAF0   0280 0002      	CI	R0,FIRSTBLK
  EAF4   1A03           	JL	NXTBLK0
  EAF6   0280 02CF      	CI	R0,MAXBLK
  EAFA   1202           	JLE	NXTBLK1
  EAFC   0200 0002      NXTBLK0	LI	R0,FIRSTBLK
  EB00   0205 02CE      NXTBLK1	LI	R5,NDATABLK		;SCAN EACH DATA BLOCK AT MOST ONCE
                        
  EB04   C0C0           NXTBLK2	MOV	R0,R3
  EB06   2DA0 EBAA      	CALL	@GETBATP			;FIND THE BAT AND GET THE POINTER FROM THE INDEX
  EB0A   C060 EC7A      	MOV	@BATERR,R1
  EB0E   160F           	JNE	NXTBLK3			;READ/BOUNDS ERROR
  EB10   C057           	MOV	*R7,R1			;POINTER IS IN R7
  EB12   1309           	JEQ	NXTBLK4			;FREE BLOCK FOUND
                        
  EB14   0605           	DEC	R5
  EB16   130A           	JEQ	NXTBLK5			;FULL SCAN: DISK IS FULL
  EB18   0580           	INC	R0			;NEXT BLOCK
  EB1A   0280 02CF      	CI	R0,MAXBLK
  EB1E   12F2           	JLE	NXTBLK2
  EB20   0200 0002      	LI	R0,FIRSTBLK		;WRAP SO FREED LOW BLOCKS ARE REUSED
  EB24   10EF           	JMP	NXTBLK2
                        ;
                        ; R7 -> FREE BLOCK
                        ; R6 = FREE BLOCK NUMBER
                        ;
  EB26   C180           NXTBLK4	MOV	R0,R6			;COPY FREE BLOCK NUMBER HERE
  EB28   04C1           	CLR	R1			;SHOW SUCCESS
  EB2A   2DC0           	RET
  EB2C   0701           NXTBLK5	SETO	R1			;NO FREE DATA BLOCK
  EB2E   C041           NXTBLK3	MOV	R1,R1			;RETURN WITH RESULT CONDITION SET
  EB30   2DC0           	RET 
                        ;
                        ;****************************
                        ;
                        ;	READ A RANDOM RECORD
                        ;	R8 -> FCB
                        ;	R3 -> LBA
                        ;
                        ;******************************
                        
  EB32   C120 E574      RDREC:	MOV	@DMAADDR,R4     ;DMA ADDRESS
  EB36   2DA0 F020      	CALL	@MRDREC	 	;READ THE RECORD IN
  EB3A   C041           	MOV	R1,R1	 	;ERROR ?
  EB3C   1301           	JEQ	RDREC1	 	;NO
  EB3E   0701           	SETO	R1	 	;SHOW ERROR
  EB40   C041           RDREC1	MOV	R1,R1
  EB42   2DC0           	RET
                        
                        	;
                        ;****************************
                        ;
                        ;	READ A DIRECTORY/BAT RECORD
                        ;	R4 -> BUFFER
                        ;	R3 -> LBA
                        ;
                        ;******************************
                        
                        ;RDDBR:	CALL	@MRDDBR	 	;READ THE RECORD IN
                        ;	MOV	R1,R1	 	;ERROR ?
                        ;	JEQ	RDDBR1	 	;NO
                        ;	SETO	R1	 	;SHOW ERROR
                        ;RDDBR1	MOV	R1,R1
                        ;	RET
                        ;
                        ;
                        ;******************************
                        ;
                        ;	WRITE A RANDOM RECORD
                        ;	R8 -> FCB
                        ;	R3 -> LBA
                        ;
                        ;*****************************
                        ;
  EB44   C120 E574      WRREC:	MOV	@DMAADDR,R4
                        ;	CLR R1
  EB48   2DA0 F024      	CALL	@MWRREC
  EB4C   C041           	MOV	R1,R1	
  EB4E   1301           	JEQ	WRREC_X
  EB50   0701           	SETO	R1
                        
  EB52   C041           WRREC_X	MOV	R1,R1
  EB54   2DC0           	RET
                        ;******************************
                        ;
                        ;	WRITE A DIRECTORY BAT RECORD
                        ;	R4 -> BUFFER ADDRESS
                        ;	R3 -> LBA
                        ;
                        ;*****************************
                        ;
                        ;WRDBR:	CALL	@MWRDBR
                        ;	MOV	R1,R1
                        ;	JEQ	WRDBR_X
                        ;	SETO	R1
                        ;WRDBR_X	MOV	R1,R1
                        ;	RET
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        ;
                        ;*************************************************
                        ;*
                        ;*   TRACE THE FILES LINKED LIST AND FIND THE 
                        ;*   BAT ENTRY CORRESPONDING TO THE FILE'S NTH
                        ;*   BLOCK.
                        ;*   ENTER WITH FILES RELATIVE RECORD IN R2 (SET TO -1 IF LAST LINK REQUIRED)
                        ;*   EXIT  WITH DBN (DISK BLOCK NUMBER ) POINTER IN R7
                        ;*   AND WITH R1=R2 IF MATCH TO R1 AND R1=0FFF8 IF LAST LINK
                        ;*
                        ;*   CALL TRACES WITH FSB/CAB DURING WRSEQ TO SPEED UP TRACE
                        ;*
                        ;**************************************************
                        ;
  EB56   C0E8 000C      TRACE:	MOV	@FSB(R8),R3		;GET FIRST FILE BLOCK - THIS IS THE START OF THE LINK
  EB5A   0283 0002      	CI	R3,FIRSTBLK
  EB5E   1A1C           	JL	TRACE2
  EB60   0283 02CF      	CI	R3,MAXBLK
  EB64   1B19           	JH	TRACE2
                        
  EB66   04C1           	CLR	R1		;COUNTER
  EB68   0205 02CE      	LI	R5,NDATABLK		;A VALID CHAIN CANNOT EXCEED THE DATA-BLOCK COUNT
  EB6C   2DA0 EBAA      TRACE1	CALL	@GETBATP		;GET THE BLOCK POINTER TO REQUESTED BAT ENTRY IN R7
  EB70   C020 EC7A      	MOV	@BATERR,R0
  EB74   1611           	JNE	TRACE2
  EB76   C117           	MOV	*R7,R4		;GET NEXT ALLOCATION LINK
  EB78   0284 FF80      	CI	R4,LASTBLK		;IS IT THE LAST BLOCK ?
  EB7C   1311           	JEQ	TRACE3		;YES
  EB7E   8081           	C	R1,R2		;HAVE WE REACHED THE WANTED BLOCK YET ?
  EB80   130F           	JEQ	TRACE3		;YES
  EB82   0284 0002      	CI	R4,FIRSTBLK
  EB86   1A08           	JL	TRACE2			;RESERVED/ZERO LINK IS CORRUPTION
  EB88   0284 02CF      	CI	R4,MAXBLK
  EB8C   1B05           	JH	TRACE2
  EB8E   0605           	DEC	R5
  EB90   1303           	JEQ	TRACE2			;CYCLE OR IMPOSSIBLY LONG CHAIN
  EB92   0581           	INC	R1		;BUMP THE RECORD POINTER
  EB94   C0C4           	MOV	R4,R3		;GET THE LINK AND KEEP GOING
  EB96   10EA           	JMP	TRACE1
  EB98   0720 EC7A      TRACE2	SETO	@BATERR
  EB9C   0701           	SETO	R1
  EB9E   2DC0           	RET
  EBA0   C807 E56A      TRACE3	MOV	R7,@CBP		;CURRENT BLOCK POINTER
  EBA4   C803 E568      	MOV	R3,@CAB		;AND CURRENT NUMBER
  EBA8   2DC0           	RET
                        ;
                        ; GETBATP (GET BAT POINTER) CHECK TO SEE IF THE BAT NUMBER (WHICH WILL
                        ; INDEX INTO THE BAT) PASSED
                        ; IN R3 LIES WITHIN THE RANGE OF THE CURRENT
                        ; BAT WHICH IS IN MEMORY. IF NOT IT WILL READ
                        ; THE APPRORIATE BAT INTO THE BUFFER
                        ; R7 WILL BE RETURNED AS A POINTER TO THE INDEXED ELEMENT
                        ; REGISTERS R0->R5 ARE PRESERVED
                        ;
                        ;
  EBAA   04E0 EC7A      GETBATP: 	CLR	@BATERR
  EBAE   2D05           	PUSHREG	R5
  EBB0   C043           	MOV	R3,R1		;THIS IS THE PHYSICAL BLOCK NUMBER
  EBB2   0281 02CF      	CI	R1,MAXBLK
  EBB6   1B11           	JH	FBATERR			;NEVER ADDRESS THE SENTINEL OR DIRECTORY LBAS
  EBB8   0981           	SRL	R1,BATSF		;256 BLOCKS PER BAT PAGE
  EBBA   8801 E56E      	C	R1,@CBSECT		;CURRENT BAT PAGE IN MEMORY
  EBBE   1305           	JEQ	FBAT0		;IN MEMORY
                        ; R1 HOLDS BAT PAGE TO BE READ IN
  EBC0   2DA0 EBE6      	CALL	@RDBAT		;FLUSH OLD PAGE AND LOAD REQUESTED PAGE
  EBC4   C181           	MOV	R1,R6		;R0-R5 WILL BE RESTORED BY POPREG
  EBC6   C186           	MOV	R6,R6
  EBC8   1108           	JLT	FBATERR
                        
  EBCA   2D45           FBAT0	POPREG	R5		;RESTORE R3 AND THE CALLER'S WORKING REGISTERS
  EBCC   C1C3           	MOV	R3,R7
  EBCE   0247 00FF      	ANDI	R7,BATMSK		;INDEX WITHIN THE 256-ENTRY PAGE FIRST
  EBD2   0A17           	SLA	R7,1		;THEN CONVERT WORD INDEX TO BYTE OFFSET
  EBD4   0227 EC7E      	AI	R7,BATBUFF		;R7->INDEXED ELEMENT
  EBD8   2DC0           	RET			;ALL IS OKAY
                        
  EBDA   0720 EC7A      FBATERR	SETO	@BATERR
  EBDE   2D45           	POPREG	R5
  EBE0   0207 EC7E      	LI	R7,BATBUFF		;SAFE POINTER; CALLERS MUST TEST BATERR
  EBE4   2DC0           	RET
                        
                        ;
                        ;	READ IN THE BAT
                        ;	R1 HOLDS BAT PAGE TO READ (0, 1 OR 2)
                        ;	THE OLD PAGE IS RETAINED IF FLUSH OR READ FAILS.
                        ;
  EBE6   8801 E56E      RDBAT:	C	R1,@CBSECT		;IF REQUESTED PAGE IS ALREADY IN MEMORY EXIT
  EBEA   131A           	JEQ	RDBATOK
  EBEC   0281 0002      	CI	R1,LASTBAT
  EBF0   1B1A           	JH	RDBATER
  EBF2   064A           	DECT	SP
  EBF4   C681           	MOV	R1,*SP		;PRESERVE REQUESTED PAGE
                        
  EBF6   C020 EC78      	MOV	@BATCHG,R0
  EBFA   1304           	JEQ	RDBAT1
  EBFC   2DA0 EC2A      	CALL	@WRBAT		;DIRTY PAGE MUST REACH DISK BEFORE REPLACEMENT
  EC00   C041           	MOV	R1,R1
  EC02   1110           	JLT	RDBATF			;LEAVE OLD PAGE AND DIRTY FLAG INTACT
                        
  EC04   C09A           RDBAT1	MOV	*SP,R2
  EC06   0203 0002      	LI	R3,BAT_LBA
  EC0A   0A12           	SLA	R2,1		;2 LBAS PER 512-BYTE BAT PAGE
  EC0C   A0C2           	A	R2,R3
  EC0E   0204 EC7E      	LI	R4,BATBUFF
  EC12   2DA0 F038      	CALL	@MRDDBR
  EC16   C041           	MOV	R1,R1
  EC18   1605           	JNE	RDBATF			;DO NOT CLAIM A FAILED READ IS CACHED
  EC1A   C0BA           	MOV	*SP+,R2
  EC1C   C802 E56E      	MOV	R2,@CBSECT		;PUBLISH CACHE ID ONLY AFTER SUCCESSFUL READ
  EC20   04C1           RDBATOK	CLR	R1
  EC22   2DC0           	RET
  EC24   05CA           RDBATF	INCT	SP
  EC26   0701           RDBATER	SETO	R1
  EC28   2DC0           	RET
                        
                        ;
                        ;	WRITE OUT THE CURRENT DIRTY BAT PAGE
                        ;
  EC2A   C020 EC78      WRBAT:	MOV	@BATCHG,R0
  EC2E   1311           	JEQ	WRBATOK			;NOTHING TO COMMIT
  EC30   C0A0 E56E      	MOV	@CBSECT,R2
  EC34   0282 0002      	CI	R2,LASTBAT
  EC38   1B0E           	JH	WRB_ERR			;ALSO CATCHES CBSECT=-1 AS UNSIGNED HIGH
  EC3A   0203 0002      	LI	R3,BAT_LBA
  EC3E   0A12           	SLA	R2,1		;2 LBAS PER SECTOR
  EC40   A0C2           	A	R2,R3
  EC42   0204 EC7E      	LI	R4,BATBUFF		;USE SAME BUFFER
  EC46   2DA0 F03C      	CALL	@MWRDBR
  EC4A   C041           	MOV	R1,R1
  EC4C   1604           	JNE	WRB_ERR
  EC4E   04E0 EC78      	CLR	@BATCHG		;CLEAR DIRTY FLAG ONLY AFTER A SUCCESSFUL WRITE
  EC52   04C1           WRBATOK	CLR	R1
  EC54   2DC0           	RET
  EC56   0701           WRB_ERR	SETO	R1			;KEEP BATCHG SET SO THE PAGE CAN BE RETRIED
  EC58   2DC0           	RET
                        
                        ;
                        ;
                        ;  WRITE OUT THE DIRECTORY TO THE DISC.
                        ;  R8 HOLDS THE FCB
                        ;
                        ;DB_WRDIR:	TEXT	"WRDIR"	;TEMP FOR DEBUG
                        ;	WORD	0
                        ;	EVEN
  EC5A   C0E0 E576      WRDIR:	MOV	@CDSECT,R3		;R3 HOLDS RECORD OFFSET WITHIN BLOCK
  EC5E   0A13           	SLA	R3,1		;TWO LBAS PER SECTOR
  EC60   0200 0008      	LI	R0,DIR_LBA		;FIRST DIRECTORY ENTRY LBA VALUE
  EC64   A0C0           	A	R0,R3
  EC66   0204 EE7E      	LI	R4,DIRBUFF
                        ;
                        ; CALL TO MWRREC
                        ; R3 HOLDS THE LSB OF THE LBA VALUE FOR THE SECTOR WE WANT TO READ OR WRITE
                        ; R4 HOLDS THE BUFFER ADDRESS
                        ;
  EC6A   2DA0 F03C      	CALL	@MWRDBR
  EC6E   C041           	MOV	R1,R1
  EC70   1301           	JEQ	WRD_X
  EC72   0701           	SETO	R1
                        
  EC74   C041           WRD_X	MOV	R1,R1
  EC76   2DC0           	RET
                        
                        ;
                        ;======================================================
                        ;	MAP THE TRACK NUMBER IN R2 TO
                        ;	EITHER SIDE 0 OR SIDE 1
                        ;
                        ;	RETURN IN R2 AND @TRACK
                        ;========================================================
                        ;
                        ;SETTRK:	CI	R2,TRKDSK		;CHECK FOR SIDE 2
                        ;	JLT	SETTRK1
                        ;	AI	R2,-2*TRKDSK
                        ;	INC	R2
                        ;	NEG	R2
                        ;	ORI	R2,8000H		;SET MSB TO INDICATE SIDE 1
                        ;SETTRK1:
                        ;	MOV	R2,@TRACK
                        ;	RET
                        ;
                        ;
                        ;	BUFFERS ETC
                        ;
                        ;	THE FLAG BATCHG(BIT MAP CHANGE) IS SET WHENEVER AN ALLOCATION
                        ;	BIT IN THE BLOCK ALLOCATION TABLE (BAT)HAS BEEN 
                        ;	CLEARED/ALLOCATED. THIS ENSURES THAT THE BAT
                        ;	WILL NOT BE OVERWRITTEN BY THE DISK VERSION OF THE BIT MAP.
                        ;	THIS FLAG IS CLEARED ONCE A BIT MAP DISK WRITE IS FORCED BY
                        ;	A FILE CLOSURE OR A DIRECTORY FSB BEING REQUESTED.
                        ;
  EC78   0000           BATCHG:	WORD	0		;BAT CHANGE FLAG
  EC7A   0000           BATERR:	WORD	0		;LAST GETBATP/TRACE STRUCTURAL OR I/O ERROR
  EC7C   0000           MCNT:	WORD	0		;BYTES LEFT IN BUFFER
                        
                        
                        
                        
                        
  EC7E                  BATBUFF:	BSS	BUFSIZ		;BAT BUFFER
  EE7E                  DIRBUFF:	BSS	BUFSIZ		;DIRECTORY BUFFER - MUST NOT ALIAS MLBUF
                        INTBUFF:
  F07E                  MLBUF:	BSS	2		;WORKING BUILD RESERVES FOLLOWING RAM FOR 512-BYTE MODULE I/O
                        ;
  F080                  	END

No error(s).
