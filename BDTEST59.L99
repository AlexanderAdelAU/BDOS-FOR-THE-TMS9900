                        ;
                        ;-----------------------------------------------------------------------
                        ; BDTEST59 - BDOS 5.9 sequential and random file integrity tester
                        ;
                        ; Written for Alexander Cameron's TMS9900/TMS99000 CP/M-style system.
                        ; Calling conventions and low-memory pointers follow XMODEM57.A99.
                        ;
                        ; DESTRUCTIVE ONLY TO THE FILE:  BDTEST.DAT
                        ;
                        ; Menu tests:
                        ;   S = 5 records       - basic allocation-chain extension
                        ;   B = 505 records     - crosses physical block 127 -> 128
                        ;   P = 1017 records    - crosses BAT page 0 -> 1 (block 256)
                        ;   2 = 2041 records    - crosses BAT page 1 -> 2 (block 512)
                        ;   F = fill remaining free space, verify it, and check clean disk full
                        ;   R = random read/write, cursor, size, EOF and allocation-boundary tests
                        ;   X = PSEL disk-I/O stress: randomized reads/writes with PSEL enabled,
                        ;       DMA-buffer guards, mapper preservation, periodic close/reopen, and
                        ;       a PSEL-off control reread when corruption is detected.
                        ;   A = S, B, P, 2 and R in sequence; each file is deleted before next test
                        ;   Q = quit
                        ;
                        ; Every 512-byte record contains:
                        ;   word 0: >B059
                        ;   word 1: zero-based logical record number
                        ;   word 2: one's complement of the record number
                        ;   words 3..255: record number + word index
                        ;
                        ; The tester checks WRSEQ/FSZ/CRN, closes and reopens the file, verifies
                        ; every word through RDSEQ, verifies EOF, then erases the file.  The F test
                        ; also verifies that the first rejected append does not change FSZ or CRN.
                        ;
                        ; Sequential scope: allocation, BAT page changes, close/open, EOF, deletion
                        ; and block reclamation.  Random scope: functions 33-36 using RELB=0 and
                        ; RELR as the 16-bit absolute record number.  Sparse random writes are
                        ; expected to fail; overwrite and append exactly at EOF are expected to work.
                        ;-----------------------------------------------------------------------
                        ;
                        ; Monitor XOPs used by existing applications.
                        ;
                                DXOP    PSEL_DIS,0
                                DXOP    PSEL_EN,1
                                DXOP    CALL,6
                                DXOP    RET,7
                                DXOP    PUSH,8
                                DXOP    POP,9
                                DXOP    WHEX,10
                        ;
                        ; Register equates.
                        ;
  0000                  R0      EQU     0
  0001                  R1      EQU     1
  0002                  R2      EQU     2
  0003                  R3      EQU     3
  0004                  R4      EQU     4
  0005                  R5      EQU     5
  0006                  R6      EQU     6
  0007                  R7      EQU     7
  0008                  R8      EQU     8
  0009                  R9      EQU     9
  000A                  SP      EQU     10
  000B                  R11     EQU     11
  000C                  R12     EQU     12
                        ;
                        ; Operating-system pointers and entry values, matching XMODEM57.A99.
                        ;
  0500                  TPA     EQU     00500H
  0080                  SHELL   EQU     080H            ; low-memory pointer to shell entry
  0084                  BDOS    EQU     084H            ; low-memory pointer to BDOS entry
                        ;
                        ; BDOS functions.
                        ;
  0001                  CIN     EQU     1
  0002                  COUT    EQU     2
  000F                  OPEN    EQU     15
  0010                  FCLOSE  EQU     16
  0013                  ERAFIL  EQU     19
  0014                  RDSEQ   EQU     20
  0015                  WRSEQ   EQU     21
  0016                  MAKFIL  EQU     22
  001A                  SETDMA  EQU     26
  0021                  RDRND   EQU     33
  0022                  WRRND   EQU     34
  0023                  GETSIZ  EQU     35
  0024                  SETREL  EQU     36
                        ;
                        ; FCB offsets used by BDOS59.
                        ;
  0000                  NAM     EQU     0
  000B                  FTY     EQU     11
  000C                  FSB     EQU     12
  000E                  FSZ     EQU     14
  0010                  FLA     EQU     16
  0014                  LRBL    EQU     20
  0018                  CBN     EQU     24
  001A                  CRN     EQU     26
  001C                  RELB    EQU     28
  001E                  RELR    EQU     30
  0024                  FCBSIZ  EQU     36
                        ;
                        ; Test constants.
                        ;
  0200                  BYTSEC  EQU     512
  0100                  NWORDS  EQU     BYTSEC/2
  00FD                  PATWORDS EQU    NWORDS-3
  B059                  MAGIC   EQU     0B059H
  0002                  FIRSTBLK EQU    2
  02CF                  MAXBLK  EQU     719
  0B38                  FULLRECS EQU     2872
  000C                  RANDRECS EQU     12              ; three complete allocation blocks
  0006                  RANDCUR  EQU     6               ; sequential cursor sentinel
  A504                  ALTPAT   EQU     0A504H          ; replacement pattern for logical record 4
                        ;
                        ; PSEL disk stress constants.  Symbols are <=15 chars for the legacy assembler.
                        ; The stress file is preallocated to 64 records
                        ; and then subjected to 1024 pseudo-random operations.  Every random write is
                        ; immediately checked for DMA-buffer mutation and read back.  Every 32
                        ; iterations the file is closed and reopened while PSEL remains enabled.
                        ;
  80C0                  MAP_BASE_PORT EQU 080C0H
  0002                  MAPWIDTH EQU     2
  0040                  STRESS_RECS EQU  64
  0400                  STRESS_ITERS EQU 1024
                        ; X-mode DMA lives in otherwise-unused SEG11.  Only this segment is mapped
                        ; away from PAGE0, so BDTEST code/data remain in the flat bank while disk I/O
                        ; is forced to use a genuinely paged DMA address.
  000B                  ST_DMA_SEG EQU   11
  0002                  ST_DMA_PAGE EQU  2
  80D6                  ST_DMA_CRU EQU   MAP_BASE_PORT+(ST_DMA_SEG*2)
  B100                  ST_DMA EQU       0B100H
  B0E0                  ST_GLO EQU       0B0E0H
  B300                  ST_GHI EQU       0B300H
  001F                  ST_REOPEN_MSK EQU 001FH
  D15C                  STRESS_MAGIC EQU  0D15CH
  ACE1                  STRESS_RNG_INIT EQU 0ACE1H
  5A5A                  STRESS_SEED_XOR EQU 05A5AH
                        ; PSEL-only RAM copy diagnostic.  MC_SRC is the common 512-byte area
                        ; immediately below the TPA; SEG11/PAGE2 is the mapped destination.
  0300                  MC_SRC  EQU       00300H
  0400                  MC_ITERS EQU      1024
  0008                  GUARD_WORDS EQU  8
  1357                  GUARD_LO_PAT EQU  01357H
  ECA8                  GUARD_HI_PAT EQU  0ECA8H
                        ;
                        ; Failure identifiers printed in hexadecimal.
                        ;
  0001                  E_MAKE  EQU     1
  0002                  E_FSB   EQU     2
  0003                  E_WRITE EQU     3
  0004                  E_WFCB  EQU     4
  0005                  E_CLOSE EQU     5
  0006                  E_OPEN  EQU     6
  0007                  E_SIZE  EQU     7
  0008                  E_READ  EQU     8
  0009                  E_DATA  EQU     9
  000A                  E_EOF   EQU     10
  000B                  E_ERASE EQU     11
  000C                  E_FULL  EQU     12
  000D                  E_FSTATE EQU    13
  000E                  E_RSETREL EQU   14
  000F                  E_RGETSIZ EQU   15
  0010                  E_RREAD  EQU     16
  0011                  E_RDATA  EQU     17
  0012                  E_RCURSOR EQU    18
  0013                  E_RSIZE  EQU     19
  0014                  E_RWRITE EQU     20
  0015                  E_REOF   EQU     21
  0016                  E_RRELB  EQU     22
  0017                  E_RSPARSE EQU    23
                        ; PSEL stress failure identifiers.
  0018                  E_PCREATE EQU     24
  0019                  E_PSEED EQU       25
  001A                  E_PWRITE EQU      26
  001B                  E_PREAD EQU       27
  001C                  E_PDATA EQU       28
  001D                  E_PSTATE EQU      29
  001E                  E_PGUARD EQU      30
  001F                  E_PMAP EQU        31
  0020                  E_PCLOSE EQU      32
  0021                  E_POPEN EQU       33
  0022                  E_PSIZE EQU       34
  0023                  E_PDELETE EQU     35
  0024                  E_PSHADOW EQU     36
  0025                  E_PWBUF EQU       37
                        ;
  0500                          AORG    TPA
  0500   1000                   JMP     START
                        ;
                        ;-----------------------------------------------------------------------
                        ; Main menu.
                        ;-----------------------------------------------------------------------
                        START:
  0502   2C00                   PSEL_DIS                 ; normal tests start from a known safe state
  0504   0200 217C              LI      R0,BANNER
  0508   2DA0 2160              CALL    @PRINTMSG
                        
                        MENU:
  050C   0200 21CC              LI      R0,MENU_MSG
  0510   2DA0 2160              CALL    @PRINTMSG
  0514   0202 0001              LI      R2,CIN
  0518   04C3                   CLR     R3
  051A   2DA0 0084              CALL    @BDOS            ; character returned in low byte of R1
  051E   C201                   MOV     R1,R8             ; preserve choice outside shared R0-R7
  0520   0248 00FF              ANDI    R8,00FFH           ; retain only the console character
                        
  0524   0203 000D              LI      R3,00DH
  0528   2DA0 2172              CALL    @PUTC
  052C   0203 000A              LI      R3,00AH
  0530   2DA0 2172              CALL    @PUTC
                        
                        ; Test the numeric option before clearing ASCII lower-case bit 5.
                        ; Applying 00DFH to '2' (0032H) would incorrectly turn it into 0012H.
  0534   0288 0032              CI      R8,'2'
  0538   1340                   JEQ     MENU_2
                        
  053A   0248 00DF              ANDI    R8,00DFH           ; force alphabetic choices to uppercase
  053E   0288 0051              CI      R8,'Q'
  0542   1602                   JNE     MENU_NOT_Q
  0544   0460 065E              B       @EXIT
                        MENU_NOT_Q:
  0548   0288 0053              CI      R8,'S'
  054C   131B                   JEQ     MENU_S
  054E   0288 0042              CI      R8,'B'
  0552   1321                   JEQ     MENU_B
  0554   0288 0050              CI      R8,'P'
  0558   1327                   JEQ     MENU_P
  055A   0288 0046              CI      R8,'F'
  055E   1336                   JEQ     MENU_F
  0560   0288 0052              CI      R8,'R'
  0564   133D                   JEQ     MENU_R
  0566   0288 004D              CI      R8,'M'
  056A   1340                   JEQ     MENU_M
  056C   0288 0058              CI      R8,'X'
  0570   1343                   JEQ     MENU_X
  0572   0288 0041              CI      R8,'A'
  0576   1346                   JEQ     MENU_A
                        
  0578   0200 2214              LI      R0,BAD_KEY
  057C   2DA0 2160              CALL    @PRINTMSG
  0580   0460 050C              B       @MENU
                        
                        MENU_S:
  0584   0200 0005              LI      R0,5
  0588   04C1                   CLR     R1
  058A   2DA0 066E              CALL    @RUNTEST
  058E   C041                   MOV     R1,R1
  0590   115F                   JLT     FAIL_EXIT
  0592   0460 050C              B       @MENU
                        
                        MENU_B:
  0596   0200 01F9              LI      R0,505
  059A   04C1                   CLR     R1
  059C   2DA0 066E              CALL    @RUNTEST
  05A0   C041                   MOV     R1,R1
  05A2   1156                   JLT     FAIL_EXIT
  05A4   0460 050C              B       @MENU
                        
                        MENU_P:
  05A8   0200 03F9              LI      R0,1017
  05AC   04C1                   CLR     R1
  05AE   2DA0 066E              CALL    @RUNTEST
  05B2   C041                   MOV     R1,R1
  05B4   114D                   JLT     FAIL_EXIT
  05B6   0460 050C              B       @MENU
                        
                        MENU_2:
  05BA   0200 07F9              LI      R0,2041
  05BE   04C1                   CLR     R1
  05C0   2DA0 066E              CALL    @RUNTEST
  05C4   C041                   MOV     R1,R1
  05C6   1144                   JLT     FAIL_EXIT
  05C8   0460 050C              B       @MENU
                        
                        MENU_F:
  05CC   0200 0B38              LI      R0,FULLRECS
  05D0   0201 0001              LI      R1,1              ; request the expected disk-full check
  05D4   2DA0 066E              CALL    @RUNTEST
  05D8   C041                   MOV     R1,R1
  05DA   113A                   JLT     FAIL_EXIT
  05DC   0460 050C              B       @MENU
                        
                        MENU_R:
  05E0   2DA0 06EA              CALL    @RUN_RANDOM
  05E4   C041                   MOV     R1,R1
  05E6   1134                   JLT     FAIL_EXIT
  05E8   0460 050C              B       @MENU
                        
                        MENU_M:
  05EC   2DA0 07DE              CALL    @RUN_PSEL_MEM
  05F0   C041                   MOV     R1,R1
  05F2   112E                   JLT     FAIL_EXIT
  05F4   0460 050C              B       @MENU
                        
                        MENU_X:
  05F8   2DA0 0982              CALL    @RUN_PSEL_STRESS
  05FC   C041                   MOV     R1,R1
  05FE   1128                   JLT     FAIL_EXIT
  0600   0460 050C              B       @MENU
                        
                        MENU_A:
  0604   0200 2226              LI      R0,ALL_MSG
  0608   2DA0 2160              CALL    @PRINTMSG
  060C   0200 0005              LI      R0,5
  0610   04C1                   CLR     R1
  0612   2DA0 066E              CALL    @RUNTEST
  0616   C041                   MOV     R1,R1
  0618   111B                   JLT     FAIL_EXIT
  061A   0200 01F9              LI      R0,505
  061E   04C1                   CLR     R1
  0620   2DA0 066E              CALL    @RUNTEST
  0624   C041                   MOV     R1,R1
  0626   1114                   JLT     FAIL_EXIT
  0628   0200 03F9              LI      R0,1017
  062C   04C1                   CLR     R1
  062E   2DA0 066E              CALL    @RUNTEST
  0632   C041                   MOV     R1,R1
  0634   110D                   JLT     FAIL_EXIT
  0636   0200 07F9              LI      R0,2041
  063A   04C1                   CLR     R1
  063C   2DA0 066E              CALL    @RUNTEST
  0640   C041                   MOV     R1,R1
  0642   1106                   JLT     FAIL_EXIT
  0644   2DA0 06EA              CALL    @RUN_RANDOM
  0648   C041                   MOV     R1,R1
  064A   1102                   JLT     FAIL_EXIT
  064C   0460 050C              B       @MENU
                        
                        FAIL_EXIT:
  0650   0200 2A42              LI      R0,STOP_MSG
  0654   2DA0 2160              CALL    @PRINTMSG
  0658   0701                   SETO    R1               ; shell return code indicates failure
  065A   0460 0080              B       @SHELL
                        
                        EXIT:
  065E   2C00                   PSEL_DIS
  0660   0200 2A7C              LI      R0,BYE_MSG
  0664   2DA0 2160              CALL    @PRINTMSG
  0668   04C1                   CLR     R1               ; shell return code
  066A   0460 0080              B       @SHELL
                        ;
                        ;-----------------------------------------------------------------------
                        ; RUNTEST
                        ;   R0 = number of 512-byte records
                        ;   R1 = nonzero to test one additional write as expected disk-full
                        ; Returns R1 = 0 pass, -1 fail.
                        ;-----------------------------------------------------------------------
                        RUNTEST:
  066E   C800 2A98              MOV     R0,@TARGET_RECS
  0672   C801 2A9A              MOV     R1,@FULFLG
  0676   04E0 2A9E              CLR     @FAIL_ID
  067A   04E0 2AA0              CLR     @LAST_STATUS
  067E   04E0 2AA2              CLR     @BAD_OFFSET
  0682   04E0 2AA4              CLR     @EXPECTED
  0686   04E0 2AA6              CLR     @ACTUAL
                        
  068A   0200 2254              LI      R0,BEGIN_MSG
  068E   2DA0 2160              CALL    @PRINTMSG
  0692   2EA0 2A98              WHEX    @TARGET_RECS
  0696   0200 2266              LI      R0,RECORDS_MSG
  069A   2DA0 2160              CALL    @PRINTMSG
                        
  069E   2DA0 1D86              CALL    @CREATE_FILE
  06A2   C041                   MOV     R1,R1
  06A4   111E                   JLT     RT_FAIL
                        
  06A6   2DA0 1DEC              CALL    @WRITE_FILE
  06AA   C041                   MOV     R1,R1
  06AC   111A                   JLT     RT_FAIL
                        
  06AE   2DA0 1EEE              CALL    @CLOSE_FILE
  06B2   C041                   MOV     R1,R1
  06B4   1116                   JLT     RT_FAIL
                        
  06B6   2DA0 1F12              CALL    @OPEN_FILE
  06BA   C041                   MOV     R1,R1
  06BC   1112                   JLT     RT_FAIL
                        
  06BE   2DA0 1F66              CALL    @READ_FILE
  06C2   C041                   MOV     R1,R1
  06C4   110E                   JLT     RT_FAIL
                        
  06C6   2DA0 1EEE              CALL    @CLOSE_FILE
  06CA   C041                   MOV     R1,R1
  06CC   110A                   JLT     RT_FAIL
                        
  06CE   2DA0 1FDE              CALL    @DELETE_FILE
  06D2   C041                   MOV     R1,R1
  06D4   1106                   JLT     RT_FAIL
                        
  06D6   0200 29C0              LI      R0,PASS_MSG
  06DA   2DA0 2160              CALL    @PRINTMSG
  06DE   04C1                   CLR     R1
  06E0   2DC0                   RET
                        
                        RT_FAIL:
  06E2   2DA0 20D8              CALL    @PRINT_FAILURE
  06E6   0701                   SETO    R1
  06E8   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; RUN_RANDOM - focused random-access regression test.
                        ;
                        ; Creates 12 sequential records, then verifies:
                        ;   - SETREL and GETSIZ use RELB=0 / RELR=absolute record
                        ;   - random reads at records 0,3,4,7,8,11
                        ;   - random EOF and nonzero-RELB rejection
                        ;   - overwrite of record 4 without growing FSZ
                        ;   - append record 12 at EOF, crossing into a new allocation block
                        ;   - sparse write to record 14 is rejected without changing FSZ/CRN
                        ;   - close/reopen preserves the overwrite and append
                        ;-----------------------------------------------------------------------
                        RUN_RANDOM:
  06EA   0200 000C              LI      R0,RANDRECS
  06EE   C800 2A98              MOV     R0,@TARGET_RECS
  06F2   04E0 2A9A              CLR     @FULFLG
  06F6   04E0 2A9E              CLR     @FAIL_ID
  06FA   04E0 2AA0              CLR     @LAST_STATUS
  06FE   04E0 2AA2              CLR     @BAD_OFFSET
  0702   04E0 2AA4              CLR     @EXPECTED
  0706   04E0 2AA6              CLR     @ACTUAL
                        
  070A   0200 228C              LI      R0,RND_BEGIN_MSG
  070E   2DA0 2160              CALL    @PRINTMSG
                        
  0712   2DA0 1D86              CALL    @CREATE_FILE
  0716   C041                   MOV     R1,R1
  0718   1302                   JEQ     RR_CONT1
  071A   0460 07D6              B       @RR_FAIL
                        RR_CONT1:
  071E   2DA0 1DEC              CALL    @WRITE_FILE
  0722   C041                   MOV     R1,R1
  0724   1302                   JEQ     RR_CONT2
  0726   0460 07D6              B       @RR_FAIL
                        RR_CONT2:
  072A   2DA0 1EEE              CALL    @CLOSE_FILE
  072E   C041                   MOV     R1,R1
  0730   1302                   JEQ     RR_CONT3
  0732   0460 07D6              B       @RR_FAIL
                        RR_CONT3:
  0736   2DA0 1F12              CALL    @OPEN_FILE
  073A   C041                   MOV     R1,R1
  073C   1302                   JEQ     RR_CONT4
  073E   0460 07D6              B       @RR_FAIL
                        RR_CONT4:
                        
  0742   0200 000C              LI      R0,RANDRECS
  0746   C800 2AAE              MOV     R0,@RAND_SIZE
  074A   0200 0006              LI      R0,RANDCUR
  074E   C800 2AB0              MOV     R0,@RAND_CURSOR
  0752   C800 2E3C              MOV     R0,@TESTFCB+CRN
  0756   04E0 2E3A              CLR     @TESTFCB+CBN
                        
  075A   2DA0 1922              CALL    @RND_ACT_TEST
  075E   C041                   MOV     R1,R1
  0760   1302                   JEQ     RR_CONT5
  0762   0460 07D6              B       @RR_FAIL
                        RR_CONT5:
                        
  0766   2DA0 1EEE              CALL    @CLOSE_FILE
  076A   C041                   MOV     R1,R1
  076C   1302                   JEQ     RR_CONT6
  076E   0460 07D6              B       @RR_FAIL
                        RR_CONT6:
                        
                        ; The append made the persistent size 13 records.
  0772   0200 000D              LI      R0,RANDRECS+1
  0776   C800 2A98              MOV     R0,@TARGET_RECS
  077A   2DA0 1F12              CALL    @OPEN_FILE
  077E   C041                   MOV     R1,R1
  0780   1302                   JEQ     RR_CONT7
  0782   0460 07D6              B       @RR_FAIL
                        RR_CONT7:
                        
  0786   0200 000D              LI      R0,RANDRECS+1
  078A   C800 2AAE              MOV     R0,@RAND_SIZE
  078E   0200 0006              LI      R0,RANDCUR
  0792   C800 2AB0              MOV     R0,@RAND_CURSOR
  0796   C800 2E3C              MOV     R0,@TESTFCB+CRN
  079A   04E0 2E3A              CLR     @TESTFCB+CBN
                        
  079E   2DA0 1BEC              CALL    @RND_REOP_TEST
  07A2   C041                   MOV     R1,R1
  07A4   1302                   JEQ     RR_CONT8
  07A6   0460 07D6              B       @RR_FAIL
                        RR_CONT8:
                        
  07AA   2DA0 1EEE              CALL    @CLOSE_FILE
  07AE   C041                   MOV     R1,R1
  07B0   1302                   JEQ     RR_CONT9
  07B2   0460 07D6              B       @RR_FAIL
                        RR_CONT9:
  07B6   2DA0 1FDE              CALL    @DELETE_FILE
  07BA   C041                   MOV     R1,R1
  07BC   1302                   JEQ     RR_CONT10
  07BE   0460 07D6              B       @RR_FAIL
                        RR_CONT10:
                        
  07C2   0200 2306              LI      R0,RANDOM_OK_MSG
  07C6   2DA0 2160              CALL    @PRINTMSG
  07CA   0200 29C0              LI      R0,PASS_MSG
  07CE   2DA0 2160              CALL    @PRINTMSG
  07D2   04C1                   CLR     R1
  07D4   2DC0                   RET
                        
                        RR_FAIL:
  07D6   2DA0 20D8              CALL    @PRINT_FAILURE
  07DA   0701                   SETO    R1
  07DC   2DC0                   RET
                        ;
                        ;
                        ;-----------------------------------------------------------------------
                        ; RUN_PSEL_MEM - PSEL-only memory copy control; NO disk/BDOS I/O in loops.
                        ;
                        ; This separates mapped-memory byte/word transfers from the IDE path.
                        ; Source:      PAGE0/common >0300->04FF (512 bytes)
                        ; Destination: SEG11/PAGE2 >B100->B2FF
                        ;
                        ; Phase 1: MC_ITERS copies using MOVB *R2+,*R4+, verify all 256 words.
                        ; Phase 2: MC_ITERS copies using MOV  *R2+,*R4+, verify all 256 words.
                        ;
                        ; No CALL/XOP/console/disk operation occurs while PSEL is enabled in either
                        ; phase.  A failure reports phase, iteration, byte offset, expected and actual.
                        ;-----------------------------------------------------------------------
                        RUN_PSEL_MEM:
  07DE   04E0 2AB4              CLR     @MC_ITER
  07E2   04E0 2AB6              CLR     @MC_PHASE
  07E6   04E0 2AA2              CLR     @BAD_OFFSET
  07EA   04E0 2AA4              CLR     @EXPECTED
  07EE   04E0 2AA6              CLR     @ACTUAL
                        
  07F2   0200 2324              LI      R0,MC_BEGIN_MSG
  07F6   2DA0 2160              CALL    @PRINTMSG
                        
  07FA   2C00                   PSEL_DIS
  07FC   2DA0 15FC              CALL    @SAVE_MAPS
  0800   2DA0 1622              CALL    @SET_TEST_MAPS
  0804   2DA0 1646              CALL    @CHK_TEST_MAPS
  0808   C041                   MOV     R1,R1
  080A   1306                   JEQ     MCM_MAP_OK
  080C   0200 0003              LI      R0,3
  0810   C800 2AB6              MOV     R0,@MC_PHASE
  0814   0460 092E              B       @MCM_FAIL0
                        MCM_MAP_OK:
                        
                        ; Build a deterministic but bit-rich 512-byte source in common PAGE0 RAM.
                        ; This happens with PSEL disabled and contains no IDE activity.
  0818   0202 0300              LI      R2,MC_SRC
  081C   0201 ACE1              LI      R1,0ACE1H
  0820   0204 B400              LI      R4,0B400H
  0824   0200 0100              LI      R0,NWORDS
                        MCM_FILL:
  0828   CC81                   MOV     R1,*R2+
  082A   C0C1                   MOV     R1,R3
  082C   0913                   SRL     R3,1
  082E   1701                   JNC     MCM_NOX
  0830   28C4                   XOR     R4,R3
                        MCM_NOX:
  0832   C043                   MOV     R3,R1
  0834   0600                   DEC     R0
  0836   16F8                   JNE     MCM_FILL
                        
                        ;----------------------- PHASE 1: MOVB -------------------------------
  0838   0200 0001              LI      R0,1
  083C   C800 2AB6              MOV     R0,@MC_PHASE
  0840   04E0 2AB4              CLR     @MC_ITER
  0844   2C40                   PSEL_EN
                        MCM_B_ITER:
  0846   0202 0300              LI      R2,MC_SRC
  084A   0204 B100              LI      R4,ST_DMA
  084E   0200 0200              LI      R0,BYTSEC
                        MCM_B_COPY:
  0852   DD32                   MOVB    *R2+,*R4+
  0854   0600                   DEC     R0
  0856   16FD                   JNE     MCM_B_COPY
                        
                        ; Verify as words.  Source is SEG0/PAGE0; destination is SEG11/PAGE2.
  0858   0202 0300              LI      R2,MC_SRC
  085C   0204 B100              LI      R4,ST_DMA
  0860   04C3                   CLR     R3
  0862   0200 0100              LI      R0,NWORDS
                        MCM_B_VER:
  0866   C172                   MOV     *R2+,R5
  0868   C1B4                   MOV     *R4+,R6
  086A   8185                   C       R5,R6
  086C   1302                   JEQ     MCB_VOK
  086E   0460 090C              B       @MCM_B_BAD
                        MCB_VOK:
  0872   05C3                   INCT    R3
  0874   0600                   DEC     R0
  0876   16F7                   JNE     MCM_B_VER
                        
  0878   05A0 2AB4              INC     @MC_ITER
  087C   C020 2AB4              MOV     @MC_ITER,R0
  0880   0280 0400              CI      R0,MC_ITERS
  0884   1AE0                   JL      MCM_B_ITER
  0886   2C00                   PSEL_DIS
                        
  0888   0200 2392              LI      R0,MC_B_OK_MSG
  088C   2DA0 2160              CALL    @PRINTMSG
                        
                        ;----------------------- PHASE 2: MOV -------------------------------
  0890   0200 0002              LI      R0,2
  0894   C800 2AB6              MOV     R0,@MC_PHASE
  0898   04E0 2AB4              CLR     @MC_ITER
  089C   2C40                   PSEL_EN
                        MCM_W_ITER:
  089E   0202 0300              LI      R2,MC_SRC
  08A2   0204 B100              LI      R4,ST_DMA
  08A6   0200 0100              LI      R0,NWORDS
                        MCM_W_COPY:
  08AA   CD32                   MOV     *R2+,*R4+
  08AC   0600                   DEC     R0
  08AE   16FD                   JNE     MCM_W_COPY
                        
  08B0   0202 0300              LI      R2,MC_SRC
  08B4   0204 B100              LI      R4,ST_DMA
  08B8   04C3                   CLR     R3
  08BA   0200 0100              LI      R0,NWORDS
                        MCM_W_VER:
  08BE   C172                   MOV     *R2+,R5
  08C0   C1B4                   MOV     *R4+,R6
  08C2   8185                   C       R5,R6
  08C4   1302                   JEQ     MCW_VOK
  08C6   0460 091C              B       @MCM_W_BAD
                        MCW_VOK:
  08CA   05C3                   INCT    R3
  08CC   0600                   DEC     R0
  08CE   16F7                   JNE     MCM_W_VER
                        
  08D0   05A0 2AB4              INC     @MC_ITER
  08D4   C020 2AB4              MOV     @MC_ITER,R0
  08D8   0280 0400              CI      R0,MC_ITERS
  08DC   1AE0                   JL      MCM_W_ITER
  08DE   2C00                   PSEL_DIS
                        
  08E0   0200 23BE              LI      R0,MC_W_OK_MSG
  08E4   2DA0 2160              CALL    @PRINTMSG
                        
                        ; Check that the mapper still has exactly the expected test mapping.
  08E8   2DA0 1646              CALL    @CHK_TEST_MAPS
  08EC   C041                   MOV     R1,R1
  08EE   1306                   JEQ     MCM_DONE
  08F0   0200 0003              LI      R0,3
  08F4   C800 2AB6              MOV     R0,@MC_PHASE
  08F8   0460 092E              B       @MCM_FAIL0
                        
                        MCM_DONE:
  08FC   2DA0 168C              CALL    @RESTORE_MAPS
  0900   0200 23EA              LI      R0,MC_OK_MSG
  0904   2DA0 2160              CALL    @PRINTMSG
  0908   04C1                   CLR     R1
  090A   2DC0                   RET
                        
                        MCM_B_BAD:
  090C   C803 2AA2              MOV     R3,@BAD_OFFSET
  0910   C805 2AA4              MOV     R5,@EXPECTED
  0914   C806 2AA6              MOV     R6,@ACTUAL
  0918   0460 092C              B       @MCM_FAIL
                        
                        MCM_W_BAD:
  091C   C803 2AA2              MOV     R3,@BAD_OFFSET
  0920   C805 2AA4              MOV     R5,@EXPECTED
  0924   C806 2AA6              MOV     R6,@ACTUAL
  0928   0460 092C              B       @MCM_FAIL
                        
                        MCM_FAIL:
  092C   2C00                   PSEL_DIS
                        MCM_FAIL0:
  092E   2DA0 168C              CALL    @RESTORE_MAPS
  0932   0200 2416              LI      R0,MC_FAIL_MSG
  0936   2DA0 2160              CALL    @PRINTMSG
  093A   0200 2440              LI      R0,MC_PHASE_MSG
  093E   2DA0 2160              CALL    @PRINTMSG
  0942   2EA0 2AB6              WHEX    @MC_PHASE
  0946   0200 2448              LI      R0,MC_ITER_MSG
  094A   2DA0 2160              CALL    @PRINTMSG
  094E   2EA0 2AB4              WHEX    @MC_ITER
  0952   0200 2450              LI      R0,MC_OFF_MSG
  0956   2DA0 2160              CALL    @PRINTMSG
  095A   2EA0 2AA2              WHEX    @BAD_OFFSET
  095E   0200 245C              LI      R0,MC_EXP_MSG
  0962   2DA0 2160              CALL    @PRINTMSG
  0966   2EA0 2AA4              WHEX    @EXPECTED
  096A   0200 2466              LI      R0,MC_ACT_MSG
  096E   2DA0 2160              CALL    @PRINTMSG
  0972   2EA0 2AA6              WHEX    @ACTUAL
  0976   0200 2A3E              LI      R0,CRLF_MSG
  097A   2DA0 2160              CALL    @PRINTMSG
  097E   0701                   SETO    R1
  0980   2DC0                   RET
                        
                        ;-----------------------------------------------------------------------
                        ; RUN_PSEL_STRESS - isolate corruption caused by disk I/O while PSEL is on.
                        ;
                        ; Test strategy:
                        ;   1. Save all 16 mapper registers; set every segment to PAGE0, then map only
                        ;      SEG11 to ST_DMA_PAGE.  BDTEST code/data remain flat, while the X-mode
                        ;      DMA buffer at >B100 is genuinely paged when PSEL is enabled.
                        ;   2. Initialize guard words around the mapped >B100 DMA buffer.
                        ;   3. Create and seed a 64-record file while PSEL is enabled.
                        ;   4. Perform STRESS_ITERS pseudo-random reads and writes.  Each write:
                        ;        - writes a unique seed-derived pattern,
                        ;        - verifies that WRRND did not modify the source DMA buffer,
                        ;        - immediately reads the record back and verifies it.
                        ;      Random reads verify against a shadow seed table plus complement table.
                        ;   5. Every 32 iterations close/reopen the file under PSEL to exercise
                        ;      directory/BAT/metadata paths as well as data-sector I/O.
                        ;   6. If a PSEL-enabled read returns bad data, repeat that same read once
                        ;      with PSEL disabled:
                        ;        TRIAGE=1 : PSEL-off reread is GOOD -> PSEL/read-memory path problem.
                        ;        TRIAGE=2 : PSEL-off reread is BAD  -> not a PSEL-only read failure;
                        ;                   suspect the write/disk path or a non-PSEL read fault.
                        ;        TRIAGE=3 : PSEL-off reread errors  -> control read itself failed.
                        ;        TRIAGE=5 : whole 512-byte read landed in flat PAGE0 at >B100.
                        ;        TRIAGE=6 : second 256-byte transfer landed in PAGE0.
                        ;        TRIAGE=7 : first 256-byte transfer landed in PAGE0.
                        ;      Before each read PAGE0 and PAGE2 receive distinct poison patterns;
                        ;      on failure each 256-byte half is classified before the control reread.
                        ;      A write that mutates the mapped DMA source sets TRIAGE=4 immediately.
                        ;   7. On exit, disable PSEL and verify the X-mode mapper registers.  The
                        ;      original mapper register images are always restored before returning.
                        ;
                        ; The test file is deliberately left on disk after a failure so the disk image
                        ; can be preserved and inspected.  It is erased only after a clean pass.
                        ;-----------------------------------------------------------------------
                        RUN_PSEL_STRESS:
  0982   04E0 2A9E              CLR     @FAIL_ID
  0986   04E0 2AA0              CLR     @LAST_STATUS
  098A   04E0 2AA2              CLR     @BAD_OFFSET
  098E   04E0 2AA4              CLR     @EXPECTED
  0992   04E0 2AA6              CLR     @ACTUAL
  0996   04E0 2AB8              CLR     @STRESS_ITER
  099A   04E0 2ABA              CLR     @STRESS_OP
  099E   04E0 2AC2              CLR     @STRESS_TRIAGE
  09A2   04E0 2AC4              CLR     @P2_HSTAT
  09A6   04E0 2AC6              CLR     @P1_HSTAT
  09AA   04E0 2AC8              CLR     @P0_HSTAT
  09AE   04E0 2ACA              CLR     @P3_HSTAT
  09B2   04E0 2AE2              CLR     @ST_CTRL_STAT
  09B6   04E0 2AFC              CLR     @MAP_BAD_SEG
  09BA   04E0 2AFE              CLR     @MAP_EXPECT
  09BE   04E0 2B00              CLR     @MAP_ACTUAL
  09C2   04E0 2AE8              CLR     @STRESS_WRITES
  09C6   04E0 2AEA              CLR     @STRESS_READS
  09CA   04E0 2AEC              CLR     @STRESS_REOPENS
                        
  09CE   0200 2470              LI      R0,ST_BEGIN_MSG
  09D2   2DA0 2160              CALL    @PRINTMSG
  09D6   0200 0040              LI      R0,STRESS_RECS
  09DA   C800 2A98              MOV     R0,@TARGET_RECS
  09DE   04E0 2A9A              CLR     @FULFLG
                        
                        ; Save the caller's mapping.  Start from SHELLV62's PAGE0 flat map, then map
                        ; only SEG11 to ST_DMA_PAGE.  This keeps executing segments in PAGE0 while
                        ; giving disk I/O a real paged DMA target at >B100.
  09E2   2C00                   PSEL_DIS
  09E4   2DA0 15FC              CALL    @SAVE_MAPS
  09E8   2DA0 1622              CALL    @SET_TEST_MAPS
  09EC   2DA0 1646              CALL    @CHK_TEST_MAPS
  09F0   C041                   MOV     R1,R1
  09F2   1301                   JEQ     RJ_T01
  09F4   1002                   JMP     RJ_F01
                        RJ_T01:
  09F6   0460 0A06              B       @RPS_MAP_OK
                        RJ_F01:
  09FA   0200 001F              LI      R0,E_PMAP
  09FE   C800 2A9E              MOV     R0,@FAIL_ID
  0A02   0460 0D50              B       @RPS_FAIL_DIS
                        RPS_MAP_OK:
                        ; From this point until clean completion/failure handling, STRESS_BDOS
                        ; reasserts PSEL_EN immediately before and after every BDOS call.
  0A06   2C40                   PSEL_EN
  0A08   2DA0 140C              CALL    @INIT_ST_GUARD
  0A0C   2DA0 1432              CALL    @CHK_ST_POSTIO ; prove map readback/guards are clean with PSEL on
  0A10   C041                   MOV     R1,R1
  0A12   1101                   JLT     RJ_T02
  0A14   1002                   JMP     RJ_F02
                        RJ_T02:
  0A16   0460 0D4E              B       @RPS_FAIL
                        RJ_F02:
  0A1A   0200 0001              LI      R0,1
  0A1E   C800 2ABA              MOV     R0,@STRESS_OP
  0A22   2DA0 0D86              CALL    @STRESS_CREATE
  0A26   C041                   MOV     R1,R1
  0A28   1101                   JLT     RJ_T03
  0A2A   1002                   JMP     RJ_F03
                        RJ_T03:
  0A2C   0460 0D4E              B       @RPS_FAIL
                        RJ_F03:
                        
  0A30   0200 0002              LI      R0,2
  0A34   C800 2ABA              MOV     R0,@STRESS_OP
  0A38   2DA0 0E9E              CALL    @ST_SEED_FILE
  0A3C   C041                   MOV     R1,R1
  0A3E   1101                   JLT     RJ_T04
  0A40   1002                   JMP     RJ_F04
                        RJ_T04:
  0A42   0460 0D4E              B       @RPS_FAIL
                        RJ_F04:
                        
  0A46   0200 0006              LI      R0,6
  0A4A   C800 2ABA              MOV     R0,@STRESS_OP
  0A4E   2DA0 0DE8              CALL    @STRESS_CLOSE
  0A52   C041                   MOV     R1,R1
  0A54   1101                   JLT     RJ_T05
  0A56   1002                   JMP     RJ_F05
                        RJ_T05:
  0A58   0460 0D4E              B       @RPS_FAIL
                        RJ_F05:
                        
  0A5C   0200 0007              LI      R0,7
  0A60   C800 2ABA              MOV     R0,@STRESS_OP
  0A64   2DA0 0E0A              CALL    @STRESS_OPEN
  0A68   C041                   MOV     R1,R1
  0A6A   1101                   JLT     RJ_T06
  0A6C   1002                   JMP     RJ_F06
                        RJ_T06:
  0A6E   0460 0D4E              B       @RPS_FAIL
                        RJ_F06:
                        
  0A72   0200 ACE1              LI      R0,STRESS_RNG_INIT
  0A76   C800 2ABC              MOV     R0,@STRESS_RNG
  0A7A   04E0 2AB8              CLR     @STRESS_ITER
                        
                        RPS_LOOP:
  0A7E   C020 2AB8              MOV     @STRESS_ITER,R0
  0A82   0280 0400              CI      R0,STRESS_ITERS
  0A86   1401                   JHE     RJ_T07
  0A88   1002                   JMP     RJ_F07
                        RJ_T07:
  0A8A   0460 0C30              B       @RPS_SWEEP
                        RJ_F07:
                        
                        ; First random value selects the record and operation.
  0A8E   2DA0 15E8              CALL    @NEXT_STRESS_RNG
  0A92   C140                   MOV     R0,R5
  0A94   0240 003F              ANDI    R0,003FH
  0A98   C800 2AB2              MOV     R0,@RAND_TARGET
  0A9C   C800 2A9C              MOV     R0,@CUR_REC
  0AA0   C045                   MOV     R5,R1
  0AA2   0241 0001              ANDI    R1,0001H
  0AA6   1601                   JNE     RJ_T08
  0AA8   1002                   JMP     RJ_F08
                        RJ_T08:
  0AAA   0460 0B18              B       @RPS_DO_WRITE
                        RJ_F08:
                        
                        ;------------------------- random read -------------------------------
                        RPS_DO_READ:
  0AAE   0200 0003              LI      R0,3
  0AB2   C800 2ABA              MOV     R0,@STRESS_OP
  0AB6   2DA0 13CC              CALL    @LD_ST_EXPECT
  0ABA   C041                   MOV     R1,R1
  0ABC   1101                   JLT     RJ_T09
  0ABE   1002                   JMP     RJ_F09
                        RJ_T09:
  0AC0   0460 0D4E              B       @RPS_FAIL
                        RJ_F09:
  0AC4   2DA0 1090              CALL    @PREP_READ_BUF
  0AC8   2DA0 0F3E              CALL    @ST_RND_READ
  0ACC   C041                   MOV     R1,R1
  0ACE   1101                   JLT     RJ_T10
  0AD0   1002                   JMP     RJ_F10
                        RJ_T10:
  0AD2   0460 0D4E              B       @RPS_FAIL
                        RJ_F10:
  0AD6   05A0 2AEA              INC     @STRESS_READS
  0ADA   2DA0 1010              CALL    @STRESS_VERIFY
  0ADE   C041                   MOV     R1,R1
  0AE0   1301                   JEQ     RJ_T11
  0AE2   1002                   JMP     RJ_F11
                        RJ_T11:
  0AE4   0460 0AF8              B       @RPS_READ_GOOD
                        RJ_F11:
  0AE8   0200 001C              LI      R0,E_PDATA
  0AEC   C800 2A9E              MOV     R0,@FAIL_ID
  0AF0   2DA0 1498              CALL    @TRIAGE_BAD_READ
  0AF4   0460 0D4E              B       @RPS_FAIL
                        RPS_READ_GOOD:
  0AF8   2DA0 0F92              CALL    @CHK_ST_STATE
  0AFC   C041                   MOV     R1,R1
  0AFE   1101                   JLT     RJ_T12
  0B00   1002                   JMP     RJ_F12
                        RJ_T12:
  0B02   0460 0D4E              B       @RPS_FAIL
                        RJ_F12:
  0B06   2DA0 1432              CALL    @CHK_ST_POSTIO
  0B0A   C041                   MOV     R1,R1
  0B0C   1101                   JLT     RJ_T13
  0B0E   1002                   JMP     RJ_F13
                        RJ_T13:
  0B10   0460 0D4E              B       @RPS_FAIL
                        RJ_F13:
  0B14   0460 0BE8              B       @RPS_NEXT
                        
                        ;------------------------- random write ------------------------------
                        RPS_DO_WRITE:
  0B18   0200 0004              LI      R0,4
  0B1C   C800 2ABA              MOV     R0,@STRESS_OP
  0B20   2DA0 15E8              CALL    @NEXT_STRESS_RNG
  0B24   C800 2ABE              MOV     R0,@STRESS_SEED
  0B28   1601                   JNE     RJ_T14
  0B2A   1002                   JMP     RJ_F14
                        RJ_T14:
  0B2C   0460 0B38              B       @RPS_SEED_NZ
                        RJ_F14:
  0B30   0200 0001              LI      R0,1
  0B34   C800 2ABE              MOV     R0,@STRESS_SEED
                        RPS_SEED_NZ:
  0B38   2DA0 0FDC              CALL    @STRESS_FILL
  0B3C   2DA0 0F68              CALL    @ST_RND_WRITE
  0B40   C041                   MOV     R1,R1
  0B42   1101                   JLT     RJ_T15
  0B44   1002                   JMP     RJ_F15
                        RJ_T15:
  0B46   0460 0D4E              B       @RPS_FAIL
                        RJ_F15:
  0B4A   05A0 2AE8              INC     @STRESS_WRITES
                        
                        ; A disk WRITE must never modify its source DMA buffer.  Detect that before
                        ; poisoning the buffer for the readback.
  0B4E   2DA0 1010              CALL    @STRESS_VERIFY
  0B52   C041                   MOV     R1,R1
  0B54   1301                   JEQ     RJ_T16
  0B56   1002                   JMP     RJ_F16
                        RJ_T16:
  0B58   0460 0B70              B       @RPS_WBUF_OK
                        RJ_F16:
  0B5C   0200 0025              LI      R0,E_PWBUF
  0B60   C800 2A9E              MOV     R0,@FAIL_ID
  0B64   0200 0004              LI      R0,4
  0B68   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  0B6C   0460 0D4E              B       @RPS_FAIL
                        RPS_WBUF_OK:
  0B70   2DA0 13AC              CALL    @ST_ST_EXPECT
  0B74   2DA0 0F92              CALL    @CHK_ST_STATE
  0B78   C041                   MOV     R1,R1
  0B7A   1101                   JLT     RJ_T17
  0B7C   1002                   JMP     RJ_F17
                        RJ_T17:
  0B7E   0460 0D4E              B       @RPS_FAIL
                        RJ_F17:
  0B82   2DA0 1432              CALL    @CHK_ST_POSTIO
  0B86   C041                   MOV     R1,R1
  0B88   1101                   JLT     RJ_T18
  0B8A   1002                   JMP     RJ_F18
                        RJ_T18:
  0B8C   0460 0D4E              B       @RPS_FAIL
                        RJ_F18:
                        
                        ; Immediate PSEL-enabled readback of the record just written.
  0B90   0200 0005              LI      R0,5
  0B94   C800 2ABA              MOV     R0,@STRESS_OP
  0B98   2DA0 1090              CALL    @PREP_READ_BUF
  0B9C   2DA0 0F3E              CALL    @ST_RND_READ
  0BA0   C041                   MOV     R1,R1
  0BA2   1101                   JLT     RJ_T19
  0BA4   1002                   JMP     RJ_F19
                        RJ_T19:
  0BA6   0460 0D4E              B       @RPS_FAIL
                        RJ_F19:
  0BAA   05A0 2AEA              INC     @STRESS_READS
  0BAE   2DA0 1010              CALL    @STRESS_VERIFY
  0BB2   C041                   MOV     R1,R1
  0BB4   1301                   JEQ     RJ_T20
  0BB6   1002                   JMP     RJ_F20
                        RJ_T20:
  0BB8   0460 0BCC              B       @RPS_WRRD_OK
                        RJ_F20:
  0BBC   0200 001C              LI      R0,E_PDATA
  0BC0   C800 2A9E              MOV     R0,@FAIL_ID
  0BC4   2DA0 1498              CALL    @TRIAGE_BAD_READ
  0BC8   0460 0D4E              B       @RPS_FAIL
                        RPS_WRRD_OK:
  0BCC   2DA0 0F92              CALL    @CHK_ST_STATE
  0BD0   C041                   MOV     R1,R1
  0BD2   1101                   JLT     RJ_T21
  0BD4   1002                   JMP     RJ_F21
                        RJ_T21:
  0BD6   0460 0D4E              B       @RPS_FAIL
                        RJ_F21:
  0BDA   2DA0 1432              CALL    @CHK_ST_POSTIO
  0BDE   C041                   MOV     R1,R1
  0BE0   1101                   JLT     RJ_T22
  0BE2   1002                   JMP     RJ_F22
                        RJ_T22:
  0BE4   0460 0D4E              B       @RPS_FAIL
                        RJ_F22:
                        
                        RPS_NEXT:
  0BE8   05A0 2AB8              INC     @STRESS_ITER
                        
                        ; Exercise directory/metadata paths under PSEL every 32 iterations.
  0BEC   C020 2AB8              MOV     @STRESS_ITER,R0
  0BF0   0240 001F              ANDI    R0,ST_REOPEN_MSK
  0BF4   1601                   JNE     RJ_T23
  0BF6   1002                   JMP     RJ_F23
                        RJ_T23:
  0BF8   0460 0A7E              B       @RPS_LOOP
                        RJ_F23:
  0BFC   0200 0006              LI      R0,6
  0C00   C800 2ABA              MOV     R0,@STRESS_OP
  0C04   2DA0 0DE8              CALL    @STRESS_CLOSE
  0C08   C041                   MOV     R1,R1
  0C0A   1101                   JLT     RJ_T24
  0C0C   1002                   JMP     RJ_F24
                        RJ_T24:
  0C0E   0460 0D4E              B       @RPS_FAIL
                        RJ_F24:
  0C12   0200 0007              LI      R0,7
  0C16   C800 2ABA              MOV     R0,@STRESS_OP
  0C1A   2DA0 0E0A              CALL    @STRESS_OPEN
  0C1E   C041                   MOV     R1,R1
  0C20   1101                   JLT     RJ_T25
  0C22   1002                   JMP     RJ_F25
                        RJ_T25:
  0C24   0460 0D4E              B       @RPS_FAIL
                        RJ_F25:
  0C28   05A0 2AEC              INC     @STRESS_REOPENS
  0C2C   0460 0A7E              B       @RPS_LOOP
                        
                        ; Final PSEL-enabled sweep verifies every record against the shadow table.
                        RPS_SWEEP:
  0C30   04E0 2A9C              CLR     @CUR_REC
                        RPS_SWEEP_LOOP:
  0C34   C020 2A9C              MOV     @CUR_REC,R0
  0C38   0280 0040              CI      R0,STRESS_RECS
  0C3C   1401                   JHE     RJ_T26
  0C3E   1002                   JMP     RJ_F26
                        RJ_T26:
  0C40   0460 0CB6              B       @RPS_FINISH
                        RJ_F26:
  0C44   C800 2AB2              MOV     R0,@RAND_TARGET
  0C48   0200 0008              LI      R0,8
  0C4C   C800 2ABA              MOV     R0,@STRESS_OP
  0C50   2DA0 13CC              CALL    @LD_ST_EXPECT
  0C54   C041                   MOV     R1,R1
  0C56   1101                   JLT     RJ_T27
  0C58   1002                   JMP     RJ_F27
                        RJ_T27:
  0C5A   0460 0D4E              B       @RPS_FAIL
                        RJ_F27:
  0C5E   2DA0 1090              CALL    @PREP_READ_BUF
  0C62   2DA0 0F3E              CALL    @ST_RND_READ
  0C66   C041                   MOV     R1,R1
  0C68   1101                   JLT     RJ_T28
  0C6A   1002                   JMP     RJ_F28
                        RJ_T28:
  0C6C   0460 0D4E              B       @RPS_FAIL
                        RJ_F28:
  0C70   05A0 2AEA              INC     @STRESS_READS
  0C74   2DA0 1010              CALL    @STRESS_VERIFY
  0C78   C041                   MOV     R1,R1
  0C7A   1301                   JEQ     RJ_T29
  0C7C   1002                   JMP     RJ_F29
                        RJ_T29:
  0C7E   0460 0C92              B       @RPS_SWEEP_GOOD
                        RJ_F29:
  0C82   0200 001C              LI      R0,E_PDATA
  0C86   C800 2A9E              MOV     R0,@FAIL_ID
  0C8A   2DA0 1498              CALL    @TRIAGE_BAD_READ
  0C8E   0460 0D4E              B       @RPS_FAIL
                        RPS_SWEEP_GOOD:
  0C92   2DA0 0F92              CALL    @CHK_ST_STATE
  0C96   C041                   MOV     R1,R1
  0C98   1101                   JLT     RJ_T30
  0C9A   1002                   JMP     RJ_F30
                        RJ_T30:
  0C9C   0460 0D4E              B       @RPS_FAIL
                        RJ_F30:
  0CA0   2DA0 1432              CALL    @CHK_ST_POSTIO
  0CA4   C041                   MOV     R1,R1
  0CA6   1101                   JLT     RJ_T31
  0CA8   1002                   JMP     RJ_F31
                        RJ_T31:
  0CAA   0460 0D4E              B       @RPS_FAIL
                        RJ_F31:
  0CAE   05A0 2A9C              INC     @CUR_REC
  0CB2   0460 0C34              B       @RPS_SWEEP_LOOP
                        
                        RPS_FINISH:
  0CB6   0200 0006              LI      R0,6
  0CBA   C800 2ABA              MOV     R0,@STRESS_OP
  0CBE   2DA0 0DE8              CALL    @STRESS_CLOSE
  0CC2   C041                   MOV     R1,R1
  0CC4   1101                   JLT     RJ_T32
  0CC6   1002                   JMP     RJ_F32
                        RJ_T32:
  0CC8   0460 0D4E              B       @RPS_FAIL
                        RJ_F32:
                        
                        ; Delete only after every check has passed, still with PSEL enabled.
  0CCC   0200 0009              LI      R0,9
  0CD0   C800 2ABA              MOV     R0,@STRESS_OP
  0CD4   2DA0 0E78              CALL    @STRESS_DELETE
  0CD8   C041                   MOV     R1,R1
  0CDA   1101                   JLT     RJ_T33
  0CDC   1002                   JMP     RJ_F33
                        RJ_T33:
  0CDE   0460 0D4E              B       @RPS_FAIL
                        RJ_F33:
                        
                        ; Return to a safe state and verify that disk activity did not alter the
                        ; X-mode mapper state.  Then restore the original map images.
  0CE2   2C00                   PSEL_DIS
  0CE4   2DA0 1646              CALL    @CHK_TEST_MAPS
  0CE8   C041                   MOV     R1,R1
  0CEA   1301                   JEQ     RJ_T34
  0CEC   1002                   JMP     RJ_F34
                        RJ_T34:
  0CEE   0460 0CFE              B       @RPS_MAPF_OK
                        RJ_F34:
  0CF2   0200 001F              LI      R0,E_PMAP
  0CF6   C800 2A9E              MOV     R0,@FAIL_ID
  0CFA   0460 0D50              B       @RPS_FAIL_DIS
                        RPS_MAPF_OK:
  0CFE   2DA0 168C              CALL    @RESTORE_MAPS
  0D02   0200 24FA              LI      R0,STRESS_OK_MSG
  0D06   2DA0 2160              CALL    @PRINTMSG
  0D0A   0200 2544              LI      R0,ST_COUNT_MSG
  0D0E   2DA0 2160              CALL    @PRINTMSG
  0D12   2EA0 2AB8              WHEX    @STRESS_ITER
  0D16   0200 254C              LI      R0,STRESS_WR_MSG
  0D1A   2DA0 2160              CALL    @PRINTMSG
  0D1E   2EA0 2AE8              WHEX    @STRESS_WRITES
  0D22   0200 2556              LI      R0,STRESS_RD_MSG
  0D26   2DA0 2160              CALL    @PRINTMSG
  0D2A   2EA0 2AEA              WHEX    @STRESS_READS
  0D2E   0200 2560              LI      R0,STRESS_RO_MSG
  0D32   2DA0 2160              CALL    @PRINTMSG
  0D36   2EA0 2AEC              WHEX    @STRESS_REOPENS
  0D3A   0200 2A3E              LI      R0,CRLF_MSG
  0D3E   2DA0 2160              CALL    @PRINTMSG
  0D42   0200 29C0              LI      R0,PASS_MSG
  0D46   2DA0 2160              CALL    @PRINTMSG
  0D4A   04C1                   CLR     R1
  0D4C   2DC0                   RET
                        
                        ; Failure while PSEL may still be enabled.  Disable it first, capture mapper
                        ; state for diagnostics, then restore the caller's maps.  The test file is NOT
                        ; erased here.
                        RPS_FAIL:
  0D4E   2C00                   PSEL_DIS
                        RPS_FAIL_DIS:
  0D50   2DA0 1646              CALL    @CHK_TEST_MAPS
  0D54   2DA0 168C              CALL    @RESTORE_MAPS
  0D58   2DA0 20D8              CALL    @PRINT_FAILURE
  0D5C   2DA0 16B0              CALL    @PR_ST_DIAG
  0D60   0701                   SETO    R1
  0D62   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; STRESS_BDOS - call BDOS with PSEL definitely enabled.
                        ; Entry R2=function, R3=argument.  Returns BDOS R1 status.
                        ;
                        ; PSEL_EN is an XOP and may share R0-R7, so save the BDOS arguments in memory
                        ; before asserting PSEL and reload them afterwards.  PSEL is intentionally
                        ; left enabled on return; RUN_PSEL_STRESS disables it only for failure/exit.
                        ;-----------------------------------------------------------------------
                        STRESS_BDOS:
  0D64   C802 2AE4              MOV     R2,@STRESS_BDOS_FN
  0D68   C803 2AE6              MOV     R3,@STRESS_BDOS_ARG
  0D6C   2C40                   PSEL_EN
  0D6E   C0A0 2AE4              MOV     @STRESS_BDOS_FN,R2
  0D72   C0E0 2AE6              MOV     @STRESS_BDOS_ARG,R3
  0D76   2DA0 0084              CALL    @BDOS
  0D7A   C801 2AA0              MOV     R1,@LAST_STATUS
  0D7E   2C40                   PSEL_EN                 ; caller must see mapped DMA window on return
  0D80   C060 2AA0              MOV     @LAST_STATUS,R1
  0D84   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; Stress file lifecycle helpers.  No console I/O is performed while PSEL is
                        ; active so the stress phase isolates filesystem/disk activity as far as
                        ; practical.
                        ;-----------------------------------------------------------------------
                        STRESS_CREATE:
  0D86   2DA0 200E              CALL    @INIT_FCB
  0D8A   0202 0013              LI      R2,ERAFIL
  0D8E   0203 2E22              LI      R3,TESTFCB
  0D92   2DA0 0D64              CALL    @STRESS_BDOS      ; stale file erase: ignore not-found
  0D96   2DA0 1432              CALL    @CHK_ST_POSTIO
  0D9A   C041                   MOV     R1,R1
  0D9C   111E                   JLT     STC_RET
                        
  0D9E   2DA0 200E              CALL    @INIT_FCB
  0DA2   0202 0016              LI      R2,MAKFIL
  0DA6   0203 2E22              LI      R3,TESTFCB
  0DAA   2DA0 0D64              CALL    @STRESS_BDOS
  0DAE   C041                   MOV     R1,R1
  0DB0   1115                   JLT     STC_FAIL
  0DB2   2DA0 1432              CALL    @CHK_ST_POSTIO
  0DB6   C041                   MOV     R1,R1
  0DB8   1110                   JLT     STC_RET
  0DBA   C020 2E2E              MOV     @TESTFCB+FSB,R0
  0DBE   0280 0002              CI      R0,FIRSTBLK
  0DC2   1A0C                   JL      STC_FAIL
  0DC4   0280 02CF              CI      R0,MAXBLK
  0DC8   1B09                   JH      STC_FAIL
  0DCA   0202 001A              LI      R2,SETDMA
  0DCE   0203 B100              LI      R3,ST_DMA
  0DD2   2DA0 0D64              CALL    @STRESS_BDOS
  0DD6   2DA0 1432              CALL    @CHK_ST_POSTIO
                        STC_RET:
  0DDA   2DC0                   RET
                        STC_FAIL:
  0DDC   0200 0018              LI      R0,E_PCREATE
  0DE0   C800 2A9E              MOV     R0,@FAIL_ID
  0DE4   0701                   SETO    R1
  0DE6   2DC0                   RET
                        
                        STRESS_CLOSE:
  0DE8   0202 0010              LI      R2,FCLOSE
  0DEC   0203 2E22              LI      R3,TESTFCB
  0DF0   2DA0 0D64              CALL    @STRESS_BDOS
  0DF4   C041                   MOV     R1,R1
  0DF6   1103                   JLT     STCL_FAIL
  0DF8   2DA0 1432              CALL    @CHK_ST_POSTIO
  0DFC   2DC0                   RET
                        STCL_FAIL:
  0DFE   0200 0020              LI      R0,E_PCLOSE
  0E02   C800 2A9E              MOV     R0,@FAIL_ID
  0E06   0701                   SETO    R1
  0E08   2DC0                   RET
                        
                        STRESS_OPEN:
  0E0A   2DA0 200E              CALL    @INIT_FCB
  0E0E   0202 000F              LI      R2,OPEN
  0E12   0203 2E22              LI      R3,TESTFCB
  0E16   2DA0 0D64              CALL    @STRESS_BDOS
  0E1A   C041                   MOV     R1,R1
  0E1C   111A                   JLT     STO_FAIL
  0E1E   2DA0 1432              CALL    @CHK_ST_POSTIO
  0E22   C041                   MOV     R1,R1
  0E24   1115                   JLT     STO_RET
  0E26   0200 0040              LI      R0,STRESS_RECS
  0E2A   8800 2E30              C       R0,@TESTFCB+FSZ
  0E2E   1617                   JNE     STO_SIZE_FAIL
  0E30   0202 001A              LI      R2,SETDMA
  0E34   0203 B100              LI      R3,ST_DMA
  0E38   2DA0 0D64              CALL    @STRESS_BDOS
  0E3C   0200 0006              LI      R0,RANDCUR
  0E40   C800 2AC0              MOV     R0,@STRESS_CURSOR
  0E44   C800 2E3C              MOV     R0,@TESTFCB+CRN
  0E48   04E0 2E3A              CLR     @TESTFCB+CBN
  0E4C   2DA0 1432              CALL    @CHK_ST_POSTIO
                        STO_RET:
  0E50   2DC0                   RET
                        STO_FAIL:
  0E52   0200 0021              LI      R0,E_POPEN
  0E56   C800 2A9E              MOV     R0,@FAIL_ID
  0E5A   0701                   SETO    R1
  0E5C   2DC0                   RET
                        STO_SIZE_FAIL:
  0E5E   0200 0022              LI      R0,E_PSIZE
  0E62   C800 2A9E              MOV     R0,@FAIL_ID
  0E66   0200 0040              LI      R0,STRESS_RECS
  0E6A   C800 2AA4              MOV     R0,@EXPECTED
  0E6E   C820 2E30              MOV     @TESTFCB+FSZ,@ACTUAL
  0E72   2AA6           
  0E74   0701                   SETO    R1
  0E76   2DC0                   RET
                        
                        STRESS_DELETE:
  0E78   2DA0 200E              CALL    @INIT_FCB
  0E7C   0202 0013              LI      R2,ERAFIL
  0E80   0203 2E22              LI      R3,TESTFCB
  0E84   2DA0 0D64              CALL    @STRESS_BDOS
  0E88   C041                   MOV     R1,R1
  0E8A   1103                   JLT     STD_FAIL
  0E8C   2DA0 1432              CALL    @CHK_ST_POSTIO
  0E90   2DC0                   RET
                        STD_FAIL:
  0E92   0200 0023              LI      R0,E_PDELETE
  0E96   C800 2A9E              MOV     R0,@FAIL_ID
  0E9A   0701                   SETO    R1
  0E9C   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; Seed the fixed-size stress file sequentially.  Initial expected seed for
                        ; record N is N XOR STRESS_SEED_XOR.  The seed and its complement are held in
                        ; separate shadow tables so corruption of the expected-data table is itself
                        ; detectable.
                        ;-----------------------------------------------------------------------
                        ST_SEED_FILE:
  0E9E   04E0 2A9C              CLR     @CUR_REC
                        SSF_LOOP:
  0EA2   C020 2A9C              MOV     @CUR_REC,R0
  0EA6   0280 0040              CI      R0,STRESS_RECS
  0EAA   1433                   JHE     SSF_DONE
  0EAC   C040                   MOV     R0,R1
  0EAE   0202 5A5A              LI      R2,STRESS_SEED_XOR
  0EB2   2842                   XOR     R2,R1
  0EB4   C801 2ABE              MOV     R1,@STRESS_SEED
  0EB8   C800 2AB2              MOV     R0,@RAND_TARGET
  0EBC   2DA0 0FDC              CALL    @STRESS_FILL
  0EC0   0202 0015              LI      R2,WRSEQ
  0EC4   0203 2E22              LI      R3,TESTFCB
  0EC8   2DA0 0D64              CALL    @STRESS_BDOS
  0ECC   C041                   MOV     R1,R1
  0ECE   1123                   JLT     SSF_FAIL
                        
                        ; Sequential state must advance exactly one record per successful write.
  0ED0   C020 2A9C              MOV     @CUR_REC,R0
  0ED4   0580                   INC     R0
  0ED6   8800 2E3C              C       R0,@TESTFCB+CRN
  0EDA   1623                   JNE     SSF_STATE_FAIL
  0EDC   8800 2E30              C       R0,@TESTFCB+FSZ
  0EE0   1620                   JNE     SSF_STATE_FAIL
                        
                        ; A write must not mutate its DMA source buffer.
  0EE2   2DA0 1010              CALL    @STRESS_VERIFY
  0EE6   C041                   MOV     R1,R1
  0EE8   130A                   JEQ     SSF_WBUF_OK
  0EEA   0200 0025              LI      R0,E_PWBUF
  0EEE   C800 2A9E              MOV     R0,@FAIL_ID
  0EF2   0200 0004              LI      R0,4
  0EF6   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  0EFA   0701                   SETO    R1
  0EFC   2DC0                   RET
                        SSF_WBUF_OK:
  0EFE   2DA0 13AC              CALL    @ST_ST_EXPECT
  0F02   2DA0 1432              CALL    @CHK_ST_POSTIO
  0F06   C041                   MOV     R1,R1
  0F08   1105                   JLT     SSF_RET
  0F0A   05A0 2A9C              INC     @CUR_REC
  0F0E   0460 0EA2              B       @SSF_LOOP
                        SSF_DONE:
  0F12   04C1                   CLR     R1
                        SSF_RET:
  0F14   2DC0                   RET
                        SSF_FAIL:
  0F16   0200 0019              LI      R0,E_PSEED
  0F1A   C800 2A9E              MOV     R0,@FAIL_ID
  0F1E   0701                   SETO    R1
  0F20   2DC0                   RET
                        SSF_STATE_FAIL:
  0F22   0200 001D              LI      R0,E_PSTATE
  0F26   C800 2A9E              MOV     R0,@FAIL_ID
  0F2A   C020 2A9C              MOV     @CUR_REC,R0
  0F2E   0580                   INC     R0
  0F30   C800 2AA4              MOV     R0,@EXPECTED
  0F34   C820 2E3C              MOV     @TESTFCB+CRN,@ACTUAL
  0F38   2AA6           
  0F3A   0701                   SETO    R1
  0F3C   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; Random disk primitives.  RAND_TARGET is an absolute record number.
                        ;-----------------------------------------------------------------------
                        ST_RND_READ:
  0F3E   04E0 2E3E              CLR     @TESTFCB+RELB
  0F42   C820 2AB2              MOV     @RAND_TARGET,@TESTFCB+RELR
  0F46   2E40           
  0F48   0202 0021              LI      R2,RDRND
  0F4C   0203 2E22              LI      R3,TESTFCB
  0F50   2DA0 0D64              CALL    @STRESS_BDOS
  0F54   C041                   MOV     R1,R1
  0F56   1102                   JLT     STRR_FAIL
  0F58   04C1                   CLR     R1
  0F5A   2DC0                   RET
                        STRR_FAIL:
  0F5C   0200 001B              LI      R0,E_PREAD
  0F60   C800 2A9E              MOV     R0,@FAIL_ID
  0F64   0701                   SETO    R1
  0F66   2DC0                   RET
                        
                        ST_RND_WRITE:
  0F68   04E0 2E3E              CLR     @TESTFCB+RELB
  0F6C   C820 2AB2              MOV     @RAND_TARGET,@TESTFCB+RELR
  0F70   2E40           
  0F72   0202 0022              LI      R2,WRRND
  0F76   0203 2E22              LI      R3,TESTFCB
  0F7A   2DA0 0D64              CALL    @STRESS_BDOS
  0F7E   C041                   MOV     R1,R1
  0F80   1102                   JLT     STRW_FAIL
  0F82   04C1                   CLR     R1
  0F84   2DC0                   RET
                        STRW_FAIL:
  0F86   0200 001A              LI      R0,E_PWRITE
  0F8A   C800 2A9E              MOV     R0,@FAIL_ID
  0F8E   0701                   SETO    R1
  0F90   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; CHK_ST_STATE - random I/O must preserve file size and sequential CRN.
                        ;-----------------------------------------------------------------------
                        CHK_ST_STATE:
  0F92   0200 0040              LI      R0,STRESS_RECS
  0F96   8800 2E30              C       R0,@TESTFCB+FSZ
  0F9A   1607                   JNE     CSS_SIZE_FAIL
  0F9C   C020 2AC0              MOV     @STRESS_CURSOR,R0
  0FA0   8800 2E3C              C       R0,@TESTFCB+CRN
  0FA4   160F                   JNE     CSS_CURSOR_FAIL
  0FA6   04C1                   CLR     R1
  0FA8   2DC0                   RET
                        CSS_SIZE_FAIL:
  0FAA   0200 001D              LI      R0,E_PSTATE
  0FAE   C800 2A9E              MOV     R0,@FAIL_ID
  0FB2   0200 0040              LI      R0,STRESS_RECS
  0FB6   C800 2AA4              MOV     R0,@EXPECTED
  0FBA   C820 2E30              MOV     @TESTFCB+FSZ,@ACTUAL
  0FBE   2AA6           
  0FC0   0701                   SETO    R1
  0FC2   2DC0                   RET
                        CSS_CURSOR_FAIL:
  0FC4   0200 001D              LI      R0,E_PSTATE
  0FC8   C800 2A9E              MOV     R0,@FAIL_ID
  0FCC   C820 2AC0              MOV     @STRESS_CURSOR,@EXPECTED
  0FD0   2AA4           
  0FD2   C820 2E3C              MOV     @TESTFCB+CRN,@ACTUAL
  0FD6   2AA6           
  0FD8   0701                   SETO    R1
  0FDA   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; Stress pattern format (512 bytes):
                        ;   word0 = STRESS_MAGIC
                        ;   word1 = logical record number
                        ;   word2 = per-write pseudo-random seed
                        ;   word3 = complement of seed
                        ;   words4..255 = (seed XOR record)+4, then +0101H per word.
                        ;-----------------------------------------------------------------------
                        STRESS_FILL:
  0FDC   0200 B100              LI      R0,ST_DMA
  0FE0   0201 D15C              LI      R1,STRESS_MAGIC
  0FE4   CC01                   MOV     R1,*R0+
  0FE6   CC20 2AB2              MOV     @RAND_TARGET,*R0+
  0FEA   C060 2ABE              MOV     @STRESS_SEED,R1
  0FEE   CC01                   MOV     R1,*R0+
  0FF0   0541                   INV     R1
  0FF2   CC01                   MOV     R1,*R0+
  0FF4   C060 2ABE              MOV     @STRESS_SEED,R1
  0FF8   2860 2AB2              XOR     @RAND_TARGET,R1
  0FFC   0221 0004              AI      R1,4
  1000   0202 00FC              LI      R2,NWORDS-4
                        STF_LOOP:
  1004   CC01                   MOV     R1,*R0+
  1006   0221 0101              AI      R1,0101H
  100A   0602                   DEC     R2
  100C   16FB                   JNE     STF_LOOP
  100E   2DC0                   RET
                        
                        STRESS_VERIFY:
  1010   0200 B100              LI      R0,ST_DMA
  1014   04C3                   CLR     R3
  1016   0202 D15C              LI      R2,STRESS_MAGIC
  101A   C130                   MOV     *R0+,R4
  101C   8084                   C       R4,R2
  101E   1624                   JNE     STV_FAIL
  1020   05C3                   INCT    R3
  1022   C0A0 2AB2              MOV     @RAND_TARGET,R2
  1026   C130                   MOV     *R0+,R4
  1028   8084                   C       R4,R2
  102A   161E                   JNE     STV_FAIL
  102C   05C3                   INCT    R3
  102E   C0A0 2ABE              MOV     @STRESS_SEED,R2
  1032   C130                   MOV     *R0+,R4
  1034   8084                   C       R4,R2
  1036   1618                   JNE     STV_FAIL
  1038   05C3                   INCT    R3
  103A   0542                   INV     R2
  103C   C130                   MOV     *R0+,R4
  103E   8084                   C       R4,R2
  1040   1613                   JNE     STV_FAIL
  1042   05C3                   INCT    R3
  1044   C0A0 2ABE              MOV     @STRESS_SEED,R2
  1048   28A0 2AB2              XOR     @RAND_TARGET,R2
  104C   0222 0004              AI      R2,4
  1050   0201 00FC              LI      R1,NWORDS-4
                        STV_LOOP:
  1054   C130                   MOV     *R0+,R4
  1056   8084                   C       R4,R2
  1058   1607                   JNE     STV_FAIL
  105A   05C3                   INCT    R3
  105C   0222 0101              AI      R2,0101H
  1060   0601                   DEC     R1
  1062   16F8                   JNE     STV_LOOP
  1064   04C1                   CLR     R1
  1066   2DC0                   RET
                        STV_FAIL:
  1068   C803 2AA2              MOV     R3,@BAD_OFFSET
  106C   C802 2AA4              MOV     R2,@EXPECTED
  1070   C804 2AA6              MOV     R4,@ACTUAL
  1074   0701                   SETO    R1
  1076   2DC0                   RET
                        
                        POISON_BUFFER:
                        ; Flat/control poison used after PSEL has already been disabled.
  1078   0200 B100              LI      R0,ST_DMA
  107C   0201 BEEF              LI      R1,0BEEFH
  1080   0202 0100              LI      R2,NWORDS
                        PB_LOOP:
  1084   CC01                   MOV     R1,*R0+
  1086   0221 0222              AI      R1,0222H
  108A   0602                   DEC     R2
  108C   16FB                   JNE     PB_LOOP
  108E   2DC0                   RET
                        
                        ; PREP_READ_BUF - poison all four physical pages at the DMA address.
                        ; Each page receives a distinct sequence.  The intended DMA destination is
                        ; PAGE2.  Leaves SEG11 mapped to PAGE2 with PSEL enabled.
                        PREP_READ_BUF:
  1090   0200 0000              LI      R0,0
  1094   2DA0 1112              CALL    @SET_DMAPG
  1098   0200 B100              LI      R0,ST_DMA
  109C   0201 BEEF              LI      R1,0BEEFH
  10A0   0202 0100              LI      R2,NWORDS
                        PRB_P0:
  10A4   CC01                   MOV     R1,*R0+
  10A6   0221 0222              AI      R1,0222H
  10AA   0602                   DEC     R2
  10AC   16FB                   JNE     PRB_P0
                        
  10AE   0200 0001              LI      R0,1
  10B2   2DA0 1112              CALL    @SET_DMAPG
  10B6   0200 B100              LI      R0,ST_DMA
  10BA   0201 A55A              LI      R1,0A55AH
  10BE   0202 0100              LI      R2,NWORDS
                        PRB_P1:
  10C2   CC01                   MOV     R1,*R0+
  10C4   0221 0333              AI      R1,0333H
  10C8   0602                   DEC     R2
  10CA   16FB                   JNE     PRB_P1
                        
  10CC   0200 0002              LI      R0,2
  10D0   2DA0 1112              CALL    @SET_DMAPG
  10D4   0200 B100              LI      R0,ST_DMA
  10D8   0201 DEAD              LI      R1,0DEADH
  10DC   0202 0100              LI      R2,NWORDS
                        PRB_P2:
  10E0   CC01                   MOV     R1,*R0+
