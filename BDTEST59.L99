                        ;-----------------------------------------------------------------------
                        ; PRINT_EDGE - compare clean PAGE0 reread with saved corrupt PAGE2 image.
                        ; Prints four words before the first mismatch and twelve words after it.
                        ;-----------------------------------------------------------------------
                        PRINT_EDGE:
  18A0   C220 2AEE              MOV     @PSEL_BAD_OFFSET,R8
  18A4   0288 0008              CI      R8,8
  18A8   1402                   JHE     PEDGE_SUB
  18AA   04C8                   CLR     R8
  18AC   1002                   JMP     PEDGE_SET
                        PEDGE_SUB:
  18AE   0228 FFF8              AI      R8,-8
                        PEDGE_SET:
  18B2   0200 0010              LI      R0,16
  18B6   C800 2AF4              MOV     R0,@EDGE_CNT
  18BA   0200 2936              LI      R0,EDGE_HDR_MSG
  18BE   2DA0 2160              CALL    @PRINTMSG
                        PEDGE_LOOP:
  18C2   0209 B100              LI      R9,ST_DMA
  18C6   A248                   A       R8,R9
  18C8   C819 2AF6              MOV     *R9,@EDGE_GOOD
  18CC   0209 2C22              LI      R9,BAD_COPY
  18D0   A248                   A       R8,R9
  18D2   C819 2AF8              MOV     *R9,@EDGE_BAD
  18D6   C260 2AF8              MOV     @EDGE_BAD,R9
  18DA   2A60 2AF6              XOR     @EDGE_GOOD,R9
  18DE   C809 2AFA              MOV     R9,@EDGE_XOR
                        
  18E2   0200 295A              LI      R0,EDGE_O_MSG
  18E6   2DA0 2160              CALL    @PRINTMSG
  18EA   2E88                   WHEX    R8
  18EC   0200 2960              LI      R0,EDGE_G_MSG
  18F0   2DA0 2160              CALL    @PRINTMSG
  18F4   2EA0 2AF6              WHEX    @EDGE_GOOD
  18F8   0200 2966              LI      R0,EDGE_B_MSG
  18FC   2DA0 2160              CALL    @PRINTMSG
  1900   2EA0 2AF8              WHEX    @EDGE_BAD
  1904   0200 296C              LI      R0,EDGE_X_MSG
  1908   2DA0 2160              CALL    @PRINTMSG
  190C   2EA0 2AFA              WHEX    @EDGE_XOR
  1910   0200 2A3E              LI      R0,CRLF_MSG
  1914   2DA0 2160              CALL    @PRINTMSG
                        
  1918   05C8                   INCT    R8
  191A   0620 2AF4              DEC     @EDGE_CNT
  191E   16D1                   JNE     PEDGE_LOOP
  1920   2DC0                   RET
                        
                        ;-----------------------------------------------------------------------
                        ; RND_ACT_TEST - tests against the first open of the 12-record file.
                        ;-----------------------------------------------------------------------
                        RND_ACT_TEST:
                        ; SETREL must copy CRN to RELR and clear RELB.
  1922   0720 2E3E              SETO    @TESTFCB+RELB
  1926   04E0 2E40              CLR     @TESTFCB+RELR
  192A   0202 0024              LI      R2,SETREL
  192E   0203 2E22              LI      R3,TESTFCB
  1932   2DA0 0084              CALL    @BDOS
  1936   C020 2E3E              MOV     @TESTFCB+RELB,R0
  193A   1302                   JEQ     RAT_SETREL_OK1
  193C   0460 1B9E              B       @RAT_SETREL_FAIL
                        RAT_SETREL_OK1:
  1940   C020 2AB0              MOV     @RAND_CURSOR,R0
  1944   8800 2E40              C       R0,@TESTFCB+RELR
  1948   1302                   JEQ     RAT_SETREL_OK2
  194A   0460 1B9E              B       @RAT_SETREL_FAIL
                        RAT_SETREL_OK2:
                        
                        ; GETSIZ must return the current file size in RELR and clear RELB.
  194E   0720 2E3E              SETO    @TESTFCB+RELB
  1952   04E0 2E40              CLR     @TESTFCB+RELR
  1956   0202 0023              LI      R2,GETSIZ
  195A   0203 2E22              LI      R3,TESTFCB
  195E   2DA0 0084              CALL    @BDOS
  1962   C801 2AA0              MOV     R1,@LAST_STATUS
  1966   C041                   MOV     R1,R1
  1968   1101                   JLT     RAT_GETSIZ_BAD1
  196A   1002                   JMP     RAT_GETSIZ_OK1
                        RAT_GETSIZ_BAD1:
  196C   0460 1BBC              B       @RAT_GETSIZ_FAIL
                        RAT_GETSIZ_OK1:
  1970   C020 2E3E              MOV     @TESTFCB+RELB,R0
  1974   1302                   JEQ     RAT_GETSIZ_OK2
  1976   0460 1BBC              B       @RAT_GETSIZ_FAIL
                        RAT_GETSIZ_OK2:
  197A   C020 2AAE              MOV     @RAND_SIZE,R0
  197E   8800 2E40              C       R0,@TESTFCB+RELR
  1982   1302                   JEQ     RAT_GETSIZ_OK3
  1984   0460 1BBC              B       @RAT_GETSIZ_FAIL
                        RAT_GETSIZ_OK3:
  1988   2DA0 1D32              CALL    @CHECK_RND_STATE
  198C   C041                   MOV     R1,R1
  198E   1301                   JEQ     RAT_CONT1
  1990   2DC0                   RET
                        RAT_CONT1:
                        
                        ; Read records on both sides of allocation-block boundaries.
  1992   04C0                   CLR     R0
  1994   04C1                   CLR     R1
  1996   2DA0 1CD4              CALL    @RAND_READ_CHECK
  199A   C041                   MOV     R1,R1
  199C   1301                   JEQ     RAT_CONT2
  199E   2DC0                   RET
                        RAT_CONT2:
  19A0   0200 0003              LI      R0,3
  19A4   0201 0003              LI      R1,3
  19A8   2DA0 1CD4              CALL    @RAND_READ_CHECK
  19AC   C041                   MOV     R1,R1
  19AE   1301                   JEQ     RAT_CONT3
  19B0   2DC0                   RET
                        RAT_CONT3:
  19B2   0200 0004              LI      R0,4
  19B6   0201 0004              LI      R1,4
  19BA   2DA0 1CD4              CALL    @RAND_READ_CHECK
  19BE   C041                   MOV     R1,R1
  19C0   1301                   JEQ     RAT_CONT4
  19C2   2DC0                   RET
                        RAT_CONT4:
  19C4   0200 0007              LI      R0,7
  19C8   0201 0007              LI      R1,7
  19CC   2DA0 1CD4              CALL    @RAND_READ_CHECK
  19D0   C041                   MOV     R1,R1
  19D2   1301                   JEQ     RAT_CONT5
  19D4   2DC0                   RET
                        RAT_CONT5:
  19D6   0200 0008              LI      R0,8
  19DA   0201 0008              LI      R1,8
  19DE   2DA0 1CD4              CALL    @RAND_READ_CHECK
  19E2   C041                   MOV     R1,R1
  19E4   1301                   JEQ     RAT_CONT6
  19E6   2DC0                   RET
                        RAT_CONT6:
  19E8   0200 000B              LI      R0,11
  19EC   0201 000B              LI      R1,11
  19F0   2DA0 1CD4              CALL    @RAND_READ_CHECK
  19F4   C041                   MOV     R1,R1
  19F6   1301                   JEQ     RAT_CONT7
  19F8   2DC0                   RET
                        RAT_CONT7:
                        
                        ; Reading exactly at EOF must fail without moving the sequential cursor.
  19FA   C020 2AAE              MOV     @RAND_SIZE,R0
  19FE   C800 2AB2              MOV     R0,@RAND_TARGET
  1A02   04E0 2E3E              CLR     @TESTFCB+RELB
  1A06   C800 2E40              MOV     R0,@TESTFCB+RELR
  1A0A   0202 0021              LI      R2,RDRND
  1A0E   0203 2E22              LI      R3,TESTFCB
  1A12   2DA0 0084              CALL    @BDOS
  1A16   C801 2AA0              MOV     R1,@LAST_STATUS
  1A1A   C041                   MOV     R1,R1
  1A1C   1109                   JLT     RAT_EOF_STATE
  1A1E   0200 0015              LI      R0,E_REOF
  1A22   C800 2A9E              MOV     R0,@FAIL_ID
  1A26   C820 2AB2              MOV     @RAND_TARGET,@CUR_REC
  1A2A   2A9C           
  1A2C   0701                   SETO    R1
  1A2E   2DC0                   RET
                        RAT_EOF_STATE:
  1A30   2DA0 1D32              CALL    @CHECK_RND_STATE
  1A34   C041                   MOV     R1,R1
  1A36   1301                   JEQ     RAT_CONT8
  1A38   2DC0                   RET
                        RAT_CONT8:
                        
                        ; A nonzero high random-record word is invalid for this disk geometry.
  1A3A   04E0 2AB2              CLR     @RAND_TARGET
  1A3E   0200 0001              LI      R0,1
  1A42   C800 2E3E              MOV     R0,@TESTFCB+RELB
  1A46   04E0 2E40              CLR     @TESTFCB+RELR
  1A4A   0202 0021              LI      R2,RDRND
  1A4E   0203 2E22              LI      R3,TESTFCB
  1A52   2DA0 0084              CALL    @BDOS
  1A56   C801 2AA0              MOV     R1,@LAST_STATUS
  1A5A   C041                   MOV     R1,R1
  1A5C   1108                   JLT     RAT_RELB_STATE
  1A5E   0200 0016              LI      R0,E_RRELB
  1A62   C800 2A9E              MOV     R0,@FAIL_ID
  1A66   04E0 2A9C              CLR     @CUR_REC
  1A6A   0701                   SETO    R1
  1A6C   2DC0                   RET
                        RAT_RELB_STATE:
  1A6E   04E0 2E3E              CLR     @TESTFCB+RELB
  1A72   2DA0 1D32              CALL    @CHECK_RND_STATE
  1A76   C041                   MOV     R1,R1
  1A78   1301                   JEQ     RAT_CONT9
  1A7A   2DC0                   RET
                        RAT_CONT9:
                        
                        ; Overwrite logical record 4 with a distinct pattern.  FSZ must remain 12.
  1A7C   0200 0004              LI      R0,4
  1A80   C800 2AB2              MOV     R0,@RAND_TARGET
  1A84   0200 A504              LI      R0,ALTPAT
  1A88   C800 2A9C              MOV     R0,@CUR_REC
  1A8C   2DA0 203E              CALL    @FILL_BUFFER
  1A90   04E0 2E3E              CLR     @TESTFCB+RELB
  1A94   0200 0004              LI      R0,4
  1A98   C800 2E40              MOV     R0,@TESTFCB+RELR
  1A9C   0202 0022              LI      R2,WRRND
  1AA0   0203 2E22              LI      R3,TESTFCB
  1AA4   2DA0 0084              CALL    @BDOS
  1AA8   C801 2AA0              MOV     R1,@LAST_STATUS
  1AAC   C041                   MOV     R1,R1
  1AAE   1302                   JEQ     RAT_WRITE_OK1
  1AB0   0460 1BDA              B       @RAT_WRITE_FAIL
                        RAT_WRITE_OK1:
  1AB4   2DA0 1D32              CALL    @CHECK_RND_STATE
  1AB8   C041                   MOV     R1,R1
  1ABA   1301                   JEQ     RAT_CONT10
  1ABC   2DC0                   RET
                        RAT_CONT10:
                        
                        ; Verify target and neighbours immediately.
  1ABE   0200 0003              LI      R0,3
  1AC2   0201 0003              LI      R1,3
  1AC6   2DA0 1CD4              CALL    @RAND_READ_CHECK
  1ACA   C041                   MOV     R1,R1
  1ACC   1301                   JEQ     RAT_CONT11
  1ACE   2DC0                   RET
                        RAT_CONT11:
  1AD0   0200 0004              LI      R0,4
  1AD4   0201 A504              LI      R1,ALTPAT
  1AD8   2DA0 1CD4              CALL    @RAND_READ_CHECK
  1ADC   C041                   MOV     R1,R1
  1ADE   1301                   JEQ     RAT_CONT12
  1AE0   2DC0                   RET
                        RAT_CONT12:
  1AE2   0200 0005              LI      R0,5
  1AE6   0201 0005              LI      R1,5
  1AEA   2DA0 1CD4              CALL    @RAND_READ_CHECK
  1AEE   C041                   MOV     R1,R1
  1AF0   1301                   JEQ     RAT_CONT13
  1AF2   2DC0                   RET
                        RAT_CONT13:
                        
                        ; Append record 12 exactly at EOF.  This allocates the next 4-record block.
  1AF4   0200 000C              LI      R0,RANDRECS
  1AF8   C800 2AB2              MOV     R0,@RAND_TARGET
  1AFC   C800 2A9C              MOV     R0,@CUR_REC
  1B00   2DA0 203E              CALL    @FILL_BUFFER
  1B04   04E0 2E3E              CLR     @TESTFCB+RELB
  1B08   C820 2AB2              MOV     @RAND_TARGET,@TESTFCB+RELR
  1B0C   2E40           
  1B0E   0202 0022              LI      R2,WRRND
  1B12   0203 2E22              LI      R3,TESTFCB
  1B16   2DA0 0084              CALL    @BDOS
  1B1A   C801 2AA0              MOV     R1,@LAST_STATUS
  1B1E   C041                   MOV     R1,R1
  1B20   1302                   JEQ     RAT_WRITE_OK2
  1B22   0460 1BDA              B       @RAT_WRITE_FAIL
                        RAT_WRITE_OK2:
  1B26   05A0 2AAE              INC     @RAND_SIZE
  1B2A   2DA0 1D32              CALL    @CHECK_RND_STATE
  1B2E   C041                   MOV     R1,R1
  1B30   1301                   JEQ     RAT_CONT14
  1B32   2DC0                   RET
                        RAT_CONT14:
  1B34   0200 000C              LI      R0,RANDRECS
  1B38   0201 000C              LI      R1,RANDRECS
  1B3C   2DA0 1CD4              CALL    @RAND_READ_CHECK
  1B40   C041                   MOV     R1,R1
  1B42   1301                   JEQ     RAT_CONT15
  1B44   2DC0                   RET
                        RAT_CONT15:
                        
                        ; A sparse write one record beyond EOF (record 14 while size is 13) must fail.
  1B46   C020 2AAE              MOV     @RAND_SIZE,R0
  1B4A   0580                   INC     R0
  1B4C   C800 2AB2              MOV     R0,@RAND_TARGET
  1B50   C800 2A9C              MOV     R0,@CUR_REC
  1B54   2DA0 203E              CALL    @FILL_BUFFER
  1B58   04E0 2E3E              CLR     @TESTFCB+RELB
  1B5C   C820 2AB2              MOV     @RAND_TARGET,@TESTFCB+RELR
  1B60   2E40           
  1B62   0202 0022              LI      R2,WRRND
  1B66   0203 2E22              LI      R3,TESTFCB
  1B6A   2DA0 0084              CALL    @BDOS
  1B6E   C801 2AA0              MOV     R1,@LAST_STATUS
  1B72   C041                   MOV     R1,R1
  1B74   1109                   JLT     RAT_SP_STATE
  1B76   0200 0017              LI      R0,E_RSPARSE
  1B7A   C800 2A9E              MOV     R0,@FAIL_ID
  1B7E   C820 2AB2              MOV     @RAND_TARGET,@CUR_REC
  1B82   2A9C           
  1B84   0701                   SETO    R1
  1B86   2DC0                   RET
                        RAT_SP_STATE:
  1B88   2DA0 1D32              CALL    @CHECK_RND_STATE
  1B8C   C041                   MOV     R1,R1
  1B8E   1301                   JEQ     RAT_CONT16
  1B90   2DC0                   RET
                        RAT_CONT16:
                        
  1B92   0200 22AA              LI      R0,RND_ACT_OK_MSG
  1B96   2DA0 2160              CALL    @PRINTMSG
  1B9A   04C1                   CLR     R1
                        RAT_RET:
  1B9C   2DC0                   RET
                        
                        RAT_SETREL_FAIL:
  1B9E   0200 000E              LI      R0,E_RSETREL
  1BA2   C800 2A9E              MOV     R0,@FAIL_ID
  1BA6   C820 2AB0              MOV     @RAND_CURSOR,@EXPECTED
  1BAA   2AA4           
  1BAC   C820 2E40              MOV     @TESTFCB+RELR,@ACTUAL
  1BB0   2AA6           
  1BB2   C820 2AB0              MOV     @RAND_CURSOR,@CUR_REC
  1BB6   2A9C           
  1BB8   0701                   SETO    R1
  1BBA   2DC0                   RET
                        RAT_GETSIZ_FAIL:
  1BBC   0200 000F              LI      R0,E_RGETSIZ
  1BC0   C800 2A9E              MOV     R0,@FAIL_ID
  1BC4   C820 2AAE              MOV     @RAND_SIZE,@EXPECTED
  1BC8   2AA4           
  1BCA   C820 2E40              MOV     @TESTFCB+RELR,@ACTUAL
  1BCE   2AA6           
  1BD0   C820 2AAE              MOV     @RAND_SIZE,@CUR_REC
  1BD4   2A9C           
  1BD6   0701                   SETO    R1
  1BD8   2DC0                   RET
                        RAT_WRITE_FAIL:
  1BDA   0200 0014              LI      R0,E_RWRITE
  1BDE   C800 2A9E              MOV     R0,@FAIL_ID
  1BE2   C820 2AB2              MOV     @RAND_TARGET,@CUR_REC
  1BE6   2A9C           
  1BE8   0701                   SETO    R1
  1BEA   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; RND_REOP_TEST - prove random changes survived close and reopen.
                        ;-----------------------------------------------------------------------
                        RND_REOP_TEST:
  1BEC   0200 0003              LI      R0,3
  1BF0   0201 0003              LI      R1,3
  1BF4   2DA0 1CD4              CALL    @RAND_READ_CHECK
  1BF8   C041                   MOV     R1,R1
  1BFA   1301                   JEQ     RROT_CONT1
  1BFC   2DC0                   RET
                        RROT_CONT1:
  1BFE   0200 0004              LI      R0,4
  1C02   0201 A504              LI      R1,ALTPAT
  1C06   2DA0 1CD4              CALL    @RAND_READ_CHECK
  1C0A   C041                   MOV     R1,R1
  1C0C   1301                   JEQ     RROT_CONT2
  1C0E   2DC0                   RET
                        RROT_CONT2:
  1C10   0200 0005              LI      R0,5
  1C14   0201 0005              LI      R1,5
  1C18   2DA0 1CD4              CALL    @RAND_READ_CHECK
  1C1C   C041                   MOV     R1,R1
  1C1E   1301                   JEQ     RROT_CONT3
  1C20   2DC0                   RET
                        RROT_CONT3:
  1C22   0200 000C              LI      R0,RANDRECS
  1C26   0201 000C              LI      R1,RANDRECS
  1C2A   2DA0 1CD4              CALL    @RAND_READ_CHECK
  1C2E   C041                   MOV     R1,R1
  1C30   1301                   JEQ     RROT_CONT4
  1C32   2DC0                   RET
                        RROT_CONT4:
                        
                        ; GETSIZ must now report 13 records.
  1C34   0720 2E3E              SETO    @TESTFCB+RELB
  1C38   04E0 2E40              CLR     @TESTFCB+RELR
  1C3C   0202 0023              LI      R2,GETSIZ
  1C40   0203 2E22              LI      R3,TESTFCB
  1C44   2DA0 0084              CALL    @BDOS
  1C48   C801 2AA0              MOV     R1,@LAST_STATUS
  1C4C   C041                   MOV     R1,R1
  1C4E   1133                   JLT     RROT_GSZ_FAIL
  1C50   C020 2E3E              MOV     @TESTFCB+RELB,R0
  1C54   1630                   JNE     RROT_GSZ_FAIL
  1C56   C020 2AAE              MOV     @RAND_SIZE,R0
  1C5A   8800 2E40              C       R0,@TESTFCB+RELR
  1C5E   162B                   JNE     RROT_GSZ_FAIL
  1C60   2DA0 1D32              CALL    @CHECK_RND_STATE
  1C64   C041                   MOV     R1,R1
  1C66   1301                   JEQ     RROT_CONT5
  1C68   2DC0                   RET
                        RROT_CONT5:
                        
                        ; EOF must remain immediately after the appended record.
  1C6A   C020 2AAE              MOV     @RAND_SIZE,R0
  1C6E   C800 2AB2              MOV     R0,@RAND_TARGET
  1C72   04E0 2E3E              CLR     @TESTFCB+RELB
  1C76   C800 2E40              MOV     R0,@TESTFCB+RELR
  1C7A   0202 0021              LI      R2,RDRND
  1C7E   0203 2E22              LI      R3,TESTFCB
  1C82   2DA0 0084              CALL    @BDOS
  1C86   C801 2AA0              MOV     R1,@LAST_STATUS
  1C8A   C041                   MOV     R1,R1
  1C8C   1109                   JLT     RROT_EOF_STATE
  1C8E   0200 0015              LI      R0,E_REOF
  1C92   C800 2A9E              MOV     R0,@FAIL_ID
  1C96   C820 2AB2              MOV     @RAND_TARGET,@CUR_REC
  1C9A   2A9C           
  1C9C   0701                   SETO    R1
  1C9E   2DC0                   RET
                        RROT_EOF_STATE:
  1CA0   2DA0 1D32              CALL    @CHECK_RND_STATE
  1CA4   C041                   MOV     R1,R1
  1CA6   1301                   JEQ     RROT_CONT6
  1CA8   2DC0                   RET
                        RROT_CONT6:
                        
  1CAA   0200 22DA              LI      R0,RND_RO_OK_MSG
  1CAE   2DA0 2160              CALL    @PRINTMSG
  1CB2   04C1                   CLR     R1
                        RROT_RET:
  1CB4   2DC0                   RET
                        RROT_GSZ_FAIL:
  1CB6   0200 000F              LI      R0,E_RGETSIZ
  1CBA   C800 2A9E              MOV     R0,@FAIL_ID
  1CBE   C820 2AAE              MOV     @RAND_SIZE,@EXPECTED
  1CC2   2AA4           
  1CC4   C820 2E40              MOV     @TESTFCB+RELR,@ACTUAL
  1CC8   2AA6           
  1CCA   C820 2AAE              MOV     @RAND_SIZE,@CUR_REC
  1CCE   2A9C           
  1CD0   0701                   SETO    R1
  1CD2   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; RAND_READ_CHECK
                        ;   R0 = logical record address to read
                        ;   R1 = record number used to generate the expected pattern
                        ;-----------------------------------------------------------------------
                        RAND_READ_CHECK:
  1CD4   C800 2AB2              MOV     R0,@RAND_TARGET
  1CD8   C801 2A9C              MOV     R1,@CUR_REC
  1CDC   04E0 2E3E              CLR     @TESTFCB+RELB
  1CE0   C800 2E40              MOV     R0,@TESTFCB+RELR
  1CE4   0202 0021              LI      R2,RDRND
  1CE8   0203 2E22              LI      R3,TESTFCB
  1CEC   2DA0 0084              CALL    @BDOS
  1CF0   C801 2AA0              MOV     R1,@LAST_STATUS
  1CF4   C041                   MOV     R1,R1
  1CF6   110B                   JLT     RRC_READ_FAIL
                        
  1CF8   2DA0 1D32              CALL    @CHECK_RND_STATE
  1CFC   C041                   MOV     R1,R1
  1CFE   1301                   JEQ     RRC_STATE_OK
  1D00   2DC0                   RET
                        RRC_STATE_OK:
                        
  1D02   2DA0 206A              CALL    @VERIFY_BUFFER
  1D06   C041                   MOV     R1,R1
  1D08   110B                   JLT     RRC_DATA_FAIL
  1D0A   04C1                   CLR     R1
                        RRC_RET:
  1D0C   2DC0                   RET
                        RRC_READ_FAIL:
  1D0E   0200 0010              LI      R0,E_RREAD
  1D12   C800 2A9E              MOV     R0,@FAIL_ID
  1D16   C820 2AB2              MOV     @RAND_TARGET,@CUR_REC
  1D1A   2A9C           
  1D1C   0701                   SETO    R1
  1D1E   2DC0                   RET
                        RRC_DATA_FAIL:
  1D20   0200 0011              LI      R0,E_RDATA
  1D24   C800 2A9E              MOV     R0,@FAIL_ID
  1D28   C820 2AB2              MOV     @RAND_TARGET,@CUR_REC
  1D2C   2A9C           
  1D2E   0701                   SETO    R1
  1D30   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; CHECK_RND_STATE - random operations must preserve CRN and FSZ.
                        ;-----------------------------------------------------------------------
                        CHECK_RND_STATE:
  1D32   C020 2AB0              MOV     @RAND_CURSOR,R0
  1D36   8800 2E3C              C       R0,@TESTFCB+CRN
  1D3A   1607                   JNE     CRS_CURSOR_FAIL
  1D3C   C020 2AAE              MOV     @RAND_SIZE,R0
  1D40   8800 2E30              C       R0,@TESTFCB+FSZ
  1D44   1611                   JNE     CRS_SIZE_FAIL
  1D46   04C1                   CLR     R1
  1D48   2DC0                   RET
                        CRS_CURSOR_FAIL:
  1D4A   0200 0012              LI      R0,E_RCURSOR
  1D4E   C800 2A9E              MOV     R0,@FAIL_ID
  1D52   C820 2AB0              MOV     @RAND_CURSOR,@EXPECTED
  1D56   2AA4           
  1D58   C820 2E3C              MOV     @TESTFCB+CRN,@ACTUAL
  1D5C   2AA6           
  1D5E   C820 2AB2              MOV     @RAND_TARGET,@CUR_REC
  1D62   2A9C           
  1D64   0701                   SETO    R1
  1D66   2DC0                   RET
                        CRS_SIZE_FAIL:
  1D68   0200 0013              LI      R0,E_RSIZE
  1D6C   C800 2A9E              MOV     R0,@FAIL_ID
  1D70   C820 2AAE              MOV     @RAND_SIZE,@EXPECTED
  1D74   2AA4           
  1D76   C820 2E30              MOV     @TESTFCB+FSZ,@ACTUAL
  1D7A   2AA6           
  1D7C   C820 2AB2              MOV     @RAND_TARGET,@CUR_REC
  1D80   2A9C           
  1D82   0701                   SETO    R1
  1D84   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; CREATE_FILE - erase any stale test file, then create a clean one.
                        ;-----------------------------------------------------------------------
                        CREATE_FILE:
  1D86   2DA0 200E              CALL    @INIT_FCB
  1D8A   0202 0013              LI      R2,ERAFIL
  1D8E   0203 2E22              LI      R3,TESTFCB
  1D92   2DA0 0084              CALL    @BDOS            ; ignore "not found"
                        
  1D96   2DA0 200E              CALL    @INIT_FCB        ; erase/search may have altered fields
  1D9A   0202 0016              LI      R2,MAKFIL
  1D9E   0203 2E22              LI      R3,TESTFCB
  1DA2   2DA0 0084              CALL    @BDOS
  1DA6   C801 2AA0              MOV     R1,@LAST_STATUS
  1DAA   C041                   MOV     R1,R1
  1DAC   110C                   JLT     CF_MAKE_FAIL
                        
  1DAE   C020 2E2E              MOV     @TESTFCB+FSB,R0
  1DB2   0280 0002              CI      R0,FIRSTBLK
  1DB6   1A0D                   JL      CF_FSB_FAIL
  1DB8   0280 02CF              CI      R0,MAXBLK
  1DBC   1B0A                   JH      CF_FSB_FAIL
                        
  1DBE   2DA0 2030              CALL    @SET_TEST_DMA
  1DC2   04C1                   CLR     R1
  1DC4   2DC0                   RET
                        
                        CF_MAKE_FAIL:
  1DC6   0200 0001              LI      R0,E_MAKE
  1DCA   C800 2A9E              MOV     R0,@FAIL_ID
  1DCE   0701                   SETO    R1
  1DD0   2DC0                   RET
                        CF_FSB_FAIL:
  1DD2   0200 0002              LI      R0,E_FSB
  1DD6   C800 2A9E              MOV     R0,@FAIL_ID
  1DDA   C820 2E2E              MOV     @TESTFCB+FSB,@ACTUAL
  1DDE   2AA6           
  1DE0   0200 0002              LI      R0,FIRSTBLK
  1DE4   C800 2AA4              MOV     R0,@EXPECTED
  1DE8   0701                   SETO    R1
  1DEA   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; WRITE_FILE - append TARGET_RECS records and check FSZ/CRN each time.
                        ;-----------------------------------------------------------------------
                        WRITE_FILE:
  1DEC   04E0 2A9C              CLR     @CUR_REC
                        
                        WF_LOOP:
  1DF0   C020 2A9C              MOV     @CUR_REC,R0
  1DF4   8800 2A98              C       R0,@TARGET_RECS
  1DF8   131A                   JEQ     WF_DONE
                        
  1DFA   2DA0 203E              CALL    @FILL_BUFFER
  1DFE   0202 0015              LI      R2,WRSEQ
  1E02   0203 2E22              LI      R3,TESTFCB
  1E06   2DA0 0084              CALL    @BDOS
  1E0A   C801 2AA0              MOV     R1,@LAST_STATUS
  1E0E   C041                   MOV     R1,R1
  1E10   1131                   JLT     WF_WRITE_ERROR
                        
  1E12   C020 2A9C              MOV     @CUR_REC,R0
  1E16   0580                   INC     R0               ; expected next-record pointer and size
  1E18   8800 2E3C              C       R0,@TESTFCB+CRN
  1E1C   164E                   JNE     WF_FCB_FAIL
  1E1E   8800 2E30              C       R0,@TESTFCB+FSZ
  1E22   164B                   JNE     WF_FCB_FAIL
                        
  1E24   C800 2A9C              MOV     R0,@CUR_REC
  1E28   2DA0 20C4              CALL    @PROGRESS
  1E2C   10E1                   JMP     WF_LOOP
                        
                        WF_DONE:
  1E2E   C020 2A9A              MOV     @FULFLG,R0
  1E32   131A                   JEQ     WF_OK
                        
                        ; If all 2872 possible records were written, one further append must fail.
                        ; On a partially occupied disk, an earlier write failure is accepted as the
                        ; clean end of remaining capacity, provided FSZ and CRN did not advance.
  1E34   2DA0 203E              CALL    @FILL_BUFFER
  1E38   0202 0015              LI      R2,WRSEQ
  1E3C   0203 2E22              LI      R3,TESTFCB
  1E40   2DA0 0084              CALL    @BDOS
  1E44   C801 2AA0              MOV     R1,@LAST_STATUS
  1E48   C041                   MOV     R1,R1
  1E4A   1106                   JLT     WF_FULL_STATE
                        
  1E4C   0200 000C              LI      R0,E_FULL
  1E50   C800 2A9E              MOV     R0,@FAIL_ID
  1E54   0701                   SETO    R1
  1E56   2DC0                   RET
                        
                        WF_FULL_STATE:
  1E58   C020 2A98              MOV     @TARGET_RECS,R0
  1E5C   8800 2E3C              C       R0,@TESTFCB+CRN
  1E60   163A                   JNE     WF_FSTATE_FAIL
  1E62   8800 2E30              C       R0,@TESTFCB+FSZ
  1E66   1637                   JNE     WF_FSTATE_FAIL
                        
                        WF_OK:
  1E68   0200 2972              LI      R0,WRITE_OK_MSG
  1E6C   2DA0 2160              CALL    @PRINTMSG
  1E70   04C1                   CLR     R1
  1E72   2DC0                   RET
                        
                        WF_WRITE_ERROR:
  1E74   C020 2A9A              MOV     @FULFLG,R0
  1E78   131A                   JEQ     WF_WRITE_FAIL
                        
                        ; Disk-full allocation can occur only when a new 4-record block is needed.
                        ; A failure inside an already allocated block is an I/O or chain error.
  1E7A   C020 2A9C              MOV     @CUR_REC,R0
  1E7E   1317                   JEQ     WF_WRITE_FAIL
  1E80   C040                   MOV     R0,R1
  1E82   0241 0003              ANDI    R1,0003H
  1E86   1613                   JNE     WF_WRITE_FAIL
                        
                        ; Expected capacity exhaustion during F mode.  The number already written
                        ; becomes the readback target.  The rejected write must not advance state.
  1E88   C800 2A98              MOV     R0,@TARGET_RECS
  1E8C   8800 2E3C              C       R0,@TESTFCB+CRN
  1E90   1622                   JNE     WF_FSTATE_FAIL
  1E92   8800 2E30              C       R0,@TESTFCB+FSZ
  1E96   161F                   JNE     WF_FSTATE_FAIL
  1E98   0200 2270              LI      R0,CAPACITY_MSG
  1E9C   2DA0 2160              CALL    @PRINTMSG
  1EA0   2EA0 2A98              WHEX    @TARGET_RECS
  1EA4   0200 2266              LI      R0,RECORDS_MSG
  1EA8   2DA0 2160              CALL    @PRINTMSG
  1EAC   10DD                   JMP     WF_OK
                        
                        WF_WRITE_FAIL:
  1EAE   0200 0003              LI      R0,E_WRITE
  1EB2   C800 2A9E              MOV     R0,@FAIL_ID
  1EB6   0701                   SETO    R1
  1EB8   2DC0                   RET
                        
                        WF_FCB_FAIL:
  1EBA   0200 0004              LI      R0,E_WFCB
  1EBE   C800 2A9E              MOV     R0,@FAIL_ID
  1EC2   C020 2A9C              MOV     @CUR_REC,R0
  1EC6   0580                   INC     R0
  1EC8   C800 2AA4              MOV     R0,@EXPECTED
  1ECC   C820 2E3C              MOV     @TESTFCB+CRN,@ACTUAL
  1ED0   2AA6           
  1ED2   0701                   SETO    R1
  1ED4   2DC0                   RET
                        
                        WF_FSTATE_FAIL:
  1ED6   0200 000D              LI      R0,E_FSTATE
  1EDA   C800 2A9E              MOV     R0,@FAIL_ID
  1EDE   C820 2A98              MOV     @TARGET_RECS,@EXPECTED
  1EE2   2AA4           
  1EE4   C820 2E30              MOV     @TESTFCB+FSZ,@ACTUAL
  1EE8   2AA6           
  1EEA   0701                   SETO    R1
  1EEC   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; CLOSE_FILE.
                        ;-----------------------------------------------------------------------
                        CLOSE_FILE:
  1EEE   0202 0010              LI      R2,FCLOSE
  1EF2   0203 2E22              LI      R3,TESTFCB
  1EF6   2DA0 0084              CALL    @BDOS
  1EFA   C801 2AA0              MOV     R1,@LAST_STATUS
  1EFE   C041                   MOV     R1,R1
  1F00   1102                   JLT     CL_FAIL
  1F02   04C1                   CLR     R1
  1F04   2DC0                   RET
                        CL_FAIL:
  1F06   0200 0005              LI      R0,E_CLOSE
  1F0A   C800 2A9E              MOV     R0,@FAIL_ID
  1F0E   0701                   SETO    R1
  1F10   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; OPEN_FILE - rebuild filename-only FCB, open, verify recorded size.
                        ;-----------------------------------------------------------------------
                        OPEN_FILE:
  1F12   2DA0 200E              CALL    @INIT_FCB
  1F16   0202 000F              LI      R2,OPEN
  1F1A   0203 2E22              LI      R3,TESTFCB
  1F1E   2DA0 0084              CALL    @BDOS
  1F22   C801 2AA0              MOV     R1,@LAST_STATUS
  1F26   C041                   MOV     R1,R1
  1F28   110C                   JLT     OF_OPEN_FAIL
                        
  1F2A   C020 2A98              MOV     @TARGET_RECS,R0
  1F2E   8800 2E30              C       R0,@TESTFCB+FSZ
  1F32   160D                   JNE     OF_SIZE_FAIL
  1F34   C020 2E3C              MOV     @TESTFCB+CRN,R0
  1F38   160A                   JNE     OF_SIZE_FAIL
                        
  1F3A   2DA0 2030              CALL    @SET_TEST_DMA
  1F3E   04C1                   CLR     R1
  1F40   2DC0                   RET
                        
                        OF_OPEN_FAIL:
  1F42   0200 0006              LI      R0,E_OPEN
  1F46   C800 2A9E              MOV     R0,@FAIL_ID
  1F4A   0701                   SETO    R1
  1F4C   2DC0                   RET
                        OF_SIZE_FAIL:
  1F4E   0200 0007              LI      R0,E_SIZE
  1F52   C800 2A9E              MOV     R0,@FAIL_ID
  1F56   C820 2A98              MOV     @TARGET_RECS,@EXPECTED
  1F5A   2AA4           
  1F5C   C820 2E30              MOV     @TESTFCB+FSZ,@ACTUAL
  1F60   2AA6           
  1F62   0701                   SETO    R1
  1F64   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; READ_FILE - sequentially read/verify all records and then verify EOF.
                        ;-----------------------------------------------------------------------
                        READ_FILE:
  1F66   04E0 2A9C              CLR     @CUR_REC
                        
                        RF_LOOP:
  1F6A   C020 2A9C              MOV     @CUR_REC,R0
  1F6E   8800 2A98              C       R0,@TARGET_RECS
  1F72   1313                   JEQ     RF_EOF_TEST
                        
  1F74   0202 0014              LI      R2,RDSEQ
  1F78   0203 2E22              LI      R3,TESTFCB
  1F7C   2DA0 0084              CALL    @BDOS
  1F80   C801 2AA0              MOV     R1,@LAST_STATUS
  1F84   C041                   MOV     R1,R1
  1F86   111F                   JLT     RF_READ_FAIL
                        
  1F88   2DA0 206A              CALL    @VERIFY_BUFFER
  1F8C   C041                   MOV     R1,R1
  1F8E   1121                   JLT     RF_DATA_FAIL
                        
  1F90   05A0 2A9C              INC     @CUR_REC
  1F94   2DA0 20C4              CALL    @PROGRESS
  1F98   10E8                   JMP     RF_LOOP
                        
                        RF_EOF_TEST:
  1F9A   0202 0014              LI      R2,RDSEQ
  1F9E   0203 2E22              LI      R3,TESTFCB
  1FA2   2DA0 0084              CALL    @BDOS
  1FA6   C801 2AA0              MOV     R1,@LAST_STATUS
  1FAA   C041                   MOV     R1,R1
  1FAC   1106                   JLT     RF_OK
                        
  1FAE   0200 000A              LI      R0,E_EOF
  1FB2   C800 2A9E              MOV     R0,@FAIL_ID
  1FB6   0701                   SETO    R1
  1FB8   2DC0                   RET
                        
                        RF_OK:
  1FBA   0200 298E              LI      R0,READ_OK_MSG
  1FBE   2DA0 2160              CALL    @PRINTMSG
  1FC2   04C1                   CLR     R1
  1FC4   2DC0                   RET
                        
                        RF_READ_FAIL:
  1FC6   0200 0008              LI      R0,E_READ
  1FCA   C800 2A9E              MOV     R0,@FAIL_ID
  1FCE   0701                   SETO    R1
  1FD0   2DC0                   RET
                        
                        RF_DATA_FAIL:
  1FD2   0200 0009              LI      R0,E_DATA
  1FD6   C800 2A9E              MOV     R0,@FAIL_ID
  1FDA   0701                   SETO    R1
  1FDC   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; DELETE_FILE - delete the verified file and reclaim its chain.
                        ;-----------------------------------------------------------------------
                        DELETE_FILE:
  1FDE   2DA0 200E              CALL    @INIT_FCB
  1FE2   0202 0013              LI      R2,ERAFIL
  1FE6   0203 2E22              LI      R3,TESTFCB
  1FEA   2DA0 0084              CALL    @BDOS
  1FEE   C801 2AA0              MOV     R1,@LAST_STATUS
  1FF2   C041                   MOV     R1,R1
  1FF4   1106                   JLT     DF_FAIL
  1FF6   0200 29AC              LI      R0,DELETE_OK_MSG
  1FFA   2DA0 2160              CALL    @PRINTMSG
  1FFE   04C1                   CLR     R1
  2000   2DC0                   RET
                        DF_FAIL:
  2002   0200 000B              LI      R0,E_ERASE
  2006   C800 2A9E              MOV     R0,@FAIL_ID
  200A   0701                   SETO    R1
  200C   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; INIT_FCB - clear all 36 bytes and copy the fixed 8.3 filename.
                        ;-----------------------------------------------------------------------
                        INIT_FCB:
  200E   0200 0012              LI      R0,FCBSIZ/2
  2012   0201 2E22              LI      R1,TESTFCB
                        IF_ZERO:
  2016   04F1                   CLR     *R1+
  2018   0600                   DEC     R0
  201A   16FD                   JNE     IF_ZERO
                        
  201C   0200 000B              LI      R0,11
  2020   0201 2A8C              LI      R1,TEST_NAME
  2024   0202 2E22              LI      R2,TESTFCB
                        IF_NAME:
  2028   DCB1                   MOVB    *R1+,*R2+
  202A   0600                   DEC     R0
  202C   16FD                   JNE     IF_NAME
  202E   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; SET_TEST_DMA - point BDOS sequential I/O at the local 512-byte buffer.
                        ;-----------------------------------------------------------------------
                        SET_TEST_DMA:
  2030   0202 001A              LI      R2,SETDMA
  2034   0203 2E56              LI      R3,DMABUF
  2038   2DA0 0084              CALL    @BDOS
  203C   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; FILL_BUFFER - create deterministic contents for CUR_REC.
                        ;-----------------------------------------------------------------------
                        FILL_BUFFER:
  203E   0200 2E56              LI      R0,DMABUF
  2042   0201 B059              LI      R1,MAGIC
  2046   CC01                   MOV     R1,*R0+
  2048   CC20 2A9C              MOV     @CUR_REC,*R0+
  204C   C060 2A9C              MOV     @CUR_REC,R1
  2050   0541                   INV     R1
  2052   CC01                   MOV     R1,*R0+
                        
  2054   0202 00FD              LI      R2,PATWORDS
  2058   C060 2A9C              MOV     @CUR_REC,R1
  205C   0221 0003              AI      R1,3
                        FB_LOOP:
  2060   CC01                   MOV     R1,*R0+
  2062   0581                   INC     R1
  2064   0602                   DEC     R2
  2066   16FC                   JNE     FB_LOOP
  2068   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; VERIFY_BUFFER - verify all 256 words against CUR_REC.
                        ; On failure saves byte offset, expected and actual values.
                        ;-----------------------------------------------------------------------
                        VERIFY_BUFFER:
  206A   0200 2E56              LI      R0,DMABUF
  206E   04C3                   CLR     R3               ; byte offset
                        
  2070   0202 B059              LI      R2,MAGIC
  2074   C130                   MOV     *R0+,R4
  2076   8084                   C       R4,R2
  2078   161D                   JNE     VB_FAIL
  207A   05C3                   INCT    R3
                        
  207C   C0A0 2A9C              MOV     @CUR_REC,R2
  2080   C130                   MOV     *R0+,R4
  2082   8084                   C       R4,R2
  2084   1617                   JNE     VB_FAIL
  2086   05C3                   INCT    R3
                        
  2088   C0A0 2A9C              MOV     @CUR_REC,R2
  208C   0542                   INV     R2
  208E   C130                   MOV     *R0+,R4
  2090   8084                   C       R4,R2
  2092   1610                   JNE     VB_FAIL
  2094   05C3                   INCT    R3
                        
  2096   0201 00FD              LI      R1,PATWORDS
  209A   C0A0 2A9C              MOV     @CUR_REC,R2
  209E   0222 0003              AI      R2,3
                        VB_LOOP:
  20A2   C130                   MOV     *R0+,R4
  20A4   8084                   C       R4,R2
  20A6   1606                   JNE     VB_FAIL
  20A8   05C3                   INCT    R3
  20AA   0582                   INC     R2
  20AC   0601                   DEC     R1
  20AE   16F9                   JNE     VB_LOOP
                        
  20B0   04C1                   CLR     R1
  20B2   2DC0                   RET
                        
                        VB_FAIL:
  20B4   C803 2AA2              MOV     R3,@BAD_OFFSET
  20B8   C802 2AA4              MOV     R2,@EXPECTED
  20BC   C804 2AA6              MOV     R4,@ACTUAL
  20C0   0701                   SETO    R1
  20C2   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; PROGRESS - print one dot after each 64 records.
                        ;-----------------------------------------------------------------------
                        PROGRESS:
  20C4   C020 2A9C              MOV     @CUR_REC,R0
  20C8   0240 003F              ANDI    R0,003FH
  20CC   1604                   JNE     PR_RET
  20CE   0203 002E              LI      R3,'.'
  20D2   2DA0 2172              CALL    @PUTC
                        PR_RET:
  20D6   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; PRINT_FAILURE - compact diagnostic, all values in hexadecimal.
                        ;-----------------------------------------------------------------------
                        PRINT_FAILURE:
  20D8   C820 2E30              MOV     @TESTFCB+FSZ,@FAIL_FSZ
  20DC   2AAA           
  20DE   C820 2E3C              MOV     @TESTFCB+CRN,@FAIL_CRN
  20E2   2AAC           
  20E4   C820 2E2E              MOV     @TESTFCB+FSB,@FAIL_FSB
  20E8   2AA8           
                        
  20EA   0200 29D6              LI      R0,FAIL_MSG
  20EE   2DA0 2160              CALL    @PRINTMSG
  20F2   2EA0 2A9E              WHEX    @FAIL_ID
  20F6   0200 29F4              LI      R0,REC_MSG
  20FA   2DA0 2160              CALL    @PRINTMSG
  20FE   2EA0 2A9C              WHEX    @CUR_REC
  2102   0200 29FC              LI      R0,STATUS_MSG
  2106   2DA0 2160              CALL    @PRINTMSG
  210A   2EA0 2AA0              WHEX    @LAST_STATUS
  210E   0200 2A06              LI      R0,FSB_MSG
  2112   2DA0 2160              CALL    @PRINTMSG
  2116   2EA0 2AA8              WHEX    @FAIL_FSB
  211A   0200 2A0E              LI      R0,FSZ_MSG
  211E   2DA0 2160              CALL    @PRINTMSG
  2122   2EA0 2AAA              WHEX    @FAIL_FSZ
  2126   0200 2A16              LI      R0,CRN_MSG
  212A   2DA0 2160              CALL    @PRINTMSG
  212E   2EA0 2AAC              WHEX    @FAIL_CRN
  2132   0200 2A1E              LI      R0,OFF_MSG
  2136   2DA0 2160              CALL    @PRINTMSG
  213A   2EA0 2AA2              WHEX    @BAD_OFFSET
  213E   0200 2A2A              LI      R0,EXP_MSG
  2142   2DA0 2160              CALL    @PRINTMSG
  2146   2EA0 2AA4              WHEX    @EXPECTED
  214A   0200 2A34              LI      R0,ACT_MSG
  214E   2DA0 2160              CALL    @PRINTMSG
  2152   2EA0 2AA6              WHEX    @ACTUAL
  2156   0200 2A3E              LI      R0,CRLF_MSG
  215A   2DA0 2160              CALL    @PRINTMSG
  215E   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; Console helpers.
                        ; PRINTMSG: R0 -> null-terminated bytes.
                        ; PUTC: R3 low byte = output character.
                        ;-----------------------------------------------------------------------
                        PRINTMSG:
  2160   D0F0                   MOVB    *R0+,R3
  2162   1306                   JEQ     PM_DONE
  2164   06C3                   SWPB    R3
  2166   2E00                   PUSH    R0
  2168   2DA0 2172              CALL    @PUTC
  216C   2E40                   POP     R0
  216E   10F8                   JMP     PRINTMSG
                        PM_DONE:
  2170   2DC0                   RET
                        
                        PUTC:
  2172   0202 0002              LI      R2,COUT
  2176   2DA0 0084              CALL    @BDOS
  217A   2DC0                   RET
