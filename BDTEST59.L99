  1730   2EA0 2AC6              WHEX    @P1_HSTAT
  1734   0200 25E4              LI      R0,ST_HALF3_MSG
  1738   2DA0 2160              CALL    @PRINTMSG
  173C   2EA0 2ACA              WHEX    @P3_HSTAT
  1740   0200 2A3E              LI      R0,CRLF_MSG
  1744   2DA0 2160              CALL    @PRINTMSG
  1748   0200 25F0              LI      R0,HALF_KEY_MSG
  174C   2DA0 2160              CALL    @PRINTMSG
