  13FE   C020 2AB2              MOV     @RAND_TARGET,R0
  1402   0A10                   SLA     R0,1
  1404   C800 2AA2              MOV     R0,@BAD_OFFSET
  1408   0701                   SETO    R1
  140A   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; Guard words immediately surrounding ST_DMA catch DMA overruns/underruns.
                        ;-----------------------------------------------------------------------
                        INIT_ST_GUARD:
  140C   0200 B0E0              LI      R0,ST_GLO
  1410   0201 0008              LI      R1,GUARD_WORDS
  1414   0202 1357              LI      R2,GUARD_LO_PAT
                        ISG_LO:
