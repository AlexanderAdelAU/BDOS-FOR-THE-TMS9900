  148C   C802 2AA4              MOV     R2,@EXPECTED
  1490   C804 2AA6              MOV     R4,@ACTUAL
  1494   0701                   SETO    R1
  1496   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; TRIAGE_BAD_READ - a PSEL-enabled read has already failed STRESS_VERIFY.
                        ; Save that mismatch, disable PSEL, and reread the same record once through
                        ; ordinary BDOS.  This does not write the disk.
                        ;-----------------------------------------------------------------------
                        TRIAGE_BAD_READ:
  1498   C820 2AA2              MOV     @BAD_OFFSET,@PSEL_BAD_OFFSET
  149C   2AEE           
  149E   C820 2AA4              MOV     @EXPECTED,@PSEL_EXPECTED
  14A2   2AF0           
  14A4   C820 2AA6              MOV     @ACTUAL,@PSEL_ACTUAL
  14A8   2AF2           
                        
                        ; Preserve the corrupt PAGE2 image before touching PSEL or the mapper.
                        ; BAD_COPY lives with the test image in the normal PAGE0 address space.
  14AA   0200 B100              LI      R0,ST_DMA
  14AE   0201 2C22              LI      R1,BAD_COPY
  14B2   0202 0100              LI      R2,NWORDS
                        TBR_BCPY:
  14B6   CC70                   MOV     *R0+,*R1+
  14B8   0602                   DEC     R2
  14BA   16FD                   JNE     TBR_BCPY
                        
                        ; Control A: toggle PSEL only.  No mapper write and no disk I/O.
                        ; If the same PAGE2 record now verifies, the RAM contents were good and
                        ; the failure was a transient PSEL/GAL visibility state after disk I/O.
  14BC   2C00                   PSEL_DIS
  14BE   2C40                   PSEL_EN
  14C0   2DA0 1010              CALL    @STRESS_VERIFY
  14C4   C041                   MOV     R1,R1
  14C6   1607                   JNE     TBR_REMAP
  14C8   0200 000A              LI      R0,10
  14CC   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  14D0   2C00                   PSEL_DIS
  14D2   0460 15D4              B       @TBR_RESTORE
                        
                        ; Control B: explicitly rewrite SEG11=PAGE2, still with no disk I/O.
                        ; If this alone fixes the record, the mapper register/output state was stale
                        ; even though its later readback may have looked correct.
                        TBR_REMAP:
  14D6   0200 0002              LI      R0,ST_DMA_PAGE
  14DA   2DA0 1112              CALL    @SET_DMAPG
  14DE   2DA0 1010              CALL    @STRESS_VERIFY
  14E2   C041                   MOV     R1,R1
  14E4   1607                   JNE     TBR_SNAP
  14E6   0200 000B              LI      R0,11
  14EA   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  14EE   2C00                   PSEL_DIS
  14F0   0460 15D4              B       @TBR_RESTORE
                        
                        ; The record is still bad after a PSEL toggle and explicit remap.  Snapshot
                        ; all physical pages, then perform the original PSEL-off disk reread control.
                        TBR_SNAP:
  14F4   2DA0 1330              CALL    @SNAP_HALVES
                        
                        ; Whole record landed in PAGE0.
  14F8   C020 2AC8              MOV     @P0_HSTAT,R0
  14FC   0280 0101              CI      R0,0101H
  1500   1606                   JNE     TBR_CHK_H1
  1502   0200 0005              LI      R0,5
  1506   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  150A   0460 15D4              B       @TBR_RESTORE
                        
                        ; First 256 bytes are correct in PAGE2, while second 256 bytes are correct
                        ; in PAGE0: the transfer switched physical bank at the half-record boundary.
                        TBR_CHK_H1:
  150E   C020 2AC4              MOV     @P2_HSTAT,R0
  1512   0240 FF00              ANDI    R0,0FF00H
  1516   0280 0100              CI      R0,0100H
  151A   160D                   JNE     TBR_CHK_H0
  151C   C020 2AC8              MOV     @P0_HSTAT,R0
  1520   0240 00FF              ANDI    R0,00FFH
  1524   0280 0001              CI      R0,0001H
  1528   1606                   JNE     TBR_CHK_H0
  152A   0200 0006              LI      R0,6
  152E   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  1532   0460 15D4              B       @TBR_RESTORE
                        
                        ; Mirror case: first transfer landed in PAGE0, second is correct in PAGE2.
                        TBR_CHK_H0:
  1536   C020 2AC8              MOV     @P0_HSTAT,R0
  153A   0240 FF00              ANDI    R0,0FF00H
  153E   0280 0100              CI      R0,0100H
  1542   160D                   JNE     TBR_P1
  1544   C020 2AC4              MOV     @P2_HSTAT,R0
  1548   0240 00FF              ANDI    R0,00FFH
  154C   0280 0001              CI      R0,0001H
  1550   1606                   JNE     TBR_P1
  1552   0200 0007              LI      R0,7
  1556   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  155A   0460 15D4              B       @TBR_RESTORE
                        TBR_P1:
  155E   C020 2AC6              MOV     @P1_HSTAT,R0
  1562   0280 0101              CI      R0,0101H
  1566   1606                   JNE     TBR_P3
  1568   0200 0008              LI      R0,8
  156C   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  1570   0460 15D4              B       @TBR_RESTORE
                        TBR_P3:
  1574   C020 2ACA              MOV     @P3_HSTAT,R0
  1578   0280 0101              CI      R0,0101H
  157C   1606                   JNE     TBR_CTRL
  157E   0200 0009              LI      R0,9
  1582   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  1586   0460 15D4              B       @TBR_RESTORE
                        
                        ; No alternate page contains a complete record.  Perform the
                        ; original PSEL-off reread to distinguish transient PSEL-path corruption
                        ; from bad disk/file data.
                        TBR_CTRL:
  158A   2DA0 1078              CALL    @POISON_BUFFER
  158E   04E0 2E3E              CLR     @TESTFCB+RELB
  1592   C820 2AB2              MOV     @RAND_TARGET,@TESTFCB+RELR
  1596   2E40           
  1598   0202 0021              LI      R2,RDRND
  159C   0203 2E22              LI      R3,TESTFCB
  15A0   2DA0 0084              CALL    @BDOS
  15A4   C801 2AE2              MOV     R1,@ST_CTRL_STAT
  15A8   C041                   MOV     R1,R1
  15AA   1110                   JLT     TBR_CTRL_ERR
  15AC   2DA0 1010              CALL    @STRESS_VERIFY
  15B0   C041                   MOV     R1,R1
  15B2   1606                   JNE     TBR_CTRL_BAD
  15B4   0200 0001              LI      R0,1
  15B8   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  15BC   0460 15D4              B       @TBR_RESTORE
                        TBR_CTRL_BAD:
  15C0   0200 0002              LI      R0,2
  15C4   C800 2AC2              MOV     R0,@STRESS_TRIAGE
  15C8   0460 15D4              B       @TBR_RESTORE
                        TBR_CTRL_ERR:
  15CC   0200 0003              LI      R0,3
  15D0   C800 2AC2              MOV     R0,@STRESS_TRIAGE
                        TBR_RESTORE:
  15D4   C820 2AEE              MOV     @PSEL_BAD_OFFSET,@BAD_OFFSET
  15D8   2AA2           
  15DA   C820 2AF0              MOV     @PSEL_EXPECTED,@EXPECTED
  15DE   2AA4           
  15E0   C820 2AF2              MOV     @PSEL_ACTUAL,@ACTUAL
  15E4   2AA6           
  15E6   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; 16-bit Galois LFSR.  Returns new value in R0.
                        ;-----------------------------------------------------------------------
                        NEXT_STRESS_RNG:
  15E8   C020 2ABC              MOV     @STRESS_RNG,R0
  15EC   0910                   SRL     R0,1
  15EE   1703                   JNC     NSR_STORE
  15F0   0201 B400              LI      R1,0B400H
  15F4   2801                   XOR     R1,R0
                        NSR_STORE:
  15F6   C800 2ABC              MOV     R0,@STRESS_RNG
  15FA   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; Mapper save / test-map / check / restore.
                        ; MAP_GET encoding follows MAPDEBUG/SHELL hardware convention:
                        ; STCR count 2 returns the mapper byte in the high byte; SRL 8 yields PAGE.
                        ; Restore uses PAGE << 8 followed by LDCR count 2, exactly like MAP_SET.
                        ; X mode expects PAGE0 everywhere except SEG11=ST_DMA_PAGE.
                        ;-----------------------------------------------------------------------
                        SAVE_MAPS:
  15FC   2C00                   PSEL_DIS
  15FE   0208 2B02              LI      R8,ORIG_MAPS
  1602   04C9                   CLR     R9
                        SVM_LOOP:
  1604   020C 80C0              LI      R12,MAP_BASE_PORT
  1608   C009                   MOV     R9,R0
  160A   0A10                   SLA     R0,1
  160C   A300                   A       R0,R12
  160E   04C0                   CLR     R0
  1610   3480                   STCR    R0,MAPWIDTH
  1612   0980                   SRL     R0,8
  1614   CE00                   MOV     R0,*R8+
  1616   0589                   INC     R9
  1618   0289 0010              CI      R9,16
  161C   1AF3                   JL      SVM_LOOP
  161E   04C1                   CLR     R1
  1620   2DC0                   RET
                        
                        SET_TEST_MAPS:
  1622   2C00                   PSEL_DIS
                        ; shell flat map first
  1624   020C 80C0              LI      R12,MAP_BASE_PORT
  1628   04C0                   CLR     R0
  162A   0209 0010              LI      R9,16
                        STM_ZERO:
  162E   3080                   LDCR    R0,MAPWIDTH
  1630   05CC                   INCT    R12
  1632   0609                   DEC     R9
  1634   16FC                   JNE     STM_ZERO
                        ; only SEG11 is nonzero: genuine paged DMA window at >B000->>BFFF
  1636   020C 80D6              LI      R12,ST_DMA_CRU
  163A   0200 0002              LI      R0,ST_DMA_PAGE
  163E   0A80                   SLA     R0,8
  1640   3080                   LDCR    R0,MAPWIDTH
  1642   04C1                   CLR     R1
  1644   2DC0                   RET
                        
                        CHK_TEST_MAPS:
  1646   04E0 2AFC              CLR     @MAP_BAD_SEG
  164A   04E0 2AFE              CLR     @MAP_EXPECT
  164E   04E0 2B00              CLR     @MAP_ACTUAL
  1652   020C 80C0              LI      R12,MAP_BASE_PORT
  1656   04C9                   CLR     R9
                        CTM_LOOP:
  1658   04C0                   CLR     R0
  165A   3480                   STCR    R0,MAPWIDTH
  165C   0980                   SRL     R0,8
  165E   04C1                   CLR     R1
  1660   0289 000B              CI      R9,ST_DMA_SEG
  1664   1602                   JNE     CTM_COMPARE
  1666   0201 0002              LI      R1,ST_DMA_PAGE
                        CTM_COMPARE:
  166A   8040                   C       R0,R1
  166C   1607                   JNE     CTM_FAIL
  166E   05CC                   INCT    R12
  1670   0589                   INC     R9
  1672   0289 0010              CI      R9,16
  1676   1AF0                   JL      CTM_LOOP
  1678   04C1                   CLR     R1
  167A   2DC0                   RET
                        CTM_FAIL:
  167C   C809 2AFC              MOV     R9,@MAP_BAD_SEG
  1680   C801 2AFE              MOV     R1,@MAP_EXPECT
  1684   C800 2B00              MOV     R0,@MAP_ACTUAL
  1688   0701                   SETO    R1
  168A   2DC0                   RET
                        
                        RESTORE_MAPS:
  168C   2C00                   PSEL_DIS
  168E   0208 2B02              LI      R8,ORIG_MAPS
  1692   04C9                   CLR     R9
                        RSM_LOOP:
  1694   020C 80C0              LI      R12,MAP_BASE_PORT
  1698   C009                   MOV     R9,R0
  169A   0A10                   SLA     R0,1
  169C   A300                   A       R0,R12
  169E   C038                   MOV     *R8+,R0
  16A0   0A80                   SLA     R0,8
  16A2   3080                   LDCR    R0,MAPWIDTH
  16A4   0589                   INC     R9
  16A6   0289 0010              CI      R9,16
  16AA   1AF4                   JL      RSM_LOOP
  16AC   04C1                   CLR     R1
  16AE   2DC0                   RET
                        ;
                        ;-----------------------------------------------------------------------
                        ; PR_ST_DIAG - extra forensic information for X-mode failures.
                        ;-----------------------------------------------------------------------
                        PR_ST_DIAG:
  16B0   0200 256C              LI      R0,ST_DIAG_MSG
  16B4   2DA0 2160              CALL    @PRINTMSG
  16B8   2EA0 2AB8              WHEX    @STRESS_ITER
  16BC   0200 257E              LI      R0,STRESS_OP_MSG
