;***********************************************************************
;
;	DISK INITIALISER - VERSION 6.0 (16.77 MB ISOLATED GEOMETRY)
;
;	This program wipes and initializes the boot sector, the BAT,
;	and the Directory for the TMS9900/99000 IDE interface.
;	It expects 4 KB blocks, 16 BAT pages, and 512 directory entries.
;	System structures (BOOT, BAT, DIR, and ALIAS TABLE) are isolated
;	into their own blocks.
;
;***********************************************************************

R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
R9	EQU	9
SP	EQU	10
R11	EQU	11
PORT	EQU	12
R12	EQU	12
R13	EQU	13
R14	EQU	14
R15	EQU	15

; --- XOP Definitions ---
	DXOP 	CALL,6
	DXOP 	RET,7
	DXOP 	PUSH,8
	DXOP 	POP,9
	DXOP 	WHEX,10
	DXOP 	READ,13
	DXOP 	WRITE,12    	; WRITE CHAR IN MSB
	DXOP 	MESG,14		; OUTPUT NULL TERMINATED MESSAG
	DXOP	DEBUG,15

; --- OS Memory Map ---
MONITOR		EQU	0F000H
SHELL_ADDR	EQU	0C000H
DOS_ADDR	EQU	0E000H
XMODEM_ADDR	EQU	01000H
LADDRESS	EQU	00A00H		; Temporary loader execution address
WORKSP		EQU	0230H
STACKP  	EQU	0FFEH

; --- File Types ---
SYS	EQU	0
COM	EQU	1
EXE	EQU	2
TXT	EQU	3
BAS	EQU	4
PRO	EQU	5

	AORG	0500H
	JMP	START

;=====================================================================
; FILESYSTEM LAYOUT (16.77 MB Isolated Geometry)
;=====================================================================
BYTSEC		EQU	512		; Logical sector size
IDE_BYTSEC 	EQU	256		; IDE 8-bit transfer unit
SECBLK		EQU	8		; 512-byte sectors per 4KB allocation block
LBAPERSEC 	EQU	2		; 2 IDE LBAs make 1 BDOS Sector
LBAPERBLK 	EQU	SECBLK*LBAPERSEC ; 16 IDE LBAs per Block

FIRSTBLK 	EQU	8		; Data starts at Block 8 (Block 0..7 reserved)
LASTBLK		EQU	0FF80H		; End-of-chain marker used by BDOS

; --- Isolated LBA Boundaries ---
BOOT_LBA 	EQU	0		; Block 0, Sector 0
BAT_LBA		EQU	16		; Block 1, Sector 8
DIR_LBA		EQU	48		; Block 3, Sector 24
NDIRSEC		EQU	32		; 32 Sectors = 512 files
NBATPAGE 	EQU	16		; 16 BAT pages for 4096 blocks

NAMSIZ		EQU	11
DIRENTSZ 	EQU	32

; --- FCB / Directory Entry Offsets ---
FLA	EQU	16		; Load address in RAM
FLD_ID	EQU	18		; Folder ID (0=Root)
CRN	EQU	26		; Current record number (cursor)
FSB	EQU	12		; File Starting Block on disk
FSZ	EQU	14		; File size in 512-byte sectors

;=====================================================================
; INITIAL SYSTEM FILE LAYOUT
;=====================================================================
; SHELL  (8192 bytes = 16 sectors = 2 blocks)
; BDOS   (4096 bytes =  8 sectors = 1 block)
; XMODEM (4096 bytes =  8 sectors = 1 block)
;
; Note: Since FIRSTBLK is 8, we place the OS starting at Block 8.
;=====================================================================
SHELL_FSB	EQU	8
SHELL_FSZ	EQU	16
BDOS_FSB	EQU	10
BDOS_FSZ	EQU	8
XMODEM_FSB	EQU	11
XMODEM_FSZ	EQU	8
FIRST_FREE_BLK	EQU	12

; --- Directory Entries ---
SHELLSYS	TEXT	'SHELL   SYS'
	BYTE	SYS
	WORD	SHELL_FSB,SHELL_FSZ,SHELL_ADDR,0,0,0,0,0,0,0

BDOSSYS		TEXT	'BDOS    SYS'
	BYTE	SYS
	WORD	BDOS_FSB,BDOS_FSZ,DOS_ADDR,0,0,0,0,0,0,0

XMODEMCOM	TEXT	'XMODEM  COM'
	BYTE	COM
	WORD	XMODEM_FSB,XMODEM_FSZ,XMODEM_ADDR,0,0,0,0,0,0,0

;=====================================================================
; INITIAL BAT CONTENTS (PAGE 0 ONLY)
;=====================================================================
; BAT entries contain the NEXT physical block, not the current block.
; 0000H means free. LASTBLK (FF80H) means End Of File/Chain.
;
; Block 0 to 7   -> System Reserved (LASTBLK) - Includes Alias Table block
; Block 8 to 9   -> SHELL.SYS
; Block 10       -> BDOS.SYS
; Block 11       -> XMODEM.COM
;=====================================================================
BATINT
	; System reserved blocks (0-7)
	WORD	LASTBLK,LASTBLK,LASTBLK,LASTBLK,LASTBLK,LASTBLK,LASTBLK,LASTBLK

	; Shell (Blocks 8-9)
	WORD	SHELL_FSB+1,LASTBLK

	; BDOS (Block 10)
	WORD	LASTBLK

	; XMODEM (Block 11)
	WORD	LASTBLK
BATINT_WORDS EQU	12		; Number of pre-allocated blocks

RETRY	WORD	10			; Global retry counter

;
; MAIN ENTRY POINT
;
	EVEN
START	LWPI	WORKSP			; Establish local workspace
	LI	SP,STACKP

	CALL	@IDE_READY
	CALL	@INITBOOT		; 1. Write the bootloader to LBA 0
	CALL	@INITBAT		; 2. Wipe/Format 16 BAT pages
	CALL	@INITDIR		; 3. Wipe 32 Directory sectors (E5 fill)
	CALL	@INITSYS		; 4. Publish OS files to Directory and Disk
	MESG	@SUCCESS
	BLWP	@MONITOR		; Return control to Monitor

SUCCESS:BYTE	0DH,0AH
	TEXT	"SUCCESS..."
	BYTE	0DH,0AH,0
	EVEN

;
; INITBOOT - Writes the 512-byte LOADER to LBA 0
;
INITBOOT
	LI	R3,LOADER		; Point to loader code in RAM
	LI	R5,BOOT_LBA		; Target IDE LBA 0
	CALL	@WRITE_SECTOR
	RET		

;=====================================================================
; BUFFER HELPERS
;=====================================================================
; CLEARBUF - Fills the IOBUF with zeros (Used for free BAT blocks)
;=====================================================================
CLEARBUF
	LI	R1,IOBUF
	LI	R0,BYTSEC/2
CBUF1	CLR	*R1+
	DEC	R0
	JNE	CBUF1
	RET

;=====================================================================
; FILLDIRBUF - Fills IOBUF with E5E5H (CP/M standard empty dir marker)
;=====================================================================
FILLDIRBUF
	LI	R1,IOBUF
	LI	R0,BYTSEC/2
	LI	R2,0E5E5H
FDBUF1	MOV	R2,*R1+
	DEC	R0
	JNE	FDBUF1
	RET

;=====================================================================
; INITBAT - Formats all 16 BAT Pages
;=====================================================================
INITBAT
	; --- Format Page 0 (System Reservations) ---
	CALL	@CLEARBUF		; Zero the buffer first
	LI	R0,BATINT		; Point to our hardcoded allocations
	LI	R1,IOBUF
	LI	R2,BATINT_WORDS
IBAT1	MOV	*R0+,*R1+		; Copy allocations into Page 0 buffer
	DEC	R2
	JNE	IBAT1

	LI	R5,BAT_LBA		; Start LBA for the BAT
	LI	R3,IOBUF
	CALL	@WRITE_SECTOR		; Commit Page 0 to disk

	; --- Format Pages 1 through 15 (All Free) ---
	CALL	@CLEARBUF		; Zero the buffer (0000H = free blocks)
	LI	R2,NBATPAGE-1		; Loop 15 times
IBAT2	INCT	R5			; Advance by 2 LBAs (1 Sector)
	LI	R3,IOBUF
	CALL	@WRITE_SECTOR		; Commit free page
	DEC	R2
	JNE	IBAT2
	RET

;=====================================================================
; INITDIR - Wipes all 32 Directory sectors
;=====================================================================
INITDIR
	CALL	@FILLDIRBUF		; Setup the E5E5H tombstone buffer
	LI	R5,DIR_LBA		; Start LBA of Directory
	LI	R2,NDIRSEC		; Total directory sectors (32)
IDIR1	LI	R3,IOBUF
	CALL	@WRITE_SECTOR
	INCT	R5			; Advance 1 Logical Sector (2 LBAs)
	DEC	R2
	JNE	IDIR1
	RET

;=====================================================================
; INITSYS - Writes system file Directory Entries and copies data
;=====================================================================
INITSYS
	CALL	@FILLDIRBUF		; Clean the buffer for the first Dir sector
	LI	R8,IOBUF		; R8 = Directory Buffer pointer

	; Copy SHELL.SYS Entry
	LI	R3,SHELLSYS
	LI	R0,DIRENTSZ
	MOV	R8,R1
INTSYS1	MOVB	*R3+,*R1+
	DEC	R0
	JNE	INTSYS1

	; Copy BDOS.SYS Entry
	AI	R8,DIRENTSZ		; Move buffer pointer forward 32 bytes
	LI	R3,BDOSSYS
	LI	R0,DIRENTSZ
	MOV	R8,R1
INTSYS2	MOVB	*R3+,*R1+
	DEC	R0
	JNE	INTSYS2

	; Copy XMODEM.COM Entry
	AI	R8,DIRENTSZ
	LI	R3,XMODEMCOM
	LI	R0,DIRENTSZ
	MOV	R8,R1
INTSYS3	MOVB	*R3+,*R1+
	DEC	R0
	JNE	INTSYS3

	; Write the populated first Directory Sector to disk
	LI	R5,DIR_LBA
	LI	R3,IOBUF
	CALL	@WRITE_SECTOR

	; Now, physically write the file contents to their allocated blocks
	LI	R8,IOBUF
	CALL	@WRTSYS			; Write SHELL.SYS
	AI	R8,DIRENTSZ
	CALL	@WRTSYS			; Write BDOS.SYS
	AI	R8,DIRENTSZ
	CALL	@WRTSYS			; Write XMODEM.COM
	RET

;=====================================================================
; WRTSYS - Helper to write a system file based on its FCB details
;=====================================================================
WRTSYS:
	CLR	@CRN(R8)		; Start at record 0
WRTSYS1	MOV	@CRN(R8),R3		; R3 = Current Record Number
	MOV	@FSB(R8),R5		; R5 = File Starting Block

	; Convert Block + Offset to LBA
	SLA	R5,3			; R5 = Start Sector (Block * 8)
	A	R3,R5			; R5 = Target Logical Sector
	SLA	R5,1			; R5 = Target IDE LBA (* 2)

	MOV	@FLA(R8),R3		; R3 = RAM Load Address (Source data)
	CALL	@WRITE_SECTOR		; Dump RAM to disk sector

	LI	R0,BYTSEC
	A	R0,@FLA(R8)		; Advance RAM pointer by 512 bytes
	INC	@CRN(R8)		; Advance record count
	DEC	@FSZ(R8)		; Loop until File Size count is 0
	JNE	WRTSYS1
	RET

;--------------------------------------------------------------------
; LOADER MODULE (Boot Sector Code)
; Located at LBA 0, loaded into 1000H by the BIOS.
; Searches the directory for SHELL and BDOS, loads them, and jumps to Shell.
;--------------------------------------------------------------------
	AORG	LADDRESS
LOADER:
	LWPI	WORKSP
	LI	SP,STACKP
	CALL	@IDE_READY

	; 1. Pull in the first Directory Sector
	LI	R5,DIR_LBA
	LI	R3,IOBUF
	CALL	@READ_SECTOR
	JLT	LOADERR	

	; 2. Match and Load SHELL.SYS
	LI	R8,IOBUF
	LI	R4,SHELL
	CALL	@MATCH
	JNE	LOADERR
	CALL	@LOADSYS

	; 3. Match and Load BDOS.SYS
	AI	R8,32			; Move to 2nd directory entry
	LI	R4,BDOS
	CALL	@MATCH
	JNE	LOADERR
	CALL	@LOADSYS

	; 4. Execute OS
	B	@SHELL_ADDR

;--- LOADSYS Helper (Runs in Loader Context) ---
LOADSYS:
	CLR	@CRN(R8)
LOAD1	MOV	@CRN(R8),R3
	MOV	@FSB(R8),R5
	SLA	R5,3			; Block to Sector offset
	A	R3,R5			; Add record offset
	SLA	R5,1			; Sector to LBA
	
	MOV	@FLA(R8),R3		; RAM Destination
	CALL	@READ_SECTOR
	JNE	LOADERR

	INC	@CRN(R8)
	LI	R0,BYTSEC
	A	R0,@FLA(R8)		; Advance RAM destination
	DEC	@FSZ(R8)
	JNE	LOAD1
	RET

;--- MATCH Helper ---
MATCH
	MOV	R8,R3
	SETO	R1			; Default to Error
	LI	R0,NAMSIZ
MATCH1	CB	*R4+,*R3+
	JNE	MATCH2			; Mismatch
	DEC	R0	
	JNE	MATCH1
	CLR	R1			; Success
MATCH2	MOV	R1,R1
	RET

LOADERR MESG	@LDMSG
	BLWP	@MONITOR

;=====================================================================
; IDE INTERFACE HARDWARE ROUTINES
;=====================================================================
IDE_BASE_PORT	EQU	8040H
BYTEWIDE	EQU	2
IDE_COMMAND	EQU	IDE_BASE_PORT+7*2
IDE_STATUS	EQU	IDE_BASE_PORT+7*2
IDE_DATA	EQU	IDE_BASE_PORT
IDE_HEAD	EQU	IDE_BASE_PORT+6*2
IDE_CYL_LSB	EQU	IDE_BASE_PORT+4*2
IDE_CYL_MSB	EQU	IDE_BASE_PORT+5*2
IDE_SECTOR	EQU	IDE_BASE_PORT+3*2
IDE_SEC_CNT	EQU	IDE_BASE_PORT+2*2
IDE_ERROR	EQU	IDE_BASE_PORT+1*2

IDE_CMD_READ	EQU	02000H
IDE_CMD_WRITE	EQU	03000H

IDE_READY:
	LI	PORT, IDE_HEAD
	LI	R1, 11100000B*256	; Set LBA Mode
	LDCR	R1,BYTEWIDE

	LI	PORT,IDE_COMMAND
BSY1:	STCR	R1,BYTEWIDE
	ANDI	R1,10000000B*256	; Wait for BUSY flag to clear
	JNE	BSY1

	LI	PORT,IDE_COMMAND
RDY1:	STCR	R1,BYTEWIDE
	ANDI	R1,01000000B*256	; Wait for READY flag to set
	JEQ	RDY1
	RET

IDE_GET_ERROR:
	LI	PORT, IDE_ERROR
	CLR	R1
	STCR	R1,BYTEWIDE
	MOVB	R1,R1
	JEQ	IGE_X
	MESG	@IDE_MSG1
	WHEX	R1
IGE_X	RET

IDE_MSG1:	TEXT	"IDE ERROR: "
	WORD	0DH,0AH,0
	EVEN

READ_SECTOR:
	MOV	R3,@BUFPTR
	CALL	@IDE_NOT_BUSY
	CALL	@IDE_WR_LBA
	LI	PORT, IDE_COMMAND
	LI	R1, IDE_CMD_READ
	LDCR	R1,BYTEWIDE
	CALL	@IDE_WAIT_DRQ
	JEQ	IDE_GET_ERROR
	CALL	@IDE_READ_DATA
	RET

WRITE_SECTOR:
	MOV	R3,@BUFPTR
	CALL	@IDE_NOT_BUSY
	CALL	@IDE_WR_LBA
	LI	PORT, IDE_COMMAND
	LI	R1, IDE_CMD_WRITE
	LDCR	R1,BYTEWIDE
	CALL	@IDE_WAIT_DRQ
	CALL	@IDE_WRITE_DATA
	RET

GET_LBA:RET

IDE_NOT_BUSY:
	LI	PORT,IDE_COMMAND
BSY2	STCR	R1,BYTEWIDE
	ANDI	R1,10000000B*256
	JNE	BSY2
	RET

IDE_WAIT_DRQ:
	SETO	R0			; Crude Timeout
	LI	PORT, IDE_COMMAND
	CLR	R1
DRQ1	DEC	R0
	JEQ	DRQ_X
	STCR	R1,BYTEWIDE
	ANDI	R1,00001000B*256	; Wait for Data Request
	JEQ	DRQ1
DRQ_X	RET

;--- Pull 512 bytes (2 IDE Sectors) from drive buffer
IDE_READ_DATA:
	MOV	@BUFPTR,R4
	LI	R0,512
	LI	PORT,IDE_DATA
RL11:	STCR	R1,BYTEWIDE
	MOVB	R1,*R4+
	DEC	R0
	JNE	RL11
	RET

;--- Push 512 bytes to drive buffer
IDE_WRITE_DATA:
	MOV	@BUFPTR,R4
	LI	R0,512
	LI	PORT,IDE_DATA
WL11:	MOVB	*R4+,R1
	LDCR	R1,BYTEWIDE
	DEC	R0
	JNE	WL11
	RET

;--- Convert R5 into hardware LBA registers
IDE_WR_LBA:
	CLR	@LBA
	CLR	@LBA+2
	MOV	R5,@LBA+2

	MOVB	@LBA+0,R1
	ANDI	R1,0FH*256
	ORI	R1,0E0H*256		; Select IDE Head
	LI	PORT,IDE_HEAD
	LDCR	R1,BYTEWIDE

	MOVB	@LBA+1,R1
	LI	PORT,IDE_CYL_MSB
	LDCR	R1,BYTEWIDE

	MOVB	@LBA+2,R1
	LI	PORT,IDE_CYL_LSB
	LDCR	R1,BYTEWIDE

	MOVB	@LBA+3,R1
	LI	PORT,IDE_SECTOR
	LDCR	R1,BYTEWIDE

	; Tell the drive to prepare 2 LBAs (512 bytes)
	LI	R1,2*IDE_BYTSEC
	LI	PORT,IDE_SEC_CNT
	LDCR	R1,BYTEWIDE
	RET

SHELL	TEXT	'SHELL   SYS'
BDOS	TEXT	'BDOS    SYS'
LDMSG	BYTE	0DH,0AH,
	TEXT 	"Boot-no system files..."
	BYTE	0DH,0AH,00
	EVEN

; --- BOOT SECTOR PADDING (Forces loader to be exactly 512 bytes) ---
	AORG	LOADER + 510
	WORD	LOADER
SIZE:	EQU	$-LOADER
	BSS	512-SIZE

; --- SYSTEM RAM ---
NAMPTR	WORD	0
CDSEC	WORD	0
BUFPTR	WORD	0
IOBUF	BSS	BYTSEC*3
LBA:	BSS	4

	END
