  177C   2EA0 2AD6              WHEX    @ERR_XOROR
  1780   0200 265C              LI      R0,ERRCLR_MSG
  1784   2DA0 2160              CALL    @PRINTMSG
  1788   2EA0 2AD8              WHEX    @ERR_CLROR
  178C   0200 2666              LI      R0,ERRSET_MSG
  1790   2DA0 2160              CALL    @PRINTMSG
  1794   2EA0 2ADA              WHEX    @ERR_SETOR
  1798   0200 2670              LI      R0,ERRX3_MSG
  179C   2DA0 2160              CALL    @PRINTMSG
  17A0   2EA0 2ADC              WHEX    @ERR_X3CNT
  17A4   0200 2678              LI      R0,ERRFST_MSG
  17A8   2DA0 2160              CALL    @PRINTMSG
  17AC   2EA0 2ADE              WHEX    @ERR_FIRST
  17B0   0200 2682              LI      R0,ERRLST_MSG
  17B4   2DA0 2160              CALL    @PRINTMSG
  17B8   2EA0 2AE0              WHEX    @ERR_LAST
  17BC   0200 2A3E              LI      R0,CRLF_MSG
  17C0   2DA0 2160              CALL    @PRINTMSG
                        
                        ; For TRIAGE 1, PAGE0 now contains the clean control reread and BAD_COPY
                        ; contains the original corrupt PAGE2 image.  Print a 16-word window around
                        ; the first cutover so byte/word skew is visible immediately.
  17C4   C020 2AC2              MOV     @STRESS_TRIAGE,R0
  17C8   0280 0001              CI      R0,1
  17CC   1602                   JNE     PSD_NOEDGE
  17CE   2DA0 18A0              CALL    @PRINT_EDGE
                        PSD_NOEDGE:
  17D2   C020 2AC2              MOV     @STRESS_TRIAGE,R0
  17D6   1363                   JEQ     PSD_RET
  17D8   0280 0001              CI      R0,1
  17DC   1320                   JEQ     PSD_T1
  17DE   0280 0002              CI      R0,2
  17E2   1323                   JEQ     PSD_T2
  17E4   0280 0003              CI      R0,3
  17E8   1326                   JEQ     PSD_T3
  17EA   0280 0004              CI      R0,4
  17EE   1329                   JEQ     PSD_T4
  17F0   0280 0005              CI      R0,5
  17F4   132C                   JEQ     PSD_T5
  17F6   0280 0006              CI      R0,6
  17FA   132F                   JEQ     PSD_T6
  17FC   0280 0007              CI      R0,7
  1800   1332                   JEQ     PSD_T7
  1802   0280 0008              CI      R0,8
  1806   1335                   JEQ     PSD_T8
  1808   0280 0009              CI      R0,9
  180C   1338                   JEQ     PSD_T9
  180E   0280 000A              CI      R0,10
  1812   133B                   JEQ     PSD_T10
  1814   0280 000B              CI      R0,11
  1818   133E                   JEQ     PSD_T11
  181A   0460 189E              B       @PSD_RET
                        PSD_T1:
