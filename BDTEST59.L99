  170C   2EA0 2B00              WHEX    @MAP_ACTUAL
  1710   0200 25C0              LI      R0,ST_HALF2_MSG
  1714   2DA0 2160              CALL    @PRINTMSG
  1718   2EA0 2AC4              WHEX    @P2_HSTAT
  171C   0200 25CC              LI      R0,ST_HALF0_MSG
